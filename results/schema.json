{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adamraudonis/DoorBench/results/schema.json",
  "title": "DoorBench benchmark result",
  "description": "One evaluation run of a policy over DoorBench doors x scenarios x seeds, written by `doorbench benchmark run` (doorbench.benchmark.runner) and validated by scripts/validate_result.py.  Scenarios belong to one of two suites - `core` (open_and_traverse, open_then_close, close_only, unlock_and_traverse, locked_recognize: no simulated person; the default and the source of the headline 'N / 1000 doors' number) and `human` (hold_open_for_human, wait_for_human, knock_and_wait: advanced, opt-in) - and the two are never mixed: every episode carries its suite and `aggregate` holds one table per suite.",
  "type": "object",
  "required": ["schema_version", "benchmark", "policy", "run", "aggregate", "episodes"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.1"]},
    "benchmark": {
      "type": "object",
      "required": ["name", "n_doors_total"],
      "properties": {
        "name": {"type": "string", "enum": ["DoorBench"]},
        "dataset_version": {"type": ["string", "null"]},
        "dataset_generated": {"type": ["string", "null"]},
        "n_doors_total": {"type": "integer", "minimum": 1},
        "commit": {"type": ["string", "null"], "description": "DoorBench git commit the assets and runner came from"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "policy": {
      "type": "object",
      "required": ["name", "embodiment"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.-]+$"},
        "class": {"type": "string"},
        "description": {"type": "string"},
        "embodiment": {"type": "string", "enum": ["hand_base", "robot"]},
        "control_dt": {"type": "number", "exclusiveMinimum": 0},
        "spec": {"type": "string"},
        "extra": {"type": "object"}
      }
    },
    "run": {
      "type": "object",
      "required": ["date", "simulator", "tier", "suite", "scenarios", "seeds", "n_doors"],
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
        "label": {"type": "string"},
        "simulator": {"type": "string", "enum": ["mujoco", "isaac_sim", "isaac_lab", "other"]},
        "simulator_version": {"type": ["string", "null"]},
        "tier": {"type": "string", "enum": ["full", "simple", "minimal"]},
        "suite": {"type": "string", "enum": ["core", "human", "all"], "description": "the suite(s) this run evaluated; 'all' keeps the two in separate tables"},
        "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "suite"], "properties": {"name": {"$ref": "#/$defs/scenario_name"}, "suite": {"$ref": "#/$defs/suite"}, "description": {"type": "string"}}}},
        "scenario_filter": {"type": "string", "description": "'all' = every scenario each door lists in the suite (required for the leaderboard); 'primary' or a comma list narrows it"},
        "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "n_doors": {"type": "integer", "minimum": 1},
        "door_selection": {"type": "string"},
        "time_budget_s": {"type": ["number", "string"], "description": "a number when --budget overrode every scenario's own budget"},
        "randomize": {"type": "boolean"},
        "control_dt": {"type": ["number", "null"]},
        "workers": {"type": "integer"},
        "wall_time_s": {"type": "number", "minimum": 0},
        "host": {"type": "object"},
        "command": {"type": "string"}
      }
    },
    "aggregate": {
      "type": "object",
      "description": "one table per suite present in the run; a table never mixes suites",
      "minProperties": 1,
      "properties": {"core": {"$ref": "#/$defs/table"}, "human": {"$ref": "#/$defs/table"}},
      "additionalProperties": false
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["door_id", "family", "scenario", "suite", "seed", "success", "outcome", "sim_time", "steps", "wall_s", "events", "labels"],
        "properties": {
          "door_id": {"type": "string", "pattern": "^db[0-9]{4}_[a-z_]+$"},
          "family": {"type": "string"},
          "difficulty": {"type": ["integer", "null"]},
          "scenario": {"$ref": "#/$defs/scenario_name"},
          "suite": {"$ref": "#/$defs/suite"},
          "seed": {"type": "integer", "minimum": 0},
          "tier": {"type": "string"},
          "success": {"type": "boolean"},
          "outcome": {"type": "string", "enum": ["success", "fail", "damaged", "fell", "timeout", "error", "native_failure", "mechanism_failure"]},
          "sim_time": {"type": "number", "minimum": 0},
          "steps": {"type": "integer", "minimum": 0},
          "wall_s": {"type": "number", "minimum": 0},
          "time_budget_s": {"type": "number"},
          "control_dt": {"type": "number"},
          "randomized": {"type": "boolean"},
          "start": {"type": "object", "properties": {"xy": {"type": "array"}, "yaw": {"type": ["number", "null"]}}},
          "time_to_touch": {"type": ["number", "null"]},
          "time_to_open": {"type": ["number", "null"]},
          "time_to_pass": {"type": ["number", "null"], "description": "sim seconds until the robot base crossed the door plane"},
          "time_to_goal": {"type": ["number", "null"]},
          "time_to_close": {"type": ["number", "null"]},
          "expected_transit_s": {"type": ["number", "null"]},
          "damage": {"type": "boolean"},
          "env_damage": {"type": "boolean"},
          "damage_events": {"type": "array", "items": {"type": "object", "properties": {"t": {"type": ["number", "null"]}, "kind": {"type": ["string", "null"]}, "part": {"type": ["string", "null"]}, "value": {"type": ["number", "null"]}, "threshold": {"type": ["number", "null"]}}}},
          "max_leaf_force_N": {"type": ["number", "null"]},
          "max_operator_torque": {"type": ["number", "null"]},
          "max_door_angle": {"type": ["number", "null"]},
          "door_q_end": {"type": ["number", "null"]},
          "energy_J": {"type": ["number", "null"]},
          "labels": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "criteria": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "the scenario's success criteria and whether each held at the end"},
          "events": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "string"}, {"type": "number"}]}},
          "reward_events": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"type": "string"}, {"type": "number"}, {"type": "number"}]}},
          "episode_return": {"type": ["number", "null"]},
          "human_collision": {"type": ["boolean", "null"]},
          "mujoco_warnings": {"type": "integer"},
          "base_end": {"type": "array"},
          "error": {"type": ["string", "null"]},
          "traceback": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "suite": {"type": "string", "enum": ["core", "human"]},
    "scenario_name": {"type": "string", "enum": ["open_and_traverse", "open_then_close", "close_only", "unlock_and_traverse", "locked_recognize", "hold_open_for_human", "wait_for_human", "knock_and_wait"]},
    "group": {
      "type": "object",
      "required": ["n_doors", "n_episodes", "n_success", "success_rate", "doors_solved", "damage_rate"],
      "properties": {
        "n_doors": {"type": "integer"},
        "n_episodes": {"type": "integer"},
        "n_success": {"type": "integer"},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "doors_solved": {"type": "integer"},
        "doors_solved_any": {"type": "integer"},
        "damage_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_return": {"type": ["number", "null"]},
        "mean_time_to_pass_s": {"type": ["number", "null"]},
        "median_time_to_pass_s": {"type": ["number", "null"]},
        "mean_time_to_open_s": {"type": ["number", "null"]},
        "mean_max_leaf_force_N": {"type": ["number", "null"]},
        "mean_energy_J": {"type": ["number", "null"]},
        "human_collision_rate": {"type": ["number", "null"]},
        "outcomes": {"type": "object"}
      }
    },
    "groups": {"type": "object", "additionalProperties": {"$ref": "#/$defs/group"}},
    "table": {
      "type": "object",
      "required": ["suite", "scenarios", "n_doors", "n_episodes", "n_success", "success_rate", "doors_solved", "doors_solved_any", "damage_rate", "by_family", "by_difficulty", "by_scenario"],
      "properties": {
        "suite": {"$ref": "#/$defs/suite"},
        "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario_name"}},
        "n_doors": {"type": "integer", "minimum": 0},
        "n_episodes": {"type": "integer", "minimum": 0},
        "n_success": {"type": "integer", "minimum": 0},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "doors_solved": {"type": "integer", "minimum": 0, "description": "doors succeeded on every episode (every listed scenario of the suite x every seed)"},
        "doors_solved_any": {"type": "integer", "minimum": 0},
        "damage_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_return": {"type": ["number", "null"]},
        "mean_time_to_pass_s": {"type": ["number", "null"]},
        "median_time_to_pass_s": {"type": ["number", "null"]},
        "mean_time_to_open_s": {"type": ["number", "null"]},
        "mean_max_leaf_force_N": {"type": ["number", "null"]},
        "mean_energy_J": {"type": ["number", "null"]},
        "human_collision_rate": {"type": ["number", "null"]},
        "mean_wall_s": {"type": ["number", "null"]},
        "mean_sim_time_s": {"type": ["number", "null"]},
        "n_errors": {"type": "integer"},
        "timeouts": {"type": "integer"},
        "outcomes": {"type": "object"},
        "by_family": {"$ref": "#/$defs/groups"},
        "by_difficulty": {"$ref": "#/$defs/groups"},
        "by_scenario": {"$ref": "#/$defs/groups"},
        "by_lock_state": {"$ref": "#/$defs/groups"}
      }
    }
  }
}
