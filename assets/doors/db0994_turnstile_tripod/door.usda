#usda 1.0
(
    defaultPrim = "db0994_turnstile_tripod"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0994_turnstile_tripod"
{
    custom string doorbench:couplings = '[{"type": "weld", "body1": "rotor", "body2": "world", "label": "Turnstile solenoid lock (released on a valid credential)", "active": true, "joint": "/db0994_turnstile_tripod/Articulation/Joints/rotor_solenoid_hold", "holding_force_N": 5340.0, "note": "breakable FixedJoint (excludeFromArticulation); the environment clears physics:jointEnabled on release"}]'
    custom string doorbench:door_id = "db0994_turnstile_tripod"
    custom string doorbench:env_release = '[{"name": "rotor_solenoid_hold", "body": "rotor", "other": "world", "label": "Turnstile solenoid lock (released on a valid credential)", "active": true, "holding_force_N": 5340.0, "release": "env", "release_joint": null, "release_fraction": null, "lock_model": "mag_lock", "joint": "/db0994_turnstile_tripod/Articulation/Joints/rotor_solenoid_hold", "joint_name": "rotor_solenoid_hold", "body_prim": "/db0994_turnstile_tripod/Articulation/rotor", "base_prim": "/db0994_turnstile_tripod/Articulation/base"}]'
    custom string doorbench:filtered_pairs = "[]"
    custom string doorbench:meta = '{"door_id": "db0994_turnstile_tripod", "family": "turnstile_tripod", "task": "push_through", "wall_y": 0.0, "clearance_allow": [["hub_boss", "tripod_mesh", "rotor hub seats on the boss"]], "primary_joint": "rotor_hinge", "operator_joint": null, "handle_height": 0.95, "ratchet_deg": 120, "one_way": true, "locked": true, "running_clearance_min": 0.01, "breakable_welds": [{"name": "rotor_solenoid_hold", "body": "rotor", "joint": "rotor_hinge", "holding_force_N": 5340.0, "release": "env", "lock_model": "mag_lock", "holds_primary": true}], "mass_reconciled_kg": 10.738226043740887, "mass": {"leaf_material_kg": 5.038226043740886, "leaf_hardware_rider_kg": 5.7, "hardware_modelled_kg": 0.0, "leaf_bodies": 1, "total_moving_kg": 10.738226043740887}, "scene_extent": 1.5, "cam_target_z": 0.525, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 0.95], "handle_cam_pos": [0.55, -1.1, 1.2999999999999998], "operator_joints": [], "operator_coupling": "coupled", "primary_assembly_kg": 10.738226043740887, "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"rotor_hinge": "/db0994_turnstile_tripod/Articulation/Joints/rotor_hinge"}, "self_collisions": true, "filtered_pairs": [], "n_filtered_pairs": 0, "env_release": [{"name": "rotor_solenoid_hold", "body": "rotor", "other": "world", "label": "Turnstile solenoid lock (released on a valid credential)", "active": true, "holding_force_N": 5340.0, "release": "env", "release_joint": null, "release_fraction": null, "lock_model": "mag_lock", "joint": "/db0994_turnstile_tripod/Articulation/Joints/rotor_solenoid_hold", "joint_name": "rotor_solenoid_hold", "body_prim": "/db0994_turnstile_tripod/Articulation/rotor", "base_prim": "/db0994_turnstile_tripod/Articulation/base"}], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0994_turnstile_tripod/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0994_turnstile_tripod/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
