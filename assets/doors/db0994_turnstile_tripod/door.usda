            )
            {
                uniform token axis = "Z"
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Arm 3"
                custom string doorbench:semantic = "operator"
                double height = 0.4
                rel material:binding = </db0994_turnstile_tripod/Looks/mat_op_stainless>
                rel material:binding:physics = </db0994_turnstile_tripod/Looks/PhysMat_mat_op_stainless_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double radius = 0.019
                quatf xformOp:orient = (0.8978787, 0.34101066, -0.27843404, 0)
                double3 xformOp:translate = (-0.15000000000000013, -0.1837117307087383, 0.18371173070873828)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "arm_push"
            {
                custom string doorbench:site_role = "push"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.45, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }
}

def PhysicsScene "PhysicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
