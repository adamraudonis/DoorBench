                rel material:binding:physics = </db0637_pivot/Looks/PhysMat_mat_deadbolt_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double size = 1
                quatf xformOp:orient = (0.70710546, 0, 0.7071081, 0)
                float3 xformOp:scale = (0.012, 0.024, 0.032)
                double3 xformOp:translate = (0, -0.02, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}

