    custom string doorbench:meta = "{\"door_id\": \"db0039_swing_single\", \"family\": \"swing_single\", \"task\": \"hold_and_pass\", \"wall_y\": 0.056, \"clearance_allow\": [[\"*_paddle_neck_*\", \"*_paddle_pin_*\", \"the rocker neck is part of the hub that is clamped on its pivot pin\"], [\"*_paddle_hub_*\", \"*_paddle_pin_*\", \"the pivot pin runs in the hub's bore\"]], \"paddle_mechanisms\": [{\"primary_joint\": \"leaf_handle_hinge\", \"faces\": [{\"face\": -1.0, \"body\": \"leaf_handle\", \"joint\": \"leaf_handle_hinge\", \"site\": \"leaf_handle_grip_n\", \"geom\": \"leaf_handle_paddle_col_n\", \"action\": \"pull\", \"contact_face\": \"inner\"}, {\"face\": 1.0, \"body\": \"leaf_handle_paddle_follower_p\", \"joint\": \"leaf_handle_paddle_follower_p_hinge\", \"site\": \"leaf_handle_grip_p\", \"geom\": \"leaf_handle_paddle_col_p\", \"action\": \"push\", \"contact_face\": \"outer\"}], \"coupling\": \"ideal 1:1 paddle cam; internal cam contact and lost motion not modeled\", \"source\": \"https://commercial.schlage.com/content/dam/allegion-us-2/web-documents-2/InstallInstructions/Glynn-Johnson_HL6-9000_Push_Pull_Mortise_Latch_Installation_Instructions_107563.pdf\", \"source_page\": 2, \"rest_lean_rad\": 0.4, \"grip_moment_arm_m\": 0.09}], \"u\": -1.0, \"v\": -1.0, \"hinge_x\": 0.4615, \"leaf_edge_x_local\": -0.92, \"handle_height\": 0.965, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": \"leaf_handle_hinge\", \"mass_reconciled_kg\": 64.4114167456569, \"mass\": {\"leaf_material_kg\": 60.2209465, \"leaf_hardware_rider_kg\": 4.190470245656902, \"hardware_modelled_kg\": 1.109529754343097, \"leaf_bodies\": 1, \"total_moving_kg\": 65.5209465}, \"scene_extent\": 2.1102499999999997, \"cam_target_z\": 1.0735, \"cam_target_x\": 0.0, \"handle_cam_x\": -0.35250000000000004, \"handle_cam_target\": [-0.34650000000000003, -0.057021284843761226, 0.9626634899461481], \"handle_cam_pos\": [-0.16650000000000004, -0.8570212848437613, 1.2426634899461482], \"operator_joints\": [\"leaf_handle_hinge\"], \"operator_coupling\": \"coupled\", \"primary_assembly_kg\": 65.5209465}"
