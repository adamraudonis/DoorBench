  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.4575 0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.745329" effort="2000" velocity="10"/>
    <dynamics damping="2.25611" friction="1.556076"/>
    <doorbench:spring stiffness="6.6" springref="-0.409091" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="2" damping_opening="2" backcheck_angle="0" backcheck_damping="0"/>
  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="-0.859 -0.029 1.016" rpy="0 0 0"/>
