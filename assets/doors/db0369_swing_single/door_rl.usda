    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0369_swing_single/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "door_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 200
                custom float doorbench:friction_effort = 0
                custom string doorbench:label = "door_slide (unused slot, locked)"
                custom bool doorbench:locked = 1
                custom string doorbench:role = "locked"
                custom bool doorbench:slot_active = 0
                custom float doorbench:stiffness_si = 20000
                custom float doorbench:target_si = 0
                float drive:linear:physics:damping = 200
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 20000
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0369_swing_single/Articulation/base>
                rel physics:body1 = </db0369_swing_single/Articulation/carriage>
                point3f physics:localPos0 = (-0.4575, 0.0195, 0)
                point3f physics:localPos1 = (0.003, 0.0195, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -0.0005
                float physics:upperLimit = 0.0005
                custom float physxJoint:armature = 0.1
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:transX:armature = 0.1
                custom float physxJointAxis:transX:dynamicFrictionEffort = 0
                custom float physxJointAxis:transX:staticFrictionEffort = 0
                custom float physxJointAxis:transX:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "door_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:rotX"]
            )
            {
                custom float doorbench:damping_closing = 20
                custom float doorbench:damping_opening = 4
                custom float doorbench:damping_si = 4.2561097
                custom float doorbench:friction_effort = 5.8986983
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom bool doorbench:limited = 1
                custom bool doorbench:locked = 0
                custom string doorbench:role = "primary"
                custom bool doorbench:slot_active = 1
                custom string doorbench:source_joint = "leaf_hinge"
                custom float doorbench:stiffness_si = 3
                custom float doorbench:target_si = -2.5561028
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.07428313
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.05235988
                float drive:angular:physics:targetPosition = -146.45389
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0369_swing_single/Articulation/carriage>
                rel physics:body1 = </db0369_swing_single/Articulation/leaf>
                point3f physics:localPos0 = (0.003, 0.0195, 0)
                point3f physics:localPos1 = (0.003, 0.0195, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.0032630763
                custom float physxJointAxis:rotX:armature = 0.02
                custom float physxJointAxis:rotX:dynamicFrictionEffort = 5.8986983
                custom float physxJointAxis:rotX:staticFrictionEffort = 5.8986983
                custom float physxJointAxis:rotX:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "operator_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:rotX"]
            )
            {
                custom float doorbench:damping_si = 20
                custom float doorbench:friction_effort = 0
                custom string doorbench:label = "operator_hinge (unused slot, locked)"
                custom bool doorbench:locked = 1
                custom string doorbench:role = "locked"
                custom bool doorbench:slot_active = 0
                custom float doorbench:stiffness_si = 2000
                custom float doorbench:target_si = 0
                float drive:angular:physics:damping = 0.34906584
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 34.906586
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0369_swing_single/Articulation/leaf>
                rel physics:body1 = </db0369_swing_single/Articulation/operator_pivot>
                point3f physics:localPos0 = (0.872, -0.0225, 1.016)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
