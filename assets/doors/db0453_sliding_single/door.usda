{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0453_sliding_single"
    custom string doorbench:meta = '{"door_id": "db0453_sliding_single", "family": "sliding_single", "task": "traverse_open", "wall_y": 0.0, "sliding_track_supports": [{"joint": "leaf_slide", "body": "leaf", "rail": "track_header", "nominal_range": [0.0, 1.219], "leaf_width_m": 1.219, "rollers": [], "end_stops": [], "floor_guides_required": false, "floor_guides": []}], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "right", "operator_joint": null, "mass_reconciled_kg": 92.06608340000001, "scene_extent": 2.3435, "cam_target_z": 1.229, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [-0.5195000000000001, -0.1825, 1.0], "handle_cam_pos": [-0.3395000000000001, -0.9825, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0453_sliding_single/Articulation/Joints/leaf_slide"}}'

    def Scope "Looks"
    {
