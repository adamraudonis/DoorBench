def Xform "db0986_swing_single"
{
    custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.015679012345679012]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0986_swing_single"
    custom string doorbench:meta = '{"door_id": "db0986_swing_single", "family": "swing_single", "task": "traverse_open", "wall_y": -0.03499999999999999, "u": -1.0, "v": 1.0, "hinge_x": 0.41, "leaf_edge_x_local": -0.816, "handle_height": 1.016, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "mass_reconciled_kg": 14.90399487693575, "scene_extent": 2.03375, "cam_target_z": 1.0225, "cam_target_x": 0.0, "handle_cam_x": -0.303, "handle_cam_target": [-0.34600000000000003, -0.064, 1.016], "handle_cam_pos": [-0.16600000000000004, -0.8640000000000001, 1.296], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0986_swing_single/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0986_swing_single/Articulation/Joints/leaf_handle_hinge", "leaf_latch_bolt_slide": "/db0986_swing_single/Articulation/Joints/leaf_latch_bolt_slide"}}'

    def Scope "Looks"
