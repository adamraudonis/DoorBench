(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0426_vault" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "bolt_0_slide", "driver": "wheel_hinge", "coeff": [0, 0.008276037687802397, 0, 0, 0], "label": "bolt = wheel * throw/travel"}, {"type": "polynomial", "driven": "bolt_1_slide", "driver": "wheel_hinge", "coeff": [0, 0.008276037687802397, 0, 0, 0], "label": "bolt = wheel * throw/travel"}, {"type": "polynomial", "driven": "bolt_2_slide", "driver": "wheel_hinge", "coeff": [0, 0.008276037687802397, 0, 0, 0], "label": "bolt = wheel * throw/travel"}, {"type": "polynomial", "driven": "bolt_3_slide", "driver": "wheel_hinge", "coeff": [0, 0.008276037687802397, 0, 0, 0], "label": "bolt = wheel * throw/travel"}]'
        custom string doorbench:meta = '{"door_id": "db0426_vault", "family": "vault", "task": "unlock_open_traverse", "wall_y": 0.0, "operator_joint": "wheel_hinge", "u": 1.0, "v": -1.0, "primary_joint": "leaf_hinge", "handle_height": 1.05, "scene_extent": 2.1275, "cam_target_z": 1.085, "cam_target_x": 0.0, "handle_cam_x": 0.8, "handle_cam_target": [0.03999999999999998, -0.13, 1.25], "handle_cam_pos": [0.21999999999999997, -0.93, 1.53]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0426_vault/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

