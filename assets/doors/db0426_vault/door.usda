{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "bolt_0_slide", "driver": "wheel_hinge", "coeff": [0, 0.00859434682964095, 0, 0, 0], "gearing": -0.00859434682964095, "offset": -0.0, "label": "bolt = wheel * throw/travel", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "bolt_1_slide", "driver": "wheel_hinge", "coeff": [0, 0.00859434682964095, 0, 0, 0], "gearing": -0.00859434682964095, "offset": -0.0, "label": "bolt = wheel * throw/travel", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "bolt_2_slide", "driver": "wheel_hinge", "coeff": [0, 0.00859434682964095, 0, 0, 0], "gearing": -0.00859434682964095, "offset": -0.0, "label": "bolt = wheel * throw/travel", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "bolt_3_slide", "driver": "wheel_hinge", "coeff": [0, 0.00859434682964095, 0, 0, 0], "gearing": -0.00859434682964095, "offset": -0.0, "label": "bolt = wheel * throw/travel", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
