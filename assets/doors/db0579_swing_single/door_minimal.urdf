  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.407 -0.0245 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="2.160326" friction="0.541308"/>
    <doorbench:spring stiffness="6.6" springref="-0.409091" note="tau = -stiffness*(q - springref); not native URDF"/>
