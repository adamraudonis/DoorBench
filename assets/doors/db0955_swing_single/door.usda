lide", "leaf_keypad_key_hash_slide": "/db0955_swing_single/Articulation/Joints/leaf_keypad_key_hash_slide", "leaf_latch_bolt_slide": "/db0955_swing_single/Articulation/Joints/leaf_latch_bolt_slide", "leaf_deadbolt_slide": "/db0955_swing_single/Articulation/Joints/leaf_deadbolt_slide", "leaf_deadbolt_thumbturn_hinge": "/db0955_swing_single/Articulation/Joints/leaf_deadbolt_thumbturn_hinge"}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

