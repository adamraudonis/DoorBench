    def Xform "db0751_gate_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0751_gate_swing", "family": "gate_swing", "task": "open_only", "wall_y": 0.0, "clearance_allow": [["leaf_fork_bridge", "leaf_fork_bracket", "fork pivots on its bracket"]], "u": -1.0, "v": 1.0, "hinge_x": 0.456, "leaf_edge_x_local": -0.903, "handle_height": 0.7, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 7.64682, "scene_extent": 1.5, "cam_target_z": 0.46, "cam_target_x": 0.0, "handle_cam_x": -0.34400000000000003, "handle_cam_target": [-0.32699999999999996, 0.0, 0.9900000000000001], "handle_cam_pos": [-0.14699999999999996, -0.8, 1.27]}'
