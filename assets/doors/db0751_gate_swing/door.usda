                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "leaf_fork_handle" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Fork lift tab"
                custom string doorbench:semantic = "operator"
                rel material:binding = </World/db0751_gate_swing/Looks/mat_op_steel_galvanized>
                rel material:binding:physics = </World/db0751_gate_swing/Looks/PhysMat_mat_op_steel_galvanized> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.1, 0.04, 0.01)
                double3 xformOp:translate = (0.07, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "leaf_fork_grip"
            {
                custom string doorbench:site_role = "grip"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.1, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:damping_closing = 1
                custom float doorbench:damping_opening = 1
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.019314555
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.08726646
                float drive:angular:physics:targetPosition = -45.836624
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0751_gate_swing/leaf>
                point3f physics:localPos0 = (0.453, 0.0195, 0)
                point3f physics:localPos1 = (-0.003, 0.0195, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 80
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.65687394
            }

            def PhysicsRevoluteJoint "leaf_fork_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:initial = 0
                custom string doorbench:label = "Fork latch (0 = dropped over the top rail, + = lifted)"
                custom string doorbench:role = "latch"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.00034906584
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0751_gate_swing/leaf_fork>
                point3f physics:localPos0 = (-0.427, 0, 0.99)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 68.75494
                custom float physxJoint:armature = 0.005
                custom float physxJoint:jointFriction = 0.02
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

