    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0890_elevator/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "leaf_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 5.336795
                custom float doorbench:friction_effort = 6.544556
                custom float doorbench:initial = 0
                custom string doorbench:label = "Slide (0 = closed, + = open)"
                custom bool doorbench:limited = 1
                custom string doorbench:notes = "Elevator/airlock interlock (opens only when adjacent closed): leaf locked (env releases on credential / call button)"
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom string doorbench:source_joint = "leaf_slide"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 5.336795
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0890_elevator/Articulation/base>
                rel physics:body1 = </db0890_elevator/Articulation/leaf>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.002
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0.009997221
                custom float physxJointAxis:transX:armature = 0.5
                custom float physxJointAxis:transX:dynamicFrictionEffort = 6.544556
                custom float physxJointAxis:transX:staticFrictionEffort = 6.544556
                custom float physxJointAxis:transX:viscousFrictionCoefficient = 0
            }

            def PhysicsPrismaticJoint "call_button_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 1
                custom float doorbench:friction_effort = 0
                custom float doorbench:initial = 0
                custom string doorbench:label = "Call button (press)"
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "lock"
                custom string doorbench:source_joint = "call_button_slide"
                custom float doorbench:stiffness_si = 1500
                custom float doorbench:target_si = -0.003
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 1
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 1500
                float drive:linear:physics:targetPosition = -0.003
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0890_elevator/Articulation/base>
                rel physics:body1 = </db0890_elevator/Articulation/call_button>
                point3f physics:localPos0 = (0.795, -0.137, 1.05)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.003
                custom float physxJoint:armature = 0.1
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:transX:armature = 0.1
                custom float physxJointAxis:transX:dynamicFrictionEffort = 0
                custom float physxJointAxis:transX:staticFrictionEffort = 0
                custom float physxJointAxis:transX:viscousFrictionCoefficient = 0
            }
        }

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:label = "Fixed base link"
            custom string doorbench:semantic = "base"
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            float physics:mass = 1
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom float physxRigidBody:maxDepenetrationVelocity = 5
            custom float physxRigidBody:sleepThreshold = 0
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "leaf" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:label = "Sliding leaf"
            custom string doorbench:semantic = "leaf"
            point3f physics:centerOfMass = (0, 0, 1.08)
            float3 physics:diagonalInertia = (6.3717613, 24.528889, 30.89064)
            float physics:mass = 66.73166
            quatf physics:principalAxes = (-0.5, 0.5, 0.5, 0.5)
            custom float physxRigidBody:maxDepenetrationVelocity = 5
            custom float physxRigidBody:sleepThreshold = 0
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "leaf_slab" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Leaf slab"
                custom string doorbench:semantic = "leaf"
                rel material:binding = </db0890_elevator/Looks/mat_leaf>
                rel material:binding:physics = </db0890_elevator/Looks/PhysMat_mat_leaf_0_350> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1.07, 0.03, 2.1)
                double3 xformOp:translate = (0, 0, 1.08)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "leaf_edge_mid"
            {
                custom string doorbench:site_role = "leaf_edge"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.535, 0, 1.08)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Xform "call_button" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:label = "Elevator call button"
            custom string doorbench:semantic = "sensor"
            point3f physics:centerOfMass = (0, -0.003, 0)
            float3 physics:diagonalInertia = (2.5128816e-7, 2.5128816e-7, 4.771294e-7)
            float physics:mass = 0.00424115
            quatf physics:principalAxes = (0, 0, 0.70710677, -0.70710677)
            custom float physxRigidBody:maxDepenetrationVelocity = 5
            custom float physxRigidBody:sleepThreshold = 0
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.795, -0.137, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "call_button_geom" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Call button"
                custom string doorbench:semantic = "lock"
                double height = 0.006
                rel material:binding = </db0890_elevator/Looks/mat_callbtn>
                rel material:binding:physics = </db0890_elevator/Looks/PhysMat_mat_callbtn_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double radius = 0.015
                quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
                double3 xformOp:translate = (0, -0.003, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }
}

