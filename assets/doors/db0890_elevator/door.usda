#usda 1.0
(
    defaultPrim = "db0890_elevator"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0890_elevator"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0890_elevator"
    custom string doorbench:meta = '{"door_id": "db0890_elevator", "family": "elevator", "task": "unlock_open_traverse", "wall_y": 0.0, "sliding_track_supports": [{"joint": "leaf_slide", "body": "leaf", "rail": "track_header", "nominal_range": [0.0, 1.06], "leaf_width_m": 1.07, "rollers": [], "end_stops": [], "floor_guides_required": false, "floor_guides": []}], "actuators": [{"name": "leaf_drive", "joint": "leaf_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-135, 135], "ctrlrange": [0.0, 1.06]}], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "mass_reconciled_kg": 66.73165884991766, "scene_extent": 2.12, "cam_target_z": 1.08, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0890_elevator/Articulation/Joints/leaf_slide", "call_button_slide": "/db0890_elevator/Articulation/Joints/call_button_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0890_elevator/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0890_elevator/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
