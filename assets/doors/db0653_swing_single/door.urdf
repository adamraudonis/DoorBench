  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.3815 -0.027 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="2.356194" effort="2000" velocity="10"/>
