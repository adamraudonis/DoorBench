def Xform "db0552_revolving"
{
    custom string doorbench:door_id = "db0552_revolving"
    custom string doorbench:meta = '{"door_id": "db0552_revolving", "family": "revolving", "task": "traverse_open", "wall_y": 0.0, "primary_joint": "rotor_hinge", "operator_joint": null, "handle_height": 1.0, "drum_diameter": 1.8, "mass_reconciled_kg": 54.75, "scene_extent": 2.5250000000000004, "cam_target_z": 1.35, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.55, -1.1, 1.35]}'
    custom string doorbench:rl = '{"door_id": "db0552_revolving", "family": "revolving", "task": "traverse_open", "slots": {"door": "hinge", "operator": "none", "latch": "none", "secondary": "none"}, "links": ["base", "carriage", "leaf", "operator_pivot", "operator", "latch", "carriage2", "leaf2"], "joints": {"door_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "door_hinge": {"active": true, "type": "revolute", "source": "rotor_hinge", "role": "primary", "range": [-12.566370614359172, 12.566370614359172], "stiffness": 0.0, "damping": 23.0, "target": 0.0, "friction": 3.0023516509999997, "damping_closing": null, "damping_opening": null, "backcheck_angle": null, "backcheck_damping": null, "ratchet_one_way": false, "label": "Rotor (unbounded, + = CCW from above)"}, "operator_hinge": {"active": false, "type": "revolute", "range": [-0.0008726646259971648, 0.0008726646259971648]}, "operator_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "latch_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "leaf2_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "leaf2_hinge": {"active": false, "type": "revolute", "range": [-0.0008726646259971648, 0.0008726646259971648]}}, "primary_joint": "rotor_hinge", "operator_joint": null, "latch_joint": null, "secondary_joint": null, "door_joint": "door_hinge", "operator_slot_joint": null, "secondary_slot_joint": null, "latch_coupling": null, "secondary_coupling": null, "open_threshold": 0.17453292519943295, "clear_threshold": 1.0471975511965976, "closed_threshold": 0.05235987755982989, "sites": {"approach": [0.0, -1.9, 0.0], "goal": [0.0, 1.9, 0.0], "pass_plane": [0.0, 0.0, 1.2], "grip": [], "grip_link": "leaf", "push": [], "leaf_edge": []}, "opening": {"width": 1.9, "height": 2.7}, "robot": {"approach_side": "-y", "is_push": true, "robot_outside": false, "start_distance_m": 1.65}, "handle_height": 1.0, "u": null, "v": null, "hinge_x": null, "lock": {"model": "none", "engaged": false, "robot_side_release": true}, "closer": "none", "operator": "none", "latch": "none", "damage": {"leaf_dent_force_N": 1500.0, "glass_break_force_N": 1500, "operator_yield_torque_Nm": 1000000000.0, "slam_velocity_rad_s": 2.0, "frame_impact_force_N": 3000.0}, "actuators": [], "welded_static": [], "omitted": [], "notes": [], "mass_kg": 54.75}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0552_revolving/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0552_revolving/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "mat_frame"
        {
            token outputs:surface.connect = </db0552_revolving/Looks/mat_frame/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.17, 0.13)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "mat_drum_glass"
        {
            token outputs:surface.connect = </db0552_revolving/Looks/mat_drum_glass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.92, 0.95)
                float inputs:metallic = 0
                float inputs:opacity = 0.25
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "mat_floor_ring"
        {
            token outputs:surface.connect = </db0552_revolving/Looks/mat_floor_ring/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "PhysMat_mat_wall_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_drum_glass_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_frame_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }
    }

