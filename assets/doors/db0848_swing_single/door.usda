#usda 1.0
(
    defaultPrim = "db0848_swing_single"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0848_swing_single"
{
    custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.016075949367088605]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0848_swing_single"
    custom string doorbench:meta = '{"door_id": "db0848_swing_single", "family": "swing_single", "task": "open_and_traverse", "wall_y": 0.108, "u": 1.0, "v": -1.0, "hinge_x": -0.4105, "leaf_edge_x_local": 0.816, "handle_height": 0.965, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "mass_reconciled_kg": 51.126286552979444, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": 0.3025, "handle_cam_target": [0.2559, -0.077, 0.965], "handle_cam_pos": [0.4359, -0.877, 1.245], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0848_swing_single/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0848_swing_single/Articulation/Joints/leaf_handle_hinge", "leaf_latch_bolt_slide": "/db0848_swing_single/Articulation/Joints/leaf_latch_bolt_slide"}}'

    def Scope "Looks"
    {
