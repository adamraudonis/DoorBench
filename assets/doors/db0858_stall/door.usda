#usda 1.0
(
    defaultPrim = "db0858_stall"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0858_stall"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_rise", "driver": "leaf_hinge", "coeff": [0.0, 0.006366197723675814, 0, 0, 0], "gearing": -0.006366197723675814, "offset": -0.0, "label": "gravity hinge: 10 mm rise per 90 deg", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0858_stall"
    custom string doorbench:meta = '{"door_id": "db0858_stall", "family": "stall", "task": "open_and_traverse", "wall_y": 0.0, "operator_joint": "slide_latch_slide", "u": -1.0, "v": -1.0, "primary_joint": "leaf_hinge", "handle_height": 1.0, "mass_reconciled_kg": 31.93814188821314, "scene_extent": 2.075, "cam_target_z": 1.05, "cam_target_x": 0.0, "handle_cam_x": -0.76, "handle_cam_target": [-0.35000000000000003, -0.08199999999999999, 0.85], "handle_cam_pos": [-0.17000000000000004, -0.882, 1.13], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_rise": "/db0858_stall/Articulation/Joints/leaf_rise", "leaf_hinge": "/db0858_stall/Articulation/Joints/leaf_hinge", "slide_latch_slide": "/db0858_stall/Articulation/Joints/slide_latch_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0858_stall/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
