    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0858_stall/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "leaf_rise" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX", "PhysxMimicJointAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 1
                custom float doorbench:friction_effort = 0
                custom float doorbench:initial = 0.0016666667
                custom string doorbench:label = "Gravity-hinge lift (coupled)"
                custom bool doorbench:limited = 1
                custom string doorbench:mimic_label = "gravity hinge: 10 mm rise per 90 deg"
                custom bool doorbench:robot_interactive = 0
                custom string doorbench:role = "mechanism"
                custom string doorbench:source_joint = "leaf_rise"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0.0016666667
                float drive:linear:physics:damping = 1
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0858_stall/Articulation/base>
                rel physics:body1 = </db0858_stall/Articulation/leaf_riser>
                point3f physics:localPos0 = (0.436, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = -0.0016666667
                float physics:upperLimit = 0.028333334
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:transX:armature = 0.5
                custom float physxJointAxis:transX:dynamicFrictionEffort = 0
                custom float physxJointAxis:transX:staticFrictionEffort = 0
                custom float physxJointAxis:transX:viscousFrictionCoefficient = 0
                custom float physxMimicJoint:transX:gearing = -0.006366198
                custom float physxMimicJoint:transX:offset = -0
