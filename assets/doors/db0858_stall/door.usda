    def Xform "db0858_stall" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_rise", "driver": "leaf_hinge", "coeff": [0.0, 0.006366197723675814, 0, 0, 0], "label": "gravity hinge: 10 mm rise per 90 deg"}]'
        custom string doorbench:meta = '{"door_id": "db0858_stall", "family": "stall", "task": "open_and_traverse", "wall_y": 0.0, "operator_joint": "slide_latch_slide", "u": -1.0, "v": -1.0, "primary_joint": "leaf_hinge", "handle_height": 1.0, "scene_extent": 2.075, "cam_target_z": 1.05, "cam_target_x": 0.0, "handle_cam_x": -0.76, "handle_cam_target": [-0.35000000000000003, -0.08199999999999999, 0.85], "handle_cam_pos": [-0.17000000000000004, -0.882, 1.13]}'
