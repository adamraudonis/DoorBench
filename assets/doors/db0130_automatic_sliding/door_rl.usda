": 0.03, "sites": {"approach": [0.0, -1.5, 0.0], "goal": [0.0, 1.5, 0.0], "pass_plane": [0.0, 0.0, 1.325], "grip": [{"name": "leaf_a_edge_mid", "link": "leaf", "pos": [0.6, 0.0, 1.212]}, {"name": "leaf_b_edge_mid", "link": "leaf2", "pos": [-0.6, 0.0, 1.212]}], "grip_link": "leaf", "push": [], "leaf_edge": [{"name": "leaf_a_edge_mid", "link": "leaf", "pos": [0.6, 0.0, 1.212]}, {"name": "leaf_b_edge_mid", "link": "leaf2", "pos": [-0.6, 0.0, 1.212]}]}, "opening": {"width": 4.84, "height": 2.65}, "robot": {"approach_side": "-y", "is_push": false, "robot_outside": false, "start_distance_m": 2.0}, "handle_height": 1.0, "u": null, "v": null, "hinge_x": null, "lock": {"model": "electric_bolt", "engaged": false, "robot_side_release": true}, "closer": "none", "operator": "none", "latch": "none", "damage": {"leaf_dent_force_N": 1500.0, "glass_break_force_N": 1500, "operator_yield_torque_Nm": 1000000000.0, "slam_velocity_rad_s": 2.0, "frame_impact_force_N": 3000.0}, "actuators": [{"name": "leaf_a_drive", "joint": "leaf_a_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-150, 150], "ctrlrange": [0.0, 1.18]}, {"name": "leaf_b_drive", "joint": "leaf_b_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-150, 150], "ctrlrange": [0.0, 1.18]}], "welded_static": [], "omitted": [], "notes": [], "mass_kg": 50.310588823464066}'

