    <limit lower="0" upper="0.003" effort="5000" velocity="10"/>
    <dynamics damping="8.448318" friction="131.531697"/>
    <doorbench:spring stiffness="113.86439" springref="10" note="tau = -stiffness*(q - springref); not native URDF"/>
