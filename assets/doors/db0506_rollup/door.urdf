  <joint name="curtain_slide" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="curtain"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.003" effort="5000" velocity="10"/>
    <dynamics damping="8.448318" friction="131.531697"/>
    <doorbench:spring stiffness="123.002253" springref="10" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="padlock: locked (T-handle lock bars engaged; env unlock frees the joint) counterbalance ~90% of 139 kg"/>
  </joint>
