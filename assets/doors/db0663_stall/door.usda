ise", "hinge_joint": "leaf_hinge", "coeff_m_per_rad": 0.006366197723675814, "lift_m_per_rad": 0.006366197723675814, "carried_mass_kg": 20.91048, "gravity_torque_Nm": -1.3059096542360624, "label": "gravity hinge: 10 mm rise per 90 deg", "note": "constant closing torque -m*g*dz/dq of the helical hinge; apply on the hinge when the rise joint is not simulated"}, "max_angular_velocity_deg_s": 5729.5779513082325}'

