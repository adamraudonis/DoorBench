#usda 1.0
(
    defaultPrim = "db0151_sliding_single"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0151_sliding_single"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_hook_hinge", "driver": "leaf_hook_thumbturn_hinge", "coeff": [0, 1.0, 0, 0, 0], "gearing": -1.0, "offset": -0.0, "label": "hook = driver * coeff", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0151_sliding_single"
    custom string doorbench:meta = '{"door_id": "db0151_sliding_single", "family": "sliding_single", "task": "open_and_traverse", "wall_y": 0.0, "operator_joint": "leaf_teardrop_hinge", "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.05, "opens_toward": "left", "mass_reconciled_kg": 42.04571474247268, "scene_extent": 2.1155, "cam_target_z": 1.077, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.367, -0.1815, 1.05], "handle_cam_pos": [0.5469999999999999, -0.9815, 1.33], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0151_sliding_single/Articulation/Joints/leaf_slide", "leaf_teardrop_hinge": "/db0151_sliding_single/Articulation/Joints/leaf_teardrop_hinge", "leaf_hook_thumbturn_hinge": "/db0151_sliding_single/Articulation/Joints/leaf_hook_thumbturn_hinge", "leaf_hook_hinge": "/db0151_sliding_single/Articulation/Joints/leaf_hook_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0151_sliding_single/Looks/mat_floor/Shader.outputs:surface>

