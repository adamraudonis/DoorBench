  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.603 0.05 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.0015" effort="2000" velocity="10"/>
    <dynamics damping="1.674086" friction="2.892458"/>
    <doorbench:spring stiffness="5" springref="-0.8" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="1.5" damping_opening="1" backcheck_angle="0" backcheck_damping="0"/>
    <doorbench:note text="Padlocked hasp: leaf effectively fixed (2 mm rattle)"/>
  </joint>
  <joint name="leaf_fork_hinge" type="revolute">
    <origin xyz="1.06 -0.05 1" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_fork"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.001" effort="2000" velocity="10"/>
    <dynamics damping="1.722427" friction="0.02"/>
  </joint>
