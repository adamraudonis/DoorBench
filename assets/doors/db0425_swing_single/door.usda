eout_s": null, "lockout_s": null, "max_attempts": null, "release": "clutch", "clutch_joint": "leaf_handle_out_hinge", "bolt_joint": null, "clutch_locked_rad": 0.08, "clutch_open_rad": 0.87, "bolt_throw_m": null, "motor_force_N": null, "source": "Kaba Simplex 1000: buttons pressed in any order (each once), then the lever; turning the lever clears the chamber", "note": "mechanical combination chamber: press the buttons of the code in any order, then turn the outside lever; turning it on a wrong set clears the chamber and counts as a wrong attempt."}, "mass_reconciled_kg": 59.747776544921706, "mass": {"leaf_material_kg": 53.735613799999996, "leaf_hardware_rider_kg": 6.012162744921711, "hardware_modelled_kg": 0.08783725507828871, "leaf_bodies": 1, "total_moving_kg": 59.8356138}, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": 0.35400000000000004, "handle_cam_target": [0.35400000000000004, -0.06249999999999999, 1.04], "handle_cam_pos": [0.534, -0.8625, 1.32], "operator_joints": ["leaf_handle_hinge"], "operator_coupling": "coupled", "primary_assembly_kg": 59.8356138, "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0425_swing_single/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0425_swing_single/Articulation/Joints/leaf_handle_hinge", "leaf_keypad_key_1_slide": "/db0425_swing_single/Articulation/Joints/leaf_keypad_key_1_slide", "leaf_keypad_key_2_slide": "/db0425_swing_single/Articulation/Joints/leaf_keypad_key_2_slide", "leaf_keypad_key_3_slide": "/db0425_swing_single/Articulation/Joints/leaf_keypad_key_3_slide", "leaf_keypad_key_4_slide": "/db0425_swing_single/Articulation/Joints/leaf_keypad_key_4_slide", "leaf_keypad_key_5_slide": "/db0425_swing_single/Articulation/Joints/leaf_keypad_key_5_slide", "leaf_handle_out_hinge": "/db0425_swing_single/Articulation/Joints/leaf_handle_out_hinge", "leaf_latch_bolt_slide": "/db0425_swing_sing