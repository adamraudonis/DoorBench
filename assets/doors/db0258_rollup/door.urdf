  <joint name="curtain_slide" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="curtain"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3" effort="5000" velocity="10"/>
    <dynamics damping="5.547682" friction="333.992407"/>
    <doorbench:spring stiffness="72.03524" springref="10" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="counterbalance spring ~90% of weight counterbalance ~90% of 82 kg"/>
  </joint>
