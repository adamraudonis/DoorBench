#usda 1.0
(
    defaultPrim = "db0281_gate_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0281_gate_swing"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_latch_bar_hinge", "driver": "leaf_thumb_hinge", "coeff": [0, 2.0, 0, 0, 0], "gearing": -2.0, "offset": -0.0, "label": "bar lift = thumb press", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0281_gate_swing"
    custom string doorbench:meta = '{"door_id": "db0281_gate_swing", "family": "gate_swing", "task": "open_and_traverse", "wall_y": 0.0, "clearance_allow": [["leaf_latch_bar_geom", "leaf_latch_bar_pin", "bar on its pivot pin"]], "u": 1.0, "v": -1.0, "hinge_x": -0.506, "leaf_edge_x_local": 1.003, "handle_height": 0.9, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 13.89268, "scene_extent": 1.6400000000000001, "cam_target_z": 0.76, "cam_target_x": 0.0, "handle_cam_x": 0.394, "handle_cam_target": [0.4169999999999999, -0.0475, 0.85], "handle_cam_pos": [0.597, -0.8475, 1.13], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0281_gate_swing/Articulation/Joints/leaf_hinge", "leaf_thumb_hinge": "/db0281_gate_swing/Articulation/Joints/leaf_thumb_hinge", "leaf_latch_bar_hinge": "/db0281_gate_swing/Articulation/Joints/leaf_latch_bar_hinge"}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0281_gate_swing/Looks/mat_floor/Shader.outputs:surface>

