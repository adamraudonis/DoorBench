            custom int physxRigidBody:solverPositionIterationCount = 16
            custom int physxRigidBody:solverVelocityIterationCount = 4
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.4565, 0, 0.965)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "leaf_latch_bolt_capsule" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Latch bolt"
                custom string doorbench:semantic = "latch"
                double height = 0.027999999999999997
                rel material:binding = </World/db0101_swing_single/Looks/mat_bolt>
                rel material:binding:physics = </World/db0101_swing_single/Looks/PhysMat_mat_bolt> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double radius = 0.004
                quatf xformOp:orient = (0.70710677, 0, -0.70710677, 0)
                double3 xformOp:translate = (0.007999999999999997, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:damping_closing = 25
                custom float doorbench:damping_opening = 4
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.07517624
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.05235988
                float drive:angular:physics:targetPosition = -72.76564
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0101_swing_single/leaf>
                point3f physics:localPos0 = (0.4575, 0.0195, 0)
                point3f physics:localPos1 = (-0.003, 0.0195, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 2.669616
            }

            def PhysicsPrismaticJoint "leaf_latch_bolt_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            )
            {
                custom float doorbench:initial = 0
                custom string doorbench:label = "Latch bolt (0 = extended, + = retracted)"
                custom string doorbench:role = "latch"
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 2
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 300
                float drive:linear:physics:targetPosition = -0.006666667
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </World/db0101_swing_single/leaf>
                rel physics:body1 = </World/db0101_swing_single/leaf_latch_bolt>
                point3f physics:localPos0 = (-0.917, 0, 0.965)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.01
                custom float physxJoint:armature = 0.1
                custom float physxJoint:jointFriction = 0.3
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

