#usda 1.0
(
    defaultPrim = "db0033_gate_sliding"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0033_gate_sliding"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0033_gate_sliding"
    custom string doorbench:meta = '{"door_id": "db0033_gate_sliding", "family": "gate_sliding", "task": "unlock_open_traverse", "wall_y": 0.0, "operator_joint": "leaf_slide_bolt_slide", "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "mass_reconciled_kg": 18.23568806450683, "scene_extent": 3.2375, "cam_target_z": 1.075, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [1.6800000000000002, -0.14015, 0.4], "handle_cam_pos": [1.9300000000000002, -1.24015, 0.75], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0033_gate_sliding/Articulation/Joints/leaf_slide", "leaf_slide_bolt_slide": "/db0033_gate_sliding/Articulation/Joints/leaf_slide_bolt_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0033_gate_sliding/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0033_gate_sliding/Looks/mat_wall/Shader.outputs:surface>

