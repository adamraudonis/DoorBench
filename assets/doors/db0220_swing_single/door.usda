def Xform "db0220_swing_single"
{
    custom string doorbench:couplings = '[{"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame shoe", "note": "not exported to USD (PhysX articulations are trees); closer arms are visual"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_exit_device_slide", -1.357142857142857]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0220_swing_single"
    custom string doorbench:meta = '{"door_id": "db0220_swing_single", "family": "swing_single", "task": "open_only", "wall_y": 0.108, "u": 1.0, "v": -1.0, "hinge_x": -0.4605, "leaf_edge_x_local": 0.917, "handle_height": 1.016, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 49.1853497412529, "scene_extent": 2.03375, "cam_target_z": 1.0225, "cam_target_x": 0.0, "handle_cam_x": 0.35350000000000004, "handle_cam_target": [0.35350000000000004, 0.108, 1.016], "handle_cam_pos": [0.5335000000000001, -0.6920000000000001, 1.296], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0220_swing_single/Articulation/Joints/leaf_hinge", "leaf_exit_device_slide": "/db0220_swing_single/Articulation/Joints/leaf_exit_device_slide", "leaf_latch_bolt_slide": "/db0220_swing_single/Articulation/Joints/leaf_latch_bolt_slide", "closer_pinion": "/db0220_swing_single/Articulation/Joints/closer_pinion", "closer_elbow": "/db0220_swing_single/Articulation/Joints/closer_elbow"}}'

