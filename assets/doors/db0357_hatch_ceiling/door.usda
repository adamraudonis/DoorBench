            float3 physics:diagonalInertia = (0.7103575, 0.81253195, 1.4660738)
            float physics:mass = 14.996308
            quatf physics:principalAxes = (0.99158585, -0.007930291, 0.03155202, 0.12529577)
            custom bool physxRigidBody:enableCCD = 1
