#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0357_hatch_ceiling" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0357_hatch_ceiling", "family": "hatch_ceiling", "task": "close", "wall_y": 0.0, "primary_joint": "hatch_hinge", "handle_height": 2.4, "horizontal": true, "operator_joint": null, "scene_extent": 1.5, "cam_target_z": 2.785, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 2.4], "handle_cam_pos": [0.6499999999999999, -0.55, 1.5499999999999998]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0357_hatch_ceiling/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0357_hatch_ceiling/Looks/mat_wall/Shader.outputs:surface>

                def Shader "Shader"
                {
