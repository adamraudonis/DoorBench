{
    def Xform "db0940_swing_single" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.015679012345679012]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)"}]'
        custom string doorbench:meta = '{"door_id": "db0940_swing_single", "family": "swing_single", "task": "open_and_traverse", "wall_y": 0.03499999999999999, "u": -1.0, "v": -1.0, "hinge_x": 0.4605, "leaf_edge_x_local": -0.917, "handle_height": 0.914, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": -0.35350000000000004, "handle_cam_target": [-0.39649999999999996, -0.064, 0.914], "handle_cam_pos": [-0.21649999999999997, -0.8640000000000001, 1.194]}'
