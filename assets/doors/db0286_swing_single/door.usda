def Xform "db0286_swing_single"
{
    custom string doorbench:couplings = '[{"type": "weld", "body1": "leaf", "body2": "world", "label": "Maglock w/ REX button inside (fail-safe) (env releases on REX / badge / timer)", "active": true, "note": "breakable weld (maglock): environment logic, see doorbench.benchmark.DoorEnv"}, {"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame shoe", "note": "not exported to USD (PhysX articulations are trees); closer arms are visual"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_exit_device_slide", -1.357142857142857], ["leaf_far_lever_hinge", -0.02087912087912088]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0286_swing_single"
    custom string doorbench:meta = '{"door_id": "db0286_swing_single", "family": "swing_single", "task": "locked_recognize", "wall_y": 0.015500000000000003, "breakable_welds": [{"name": "leaf_maglock", "holding_force_N": 2670.0}], "u": 1.0, "v": -1.0, "hinge_x": -0.4605, "leaf_edge_x_local": 0.917, "handle_height": 1.04, "primary_joint": "leaf_hinge", "operator_joint": "leaf_far_lever_hinge", "mass_reconciled_kg": 65.28226063628516, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": 0.35350000000000004, "handle_cam_target": [0.2865, -0.077, 1.04], "handle_cam_pos": [0.46649999999999997, -0.877, 1.32], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0286_swing_single/Articulation/Joints/leaf_hinge", "leaf_exit_device_slide": "/db0286_swing_single/Articulation/Joints/leaf_exit_device_slide", "leaf_far_lever_hinge": "/db0286_swing_single/Articulation/Joints/leaf_far_lever_hinge", "leaf_latch_bolt_slide": "/db0286_swing_single/Articulation/Joints/leaf_latch_bolt_slide", "closer_pinion": "/db0286_swing_single/Articulation/Joints/closer_pinion", "closer_elbow": "/db0286_swing_single/Articulation/Joints/closer_elbow", "rex_button_slide": "/db0286_swing_single/Articulation/Joints/rex_button_slide"}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

