t\": null, \"secondary_slot_joint\": \"leaf2_slide\", \"latch_coupling\": null, \"secondary_coupling\": null, \"open_threshold\": 0.1, \"clear_threshold\": 0.55, \"closed_threshold\": 0.03, \"sites\": {\"approach\": [0.0, -1.5, 0.0], \"goal\": [0.0, 1.5, 0.0], \"pass_plane\": [0.0, 0.0, 1.026], \"grip\": [{\"name\": \"leaf_0_pull_grip_n\", \"link\": \"leaf\", \"pos\": [-0.367, -0.0049999999999999975, 1.0]}, {\"name\": \"leaf_1_pull_grip_n\", \"link\": \"leaf2\", \"pos\": [0.367, -0.005, 1.0]}], \"grip_link\": \"leaf\", \"push\": [], \"leaf_edge\": [{\"name\": \"leaf_0_edge_mid\", \"link\": \"leaf\", \"pos\": [-0.4570000000000001, 0.0, 1.028]}, {\"name\": \"leaf_1_edge_mid\", \"link\": \"leaf2\", \"pos\": [0.457, 0.0, 1.028]}]}, \"opening\": {\"width\": 2.692, \"height\": 2.052}, \"robot\": {\"approach_side\": \"-y\", \"is_push\": false, \"robot_outside\": false, \"start_distance_m\": 1.95}, \"handle_height\": 1.0, \"u\": null, \"v\": null, \"hinge_x\": null, \"lock\": {\"model\": \"none\", \"engaged\": false, \"robot_side_release\": true}, \"closer\": \"none\", \"operator\": \"pull_flush_recessed\", \"latch\": \"none\", \"damage\": {\"leaf_dent_force_N\": 1500.0, \"glass_break_force_N\": 1500, \"operator_yield_torque_Nm\": 500.0, \"slam_velocity_rad_s\": 2.0, \"frame_impact_force_N\": 3000.0}, \"actuators\": [], \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325, \"welded_static\": [], \"omitted\": [\"leaf_2\"], \"notes\": [\"leaf-like bodies omitted from the RL articulation (only two leaves are modelled): ['leaf_2']\"], \"mass_kg\": 9.662448000000001, \"welded\": [], \"released_parts\": [], \"released_holding\": [], \"welded_engaged\": [], \"operator_driven_joints\": [], \"couplings\": [], \"coupling_reflected_armature\": {}, \"self_collisions\": true, \"filtered_pairs\": [], \"n_filtered_pairs\": 0, \"env_release\": []}"

