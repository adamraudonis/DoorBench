#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0415_gate_sliding" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0415_gate_sliding", "family": "gate_sliding", "task": "open_and_traverse", "wall_y": 0.0, "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "scene_extent": 3.2375, "cam_target_z": 0.775, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [1.71, -0.123, 1.0], "handle_cam_pos": [1.96, -1.223, 1.35]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0415_gate_sliding/Looks/mat_floor/Shader.outputs:surface>

