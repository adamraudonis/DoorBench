def Xform "db0146_gate_sliding"
{
    custom string doorbench:couplings = '[{"type": "weld", "body1": "leaf", "body2": "world", "label": "Electric drop bolt (fail-safe) w/ card reader outside, REX button inside (env releases on credential / call button)", "active": true, "joint": "/db0146_gate_sliding/Articulation/Joints/leaf_electric_strike_hold", "holding_force_N": 6000.0, "note": "breakable FixedJoint (excludeFromArticulation); the environment clears physics:jointEnabled on release"}]'
