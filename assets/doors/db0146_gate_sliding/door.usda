46_gate_sliding/Articulation/Joints/leaf_electric_strike_hold", "joint_name": "leaf_electric_strike_hold", "body_prim": "/db0146_gate_sliding/Articulation/leaf", "base_prim": "/db0146_gate_sliding/Articulation/base"}], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

