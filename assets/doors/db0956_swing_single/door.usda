                custom float doorbench:target_si = -0.0075
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 1
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 400
                float drive:linear:physics:targetPosition = -0.0075
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0956_swing_single/Articulation/leaf>
                rel physics:body1 = </db0956_swing_single/Articulation/leaf_pushbutton>
                point3f physics:localPos0 = (-0.872, -0.0225, 1.016)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
