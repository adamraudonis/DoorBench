    <doorbench:closer damping_closing="0" damping_opening="0" backcheck_angle="0" backcheck_damping="0"/>
  </joint>
  <joint name="leaf_pushbutton_slide" type="prismatic">
    <origin xyz="-0.869 -0.003 1.016" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_pushbutton"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.006" effort="5000" velocity="10"/>
    <dynamics damping="16.008936" friction="0.5"/>
    <doorbench:spring stiffness="400" springref="-0.0075" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="-0.914 0.0195 1.016" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.01" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="300" springref="-0.006667" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_pushbutton_slide" multiplier="2" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
  <joint name="leaf_aux_bolt_slide" type="prismatic">
    <origin xyz="-0.914 0.044 1.266" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_aux_bolt"/>
    <axis xyz="1 0 0"/>
    <doorbench:zero_offset value="0.045" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.045" upper="0" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="1"/>
  </joint>
  <joint name="knocker_hinge" type="revolute">
    <origin xyz="-0.457 0.007 1.344" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="knocker"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.6" effort="2000" velocity="10"/>
    <dynamics damping="0.005" friction="0"/>
  </joint>
