  <joint name="leaf_rise" type="prismatic">
    <origin xyz="-0.436 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf_riser"/>
    <axis xyz="0 0 1"/>
    <doorbench:zero_offset value="0.001667" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.001667" upper="0.028333" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="0"/>
    <mimic joint="leaf_hinge" multiplier="0.006366" offset="0"/>
  </joint>
  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
    <parent link="leaf_riser"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <doorbench:zero_offset value="0.261799" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.261799" upper="1.308997" effort="2000" velocity="10"/>
    <dynamics damping="0.195221" friction="1.257755"/>
    <doorbench:closer damping_closing="0" damping_opening="0" backcheck_angle="0" backcheck_damping="0"/>
  </joint>
  <joint name="slide_latch_slide" type="prismatic">
    <origin xyz="0.734593 -0.218057 1" rpy="0 0 -0.261799"/>
    <parent link="leaf"/>
    <child link="slide_latch"/>
    <axis xyz="-1 0 0"/>
    <doorbench:zero_offset value="0.03" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.03" upper="0" effort="5000" velocity="10"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>
