#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0260_revolving" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0260_revolving", "family": "revolving", "task": "push_through", "wall_y": 0.0, "primary_joint": "rotor_hinge", "operator_joint": null, "handle_height": 1.0, "drum_diameter": 1.8, "scene_extent": 2.3255, "cam_target_z": 1.217, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.55, -1.1, 1.35]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0260_revolving/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0260_revolving/Looks/mat_wall/Shader.outputs:surface>

                def Shader "Shader"
