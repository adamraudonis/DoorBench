  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="1.005 -0.082 1" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_handle"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.5" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.07"/>
    <doorbench:spring stiffness="2.5" springref="-0.48" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_hasp_hinge" type="revolute">
    <origin xyz="1.015 -0.001 1.2" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_hasp"/>
    <axis xyz="0 0 1"/>
    <doorbench:zero_offset value="2.8" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-2.8" upper="0.1" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>
