#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0469_cold_storage" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_rise", "driver": "leaf_hinge", "coeff": [0.0, 0.007639437268410976, 0, 0, 0], "label": "rise = 12 mm per 90 deg (helical hinge)"}]'
        custom string doorbench:meta = '{"door_id": "db0469_cold_storage", "family": "cold_storage", "task": "close", "wall_y": -0.0, "u": 1.0, "v": 1.0, "hinge_x": -0.545, "leaf_edge_x_local": 1.073, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "scene_extent": 2.0, "cam_target_z": 1.0, "cam_target_x": 0.0, "handle_cam_x": 0.42500000000000004, "handle_cam_target": [0.26299999999999996, -0.13, 1.0], "handle_cam_pos": [0.44299999999999995, -0.93, 1.28]}'
