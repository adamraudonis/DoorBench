            def PhysicsRevoluteJoint "leaf_handle_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.01
                custom float doorbench:damping_si = 0.5899402
                custom float doorbench:friction_effort = 0.07
                custom float doorbench:initial = 0
                custom string doorbench:label = "Cold storage door handle w/ inside release (0 = rest, + = actuated; spring return)"
                custom float doorbench:legacy_friction_coeff = 0.0022610198
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "operator"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "leaf_handle_hinge"
                custom float doorbench:stiffness_si = 2.5
                custom float doorbench:target_si = -0.96
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.010296399
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.04363323
                float drive:angular:physics:targetPosition = -55.00395
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0469_cold_storage/Articulation/leaf>
                rel physics:body1 = </db0469_cold_storage/Articulation/leaf_handle>
                point3f physics:localPos0 = (1.008, 0, 1)
