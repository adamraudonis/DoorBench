  <joint name="leaf_a_slide" type="prismatic">
    <origin xyz="-0.225 0.152 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf_a"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.44" effort="5000" velocity="10"/>
