  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.4575 0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="12.268966" friction="1.742419"/>
    <doorbench:spring stiffness="15.011494" springref="-1.939847" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="90" damping_opening="12" backcheck_angle="1.22" backcheck_damping="60"/>
  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="0.802 -0.069 1.047895" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_handle"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.4" effort="2000" velocity="10"/>
    <dynamics damping="0.27663" friction="0.056"/>
    <doorbench:spring stiffness="1.5" springref="-1" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="Face-mounted rocker; ideal cam drives latch"/>
  </joint>
  <joint name="leaf_handle_paddle_follower_p_hinge" type="revolute">
    <origin xyz="0.802 0.011 1.047895" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_handle_paddle_follower_p"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.4" effort="2000" velocity="10"/>
    <dynamics damping="0" friction="0"/>
    <doorbench:note text="Face-mounted rocker; ideal cam drives latch"/>
    <mimic joint="leaf_handle_hinge" multiplier="1" offset="0"/>
  </joint>
  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="0.914 -0.029 0.965" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.019" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="600" springref="-0.01" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_handle_hinge" multiplier="0.051351" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
