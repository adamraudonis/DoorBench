{
    custom string doorbench:couplings = '[{"driven": "leaf_handle_paddle_follower_p_hinge", "driver": "leaf_handle_hinge", "driven_type": "hinge", "driver_type": "hinge", "mode": "mimic", "coeff": [0.0, 1.0], "gearing": -1.0, "offset": -0.0, "label": "Ideal paddle cam: follower q = primary q", "coeff_usd": [0.0, 1.0], "driven_zero_offset": 0.0, "driver_zero_offset": 0.0, "driven_inertia": 0.0027539898222484404, "reflected_inertia": 0.0027539898222484404, "driven_gravity_bias": -0.10175236305592854, "driven_stiffness": 0.0, "driven_damping": 0.0, "driven_target": 0.0, "driven_friction": 0.0, "driven_range": [0.0, 0.4], "friction_vel_eps": 0.001, "reason": null, "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m", "chain_order": 0, "type": "mimic", "driven_path": "/db0660_swing_single/Articulation/Joints/leaf_handle_paddle_follower_p_hinge", "driver_path": "/db0660_swing_single/Articulation/Joints/leaf_handle_hinge"}, {"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame shoe", "note": "not exported to USD (PhysX articulations are trees); closer arms are visual"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.05135135135135135]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0660_swing_single"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_handle"], ["leaf", "leaf_handle_paddle_follower_p"], ["leaf", "leaf_latch_bolt"]]'
    custom string doorbench:meta = "{\"door_id\": \"db0660_swing_single\", \"family\": \"swing_single\", \"task\": \"open_and_traverse\", \"wall_y\": -0.028500000000000004, \"clearance_allow\": [[\"*_paddle_neck_*\", \"*_paddle_pin_*\", \"the rocker neck is part of the hub that is clamped on its pivot pin\"], [\"*_paddle_hub_*\", \"*_paddle_pin_*\", \"the pivot pin runs in the hub's bore\"], [\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"paddle_mechanisms\": [{\"primary_joint\": \"leaf_handle_hinge\", \"faces\": [{\"face\": -1.0, \"body\": \"leaf_handle\", \"joint\": \"leaf_handle_hinge\", \"site\": \"leaf_handle_grip_n\", \"geom\": \"leaf_handle_paddle_col_n\", \"action\": \"push\", \"contact_face\": \"outer\"}, {\"face\": 1.0, \"body\": \"leaf_handle_paddle_follower_p\", \"joint\": \"leaf_handle_paddle_follower_p_hinge\", \"site\": \"leaf_handle_grip_p\", \"geom\": \"leaf_handle_paddle_col_p\", \"action\": \"pull\", \"contact_face\": \"inner\"}], \"coupling\": \"ideal 1:1 paddle cam; internal cam contact and lost motion not modeled\", \"source\": \"https://commercial.schlage.com/content/dam/allegion-us-2/web-documents-2/InstallInstructions/Glynn-Johnson_HL6-9000_Push_Pull_Mortise_Latch_Installation_Instructions_107563.pdf\", \"source_page\": 2, \"rest_lean_rad\": 0.4, \"grip_moment_arm_m\": 0.09}], \"u\": 1.0, \"v\": 1.0, \"hinge_x\": -0.4605, \"leaf_edge_x_local\": 0.917, \"handle_height\": 0.965, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": \"leaf_handle_hinge\", \"mass_reconciled_kg\": 67.8519344341254, \"scene_extent\": 2.1102499999999997, \"cam_target_z\": 1.0735, \"cam_target_x\": 0.0, \"handle_cam_x\": 0.35350000000000004, \"handle_cam_target\": [0.3444999999999999, 0.06952128484376122, 0.9626634899461481], \"handle_cam_pos\": [0.5245, -0.7304787151562389, 1.2426634899461482], \"operator_joints\": [\"leaf_handle_hinge\"], \"operator_coupling\": \"coupled\", \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0660_swing_single/Articulation/Joints/leaf_hinge\", \"leaf_handle_hinge\": \"/db0660_swing_single/Articulation/Joints/leaf_handle_hinge\", \"leaf_handle_paddle_follower_p_hinge\": \"/db0660_swing_single/Articulation/Joints/leaf_handle_paddle_follower_p_hinge\", \"leaf_latch_bolt_slide\": \"/db0660_swing_single/Articulation/Joints/leaf_latch_bolt_slide\", \"closer_pinion\": \"/db0660_swing_single/Articulation/Joints/closer_pinion\", \"closer_elbow\": \"/db0660_swing_single/Articulation/Joints/closer_elbow\"}, \"self_collisions\": true, \"filtered_pairs\": [[\"leaf\", \"leaf_handle\"], [\"leaf\", \"leaf_handle_paddle_follower_p\"], [\"leaf\", \"leaf_latch_bolt\"]], \"n_filtered_pairs\": 3, \"env_release\": [], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

