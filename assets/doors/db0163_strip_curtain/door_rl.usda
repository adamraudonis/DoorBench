    custom string doorbench:rl = "{\"door_id\": \"db0163_strip_curtain\", \"family\": \"strip_curtain\", \"task\": \"push_through\", \"slots\": {\"door\": \"hinge\", \"operator\": \"none\", \"latch\": \"none\", \"secondary\": \"hinge\"}, \"links\": [\"base\", \"carriage\", \"leaf\", \"operator_pivot\", \"operator\", \"latch\", \"carriage2\", \"leaf2\"], \"joints\": {\"door_slide\": {\"active\": false, \"type\": \"prismatic\", \"range\": [-0.0005, 0.0005]}, \"door_hinge\": {\"active\": true, \"type\": \"revolute\", \"source\": \"strip_4_hinge\", \"role\": \"primary\", \"range\": [-1.25, 1.25], \"stiffness\": 0.0, \"damping\": 0.05, \"target\": 0.0, \"friction\": 0.02, \"damping_closing\": null, \"damping_opening\": null, \"backcheck_angle\": null, \"backcheck_damping\": null, \"ratchet_one_way\": false, \"label\": \"Strip swings both ways\"}, \"operator_hinge\": {\"active\": false, \"type\": \"revolute\", \"range\": [-0.0008726646259971648, 0.0008726646259971648]}, \"operator_slide\": {\"active\": false, \"type\": \"prismatic\", \"range\": [-0.0005, 0.0005]}, \"latch_slide\": {\"active\": false, \"type\": \"prismatic\", \"range\": [-0.0005, 0.0005]}, \"leaf2_slide\": {\"active\": false, \"type\": \"prismatic\", \"range\": [-0.0005, 0.0005]}, \"leaf2_hinge\": {\"active\": true, \"type\": \"revolute\", \"source\": \"strip_0_hinge\", \"role\": \"secondary\", \"range\": [-1.25, 1.25], \"stiffness\": 0.0, \"damping\": 0.05, \"target\": 0.0, \"friction\": 0.02, \"damping_closing\": null, \"damping_opening\": null, \"backcheck_angle\": null, \"backcheck_damping\": null, \"ratchet_one_way\": false, \"label\": \"Strip swings both ways\"}}, \"primary_joint\": \"strip_4_hinge\", \"operator_joint\": null, \"latch_joint\": null, \"secondary_joint\": \"strip_0_hinge\", \"door_joint\": \"door_hinge\", \"operator_slot_joint\": null, \"secondary_slot_joint\": \"leaf2_hinge\", \"latch_coupling\": null, \"secondary_coupling\": null, \"open_threshold\": 0.17453292519943295, \"clear_threshold\": 1.0471975511965976, \"closed_threshold\": 0.05235987755982989, \"sites\": {\"approach\": [0.0, -1.5, 0.0], \"goal\": [0.0, 1.5, 0.0], \"pass_plane\": [0.0, 0.0, 1.06], \"grip\": [], \"grip_link\": \"leaf\", \"push\": [], \"leaf_edge\": []}, \"opening\": {\"width\": 0.92, \"height\": 2.12}, \"robot\": {\"approach_side\": \"-y\", \"is_push\": true, \"robot_outside\": false, \"start_distance_m\": 2.2}, \"handle_height\": 1.0, \"u\": null, \"v\": null, \"hinge_x\": null, \"lock\": {\"model\": \"none\", \"engaged\": false, \"robot_side_release\": true}, \"closer\": \"none\", \"operator\": \"none\", \"latch\": \"none\", \"damage\": {\"leaf_dent_force_N\": 1000000000.0, \"glass_break_force_N\": null, \"operator_yield_torque_Nm\": 1000000000.0, \"slam_velocity_rad_s\": 4.0, \"frame_impact_force_N\": 3000.0}, \"actuators\": [], \"welded_static\": [], \"omitted\": [\"strip_1\", \"strip_2\", \"strip_3\", \"strip_5\", \"strip_6\", \"strip_7\", \"strip_8\"], \"notes\": [\"leaf-like bodies omitted from the RL articulation (only two leaves are modelled): ['strip_1', 'strip_2', 'strip_3', 'strip_5', 'strip_6', 'strip_7', 'strip_8']\"], \"mass_kg\": 0.23777777777777778}"

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0163_strip_curtain/Looks/mat_floor/Shader.outputs:surface>

