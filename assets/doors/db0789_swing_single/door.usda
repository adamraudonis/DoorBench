                rel physics:body0 = </db0789_swing_single/Articulation/base>
                rel physics:body1 = </db0789_swing_single/Articulation/leaf>
                point3f physics:localPos0 = (-0.4575, -0.029, 0)
                point3f physics:localPos1 = (0.003, -0.029, 0)
