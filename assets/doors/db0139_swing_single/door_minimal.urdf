  <joint name="leaf_rise" type="prismatic">
    <origin xyz="-0.41 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf_riser"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.0176" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="0"/>
    <mimic joint="leaf_hinge" multiplier="0.005093" offset="0"/>
  </joint>
  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.003 -0.0245 0" rpy="0 0 0"/>
    <parent link="leaf_riser"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.919862" effort="2000" velocity="10"/>
    <dynamics damping="0.206618" friction="1.836743"/>
    <doorbench:closer damping_closing="0" damping_opening="0" backcheck_angle="0" backcheck_damping="0"/>
    <doorbench:note text="rising hinge: gravity closing torque ~ m*g*0.0051 N*m/rad"/>
  </joint>
