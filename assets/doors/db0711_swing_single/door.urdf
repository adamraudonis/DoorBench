  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.483 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.832596" effort="2000" velocity="10"/>
    <dynamics damping="10.334212" friction="0.491244"/>
    <doorbench:spring stiffness="13.852846" springref="-2.233476" note="tau = -stiffness*(q - springref); not native URDF"/>
