    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="12.976218" friction="4.992713"/>
    <doorbench:spring stiffness="21.358593" springref="-1.732324" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="90" damping_opening="12" backcheck_angle="1.22" backcheck_damping="60"/>
    <doorbench:note text="rising hinge: gravity closing torque ~ m*g*0.0076 N*m/rad"/>
  </joint>
