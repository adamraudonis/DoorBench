rmature": {}, "servo_in_drive": {"leaf_a_slide": {"kp": 400.0, "kv": 60.0, "force_limit": 150.0, "ctrl": 0.0}, "leaf_b_slide": {"kp": 400.0, "kv": 60.0, "force_limit": 150.0, "ctrl": 0.0}}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

