    custom string doorbench:couplings = "[{\"driven\": \"leaf_b_slide\", \"driver\": \"leaf_a_slide\", \"driven_type\": \"slide\", \"driver_type\": \"slide\", \"mode\": \"servo\", \"coeff\": [0.0, 1.0], \"gearing\": -1.0, \"offset\": -0.0, \"label\": \"leaves move symmetrically\", \"coeff_usd\": [0.0, 1.0], \"driven_zero_offset\": 0.0, \"driver_zero_offset\": 0.0, \"driven_inertia\": 66.2746895154345, \"reflected_inertia\": 66.2746895154345, \"driven_gravity_bias\": 0.0, \"driven_stiffness\": 0.0, \"driven_damping\": 5.315534999999999, \"driven_target\": 0.0, \"driven_friction\": 7.803429913859996, \"driven_range\": [0.0, 0.88], \"friction_vel_eps\": 0.001, \"reason\": \"both joints carry their own MJCF position servo in their PhysX drive: the drives move them together\", \"note\": \"PhysX drops mimics on prismatic axes: emulate bilaterally (track q_driven = c0 + c1*q_driver, apply c1 * tau_driven_ext on the driver and add reflected_inertia to the driver's armature)\", \"chain_order\": 0, \"type\": \"coupling_emulated\", \"driven_path\": \"/db0203_automatic_sliding/Articulation/Joints/leaf_b_slide\", \"driver_path\": \"/db0203_automatic_sliding/Articulation/Joints/leaf_a_slide\"}]"
