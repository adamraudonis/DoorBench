{
    def Xform "db0239_gate_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0239_gate_swing", "family": "gate_swing", "task": "open_and_traverse", "wall_y": 0.0, "clearance_allow": [["leaf_fork_bridge", "leaf_fork_bracket", "fork pivots on its bracket"]], "u": -1.0, "v": 1.0, "hinge_x": 1.806, "leaf_edge_x_local": -3.603, "handle_height": 0.9, "primary_joint": "leaf_hinge", "operator_joint": null, "scene_extent": 3.209, "cam_target_z": 0.76, "cam_target_x": 0.0, "handle_cam_x": -1.694, "handle_cam_target": [-1.677, 0.0, 1.6400000000000001], "handle_cam_pos": [-1.497, -0.8, 1.9200000000000002]}'
