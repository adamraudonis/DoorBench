  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.4575 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="12.268966" friction="2.808999"/>
    <doorbench:spring stiffness="12.363156" springref="-2.691869" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="81" damping_opening="12" backcheck_angle="1.22" backcheck_damping="60"/>
  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="0.844 0.029 0.965" rpy="0 0 0"/>
