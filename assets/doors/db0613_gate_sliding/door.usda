{
    def Xform "db0613_gate_sliding" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0613_gate_sliding", "family": "gate_sliding", "task": "close", "wall_y": 0.0, "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "scene_extent": 3.2375, "cam_target_z": 0.925, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [1.71, -0.1325, 1.0], "handle_cam_pos": [1.96, -1.2325000000000002, 1.35]}'
