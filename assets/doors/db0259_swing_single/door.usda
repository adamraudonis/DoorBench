                rel material:binding = </db0259_swing_single/Looks/mat_closer>
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.225, 0.014, 0.008)
                double3 xformOp:translate = (0.1125, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}

