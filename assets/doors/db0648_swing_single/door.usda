ndle_cam_target\": [0.4209999999999997, -0.06952128484376122, 1.013663489946148], \"handle_cam_pos\": [0.6009999999999998, -0.8695212848437612, 1.293663489946148], \"operator_joints\": [\"leaf_handle_hinge\"], \"operator_coupling\": \"coupled\", \"primary_assembly_kg\": 82.44056639999998, \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0648_swing_single/Articulation/Joints/leaf_hinge\", \"leaf_handle_hinge\": \"/db0648_swing_single/Articulation/Joints/leaf_handle_hinge\", \"leaf_handle_paddle_follower_p_hinge\": \"/db0648_swing_single/Articulation/Joints/leaf_handle_paddle_follower_p_hinge\", \"leaf_latch_bolt_slide\": \"/db0648_swing_single/Articulation/Joints/leaf_latch_bolt_slide\"}, \"self_collisions\": true, \"filtered_pairs\": [[\"leaf\", \"leaf_handle\"], [\"leaf\", \"leaf_handle_paddle_follower_p\"], [\"leaf\", \"leaf_latch_bolt\"]], \"n_filtered_pairs\": 3, \"env_release\": [], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

