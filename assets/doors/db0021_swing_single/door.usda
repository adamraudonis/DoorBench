        custom string doorbench:couplings = '[{"type": "weld", "body1": "leaf", "body2": "world", "label": "Delayed egress (15 s after 3 s push) (env releases on REX / badge / timer)", "active": true}, {"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame bracket"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.02087912087912088]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)"}]'
