{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "panel_0_1_hinge", "driver": "panel_0_0_hinge", "coeff": [0, -2.0, 0, 0, 0], "gearing": 2.0, "offset": -0.0, "label": "q = -2 * q_pivot (track-guided fold)", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "panel_1_1_hinge", "driver": "panel_1_0_hinge", "coeff": [0, -2.0, 0, 0, 0], "gearing": 2.0, "offset": -0.0, "label": "q = -2 * q_pivot (track-guided fold)", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0164_bifold"
    custom string doorbench:meta = '{"door_id": "db0164_bifold", "family": "bifold", "task": "open_and_traverse", "wall_y": 0.0, "primary_joint": "panel_0_0_hinge", "secondary_joint": "panel_1_0_hinge", "operator_joint": null, "handle_height": 1.0, "mass_reconciled_kg": 4.862959999999999, "scene_extent": 2.0652500000000003, "cam_target_z": 1.0435, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [-0.05500000000000001, -0.033, 1.0], "handle_cam_pos": [0.12499999999999999, -0.8330000000000001, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"panel_0_0_hinge": "/db0164_bifold/Articulation/Joints/panel_0_0_hinge", "panel_0_1_hinge": "/db0164_bifold/Articulation/Joints/panel_0_1_hinge", "panel_1_0_hinge": "/db0164_bifold/Articulation/Joints/panel_1_0_hinge", "panel_1_1_hinge": "/db0164_bifold/Articulation/Joints/panel_1_1_hinge"}}'

