            float3 physics:diagonalInertia = (0.00001632493, 0.00008399945, 0.00009083703)
            float physics:mass = 0.22236
            quatf physics:principalAxes = (-0, 0, 0.70710677, 0.70710677)
            custom bool physxRigidBody:enableCCD = 1
            custom int physxRigidBody:solverPositionIterationCount = 16
            custom int physxRigidBody:solverVelocityIterationCount = 4
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.4565, 0, 1.1560000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "leaf_deadbolt_box" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Deadbolt"
                custom string doorbench:semantic = "lock"
                rel material:binding = </World/db0596_swing_single/Looks/mat_deadbolt>
                rel material:binding:physics = </World/db0596_swing_single/Looks/PhysMat_mat_deadbolt> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.0654, 0.016, 0.025)
                double3 xformOp:translate = (0.007300000000000001, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:damping_closing = 0
                custom float doorbench:damping_opening = 0
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.005567002
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0596_swing_single/leaf>
                point3f physics:localPos0 = (0.4575, 0.029, 0)
                point3f physics:localPos1 = (-0.003, 0.029, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.51950264
            }

            def PhysicsFixedJoint "leaf_deadbolt_fixed"
            {
                rel physics:body0 = </World/db0596_swing_single/leaf>
                rel physics:body1 = </World/db0596_swing_single/leaf_deadbolt>
                point3f physics:localPos0 = (-0.917, 0, 1.156)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

