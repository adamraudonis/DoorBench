                custom float doorbench:stiffness_si = 400
                custom float doorbench:target_si = -0.01
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 2
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 400
                float drive:linear:physics:targetPosition = -0.01
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0879_swing_single/Articulation/leaf>
                rel physics:body1 = </db0879_swing_single/Articulation/leaf_latch_bolt>
