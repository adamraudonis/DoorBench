def Xform "db0167_sliding_single"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0167_sliding_single"
    custom string doorbench:meta = '{"door_id": "db0167_sliding_single", "family": "sliding_single", "task": "open_and_traverse", "wall_y": 0.0, "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "right", "operator_joint": null, "mass_reconciled_kg": 121.31368, "scene_extent": 2.315, "cam_target_z": 1.21, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [-0.4435, -0.14350000000000002, 1.0], "handle_cam_pos": [-0.2635, -0.9435, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0167_sliding_single/Articulation/Joints/leaf_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0167_sliding_single/Looks/mat_floor/Shader.outputs:surface>

