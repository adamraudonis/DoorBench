{
    def Xform "db0913_vault" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "bolt_0_slide", "driver": "wheel_hinge", "coeff": [0, 0.010345047109752996, 0, 0, 0], "label": "bolt = wheel * throw/travel"}, {"type": "polynomial", "driven": "bolt_1_slide", "driver": "wheel_hinge", "coeff": [0, 0.010345047109752996, 0, 0, 0], "label": "bolt = wheel * throw/travel"}, {"type": "polynomial", "driven": "bolt_2_slide", "driver": "wheel_hinge", "coeff": [0, 0.010345047109752996, 0, 0, 0], "label": "bolt = wheel * throw/travel"}, {"type": "polynomial", "driven": "bolt_3_slide", "driver": "wheel_hinge", "coeff": [0, 0.010345047109752996, 0, 0, 0], "label": "bolt = wheel * throw/travel"}]'
