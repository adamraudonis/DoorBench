#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0314_ship_watertight" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "dog_0_hinge", "driver": "wheel_hinge", "coeff": [0, 0.16666666666666669, 0, 0, 0], "label": "dog = wheel * (90deg / wheel travel)"}, {"type": "polynomial", "driven": "dog_1_hinge", "driver": "wheel_hinge", "coeff": [0, 0.16666666666666669, 0, 0, 0], "label": "dog = wheel * (90deg / wheel travel)"}, {"type": "polynomial", "driven": "dog_2_hinge", "driver": "wheel_hinge", "coeff": [0, 0.16666666666666669, 0, 0, 0], "label": "dog = wheel * (90deg / wheel travel)"}, {"type": "polynomial", "driven": "dog_3_hinge", "driver": "wheel_hinge", "coeff": [0, 0.16666666666666669, 0, 0, 0], "label": "dog = wheel * (90deg / wheel travel)"}]'
        custom string doorbench:meta = '{"door_id": "db0314_ship_watertight", "family": "ship_watertight", "task": "unlock_open_traverse", "wall_y": 0.0, "operator_joint": "wheel_hinge", "u": -1.0, "v": 1.0, "primary_joint": "leaf_hinge", "dog_joints": [], "sill_height": 0.3, "scene_extent": 1.7825, "cam_target_z": 1.005, "cam_target_x": 0.0, "handle_cam_x": -0.7000000000000001, "handle_cam_target": [0.0010000000000000009, -0.084, 1.3299999999999998], "handle_cam_pos": [0.181, -0.884, 1.6099999999999999]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0314_ship_watertight/Looks/mat_floor/Shader.outputs:surface>

