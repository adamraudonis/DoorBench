#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0811_elevator" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_b_slide", "driver": "leaf_a_slide", "coeff": [0, 1.0, 0, 0, 0], "label": "leaves move symmetrically"}]'
        custom string doorbench:meta = '{"door_id": "db0811_elevator", "family": "elevator", "task": "unlock_open_traverse", "wall_y": 0.0, "actuators": [{"name": "leaf_a_drive", "joint": "leaf_a_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-135, 135], "ctrlrange": [0.0, 0.44]}, {"name": "leaf_b_drive", "joint": "leaf_b_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-135, 135], "ctrlrange": [0.0, 0.44]}], "primary_joint": "leaf_a_slide", "secondary_joint": "leaf_b_slide", "handle_height": 1.0, "opens_toward": "right", "operator_joint": null, "scene_extent": 2.3449999999999998, "cam_target_z": 1.23, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0811_elevator/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

