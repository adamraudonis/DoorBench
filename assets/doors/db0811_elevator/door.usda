    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_b_slide", "driver": "leaf_a_slide", "coeff": [0, 1.0, 0, 0, 0], "gearing": -1.0, "offset": -0.0, "label": "leaves move symmetrically", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
