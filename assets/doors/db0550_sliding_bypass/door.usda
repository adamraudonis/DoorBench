                uniform token physics:axis = "X"
                rel physics:body0 = </db0550_sliding_bypass/Articulation/base>
                rel physics:body1 = </db0550_sliding_bypass/Articulation/leaf_1>
                point3f physics:localPos0 = (0.437, 0.028, 0)
