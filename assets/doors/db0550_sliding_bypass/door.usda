#usda 1.0
(
    defaultPrim = "db0550_sliding_bypass"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0550_sliding_bypass"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0550_sliding_bypass"
    custom string doorbench:meta = '{"door_id": "db0550_sliding_bypass", "family": "sliding_bypass", "task": "peek", "wall_y": 0.0, "sliding_track_supports": [{"joint": "leaf_0_slide", "body": "leaf_0", "rail": "leaf_0_track_header", "nominal_range": [0.0, 0.884], "leaf_width_m": 0.914, "rollers": [], "end_stops": [], "floor_guides_required": false, "floor_guides": []}, {"joint": "leaf_1_slide", "body": "leaf_1", "rail": "leaf_1_track_header", "nominal_range": [0.0, 0.884], "leaf_width_m": 0.914, "rollers": [], "end_stops": [], "floor_guides_required": false, "floor_guides": []}], "primary_joint": "leaf_0_slide", "secondary_joint": "leaf_1_slide", "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "mass_reconciled_kg": 27.908720000000002, "scene_extent": 2.039, "cam_target_z": 1.026, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [-0.8140000000000001, -0.031, 1.0], "handle_cam_pos": [-0.6340000000000001, -0.8310000000000001, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_0_slide": "/db0550_sliding_bypass/Articulation/Joints/leaf_0_slide", "leaf_1_slide": "/db0550_sliding_bypass/Articulation/Joints/leaf_1_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0550_sliding_bypass/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0550_sliding_bypass/Looks/mat_wall/Shader.outputs:surface>

