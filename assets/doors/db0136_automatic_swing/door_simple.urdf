  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.483 0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.658063" effort="2000" velocity="10"/>
    <dynamics damping="15.318237" friction="2.807648"/>
    <doorbench:spring stiffness="15.342537" springref="-1.864099" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="54" damping_opening="15" backcheck_angle="0" backcheck_damping="0"/>
  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="0.895 -0.029 1.04" rpy="0 0 0"/>
