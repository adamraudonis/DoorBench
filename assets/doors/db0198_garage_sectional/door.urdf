  <joint name="door_slide" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="door"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.95" effort="5000" velocity="10"/>
    <dynamics damping="7.3198" friction="41.735533"/>
    <doorbench:spring stiffness="96.34567" springref="6.5" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="counterbalance spring ~60% of weight counterbalance ~60% of 106 kg"/>
  </joint>
