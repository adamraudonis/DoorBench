                custom string doorbench:source_joint = "hatch_hinge"
                custom float doorbench:stiffness_si = 12.375
                custom float doorbench:target_si = -3.3333333
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.53820795
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.2159845
                float drive:angular:physics:targetPosition = -190.98593
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0241_hatch_floor/Articulation/base>
                rel physics:body1 = </db0241_hatch_floor/Articulation/hatch>
                point3f physics:localPos0 = (0, 0.455, 0.04)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 100
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.0012870415
                custom float physxJointAxis:rotX:armature = 0.02
