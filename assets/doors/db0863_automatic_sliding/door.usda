#usda 1.0
(
    defaultPrim = "db0863_automatic_sliding"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0863_automatic_sliding"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0863_automatic_sliding"
    custom string doorbench:meta = '{"door_id": "db0863_automatic_sliding", "family": "automatic_sliding", "task": "peek", "wall_y": 0.0, "actuators": [{"name": "leaf_drive", "joint": "leaf_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-150, 150], "ctrlrange": [0.0, 0.88]}], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "mass_reconciled_kg": 66.31069999999997, "scene_extent": 2.288, "cam_target_z": 1.192, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0863_automatic_sliding/Articulation/Joints/leaf_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0863_automatic_sliding/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0863_automatic_sliding/Looks/mat_wall/Shader.outputs:surface>

