    def Xform "db0863_automatic_sliding" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0863_automatic_sliding", "family": "automatic_sliding", "task": "peek", "wall_y": 0.0, "actuators": [{"name": "leaf_drive", "joint": "leaf_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-150, 150], "ctrlrange": [0.0, 0.88]}], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "scene_extent": 2.288, "cam_target_z": 1.192, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28]}'
