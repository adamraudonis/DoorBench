    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_slide_bolt"]]'
    custom string doorbench:meta = '{"door_id": "db0162_gate_swing", "family": "gate_swing", "task": "unlock_open_traverse", "wall_y": 0.0, "u": 1.0, "v": 1.0, "hinge_x": -0.506, "leaf_edge_x_local": 1.003, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 3.9906750630721066, "scene_extent": 1.5, "cam_target_z": 0.61, "cam_target_x": 0.0, "handle_cam_x": 0.394, "handle_cam_target": [0.4589999999999999, -0.1, 1.0], "handle_cam_pos": [0.6389999999999999, -0.9, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0162_gate_swing/Articulation/Joints/leaf_hinge", "leaf_slide_bolt_slide": "/db0162_gate_swing/Articulation/Joints/leaf_slide_bolt_slide"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_slide_bolt"]], "n_filtered_pairs": 1, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
