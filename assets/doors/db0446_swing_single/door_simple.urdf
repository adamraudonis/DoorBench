  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.4575 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.745329" effort="2000" velocity="10"/>
    <dynamics damping="12.268966" friction="2.329138"/>
    <doorbench:spring stiffness="12.369522" springref="-1.658916" note="tau = -stiffness*(q - springref); not native URDF"/>
