def Xform "db0738_saloon"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0738_saloon"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = "[]"
    custom string doorbench:meta = '{"door_id": "db0738_saloon", "family": "saloon", "task": "traverse_open", "wall_y": 0.0, "primary_joint": "leaf_a_hinge", "secondary_joint": "leaf_b_hinge", "both_ways": true, "mass_reconciled_kg": 14.410000000000004, "mass": {"leaf_material_kg": 13.860000000000003, "leaf_hardware_rider_kg": 0.55, "hardware_modelled_kg": 0.0, "leaf_bodies": 2, "total_moving_kg": 14.410000000000004}, "scene_extent": 2.0374999999999996, "cam_target_z": 1.025, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28], "operator_joints": [], "operator_coupling": "coupled", "primary_assembly_kg": 7.205000000000002, "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_a_hinge": "/db0738_saloon/Articulation/Joints/leaf_a_hinge", "leaf_b_hinge": "/db0738_saloon/Articulation/Joints/leaf_b_hinge"}, "self_collisions": true, "filtered_pairs": [], "n_filtered_pairs": 0, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0738_saloon/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0738_saloon/Looks/mat_wall/Shader.outputs:surface>

