def Xform "db0791_swing_single"
{
    custom string doorbench:couplings = '[{"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame shoe", "note": "not exported to USD (PhysX articulations are trees); closer arms are visual"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.02087912087912088]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0791_swing_single"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_handle"], ["leaf", "leaf_latch_bolt"]]'
    custom string doorbench:meta = "{\"door_id\": \"db0791_swing_single\", \"family\": \"swing_single\", \"task\": \"unlock_open_traverse\", \"wall_y\": 0.0435, \"clearance_allow\": [[\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"u\": -1.0, \"v\": -1.0, \"hinge_x\": 0.4605, \"leaf_edge_x_local\": -0.917, \"handle_height\": 1.04, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": \"leaf_handle_hinge\", \"mass_reconciled_kg\": 64.86725525063719, \"mass\": {\"leaf_material_kg\": 58.52530543904, \"leaf_hardware_rider_kg\": 6.341949811597186, \"hardware_modelled_kg\": 1.338050188402813, \"leaf_bodies\": 1, \"total_moving_kg\": 66.20530543904}, \"scene_extent\": 2.1102499999999997, \"cam_target_z\": 1.0735, \"cam_target_x\": 0.0, \"handle_cam_x\": -0.35350000000000004, \"handle_cam_target\": [-0.2905, -0.077, 1.04], \"handle_cam_pos\": [-0.11049999999999999, -0.877, 1.32], \"operator_joints\": [\"leaf_handle_hinge\"], \"operator_coupling\": \"coupled\", \"primary_assembly_kg\": 66.20530543904, \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0791_swing_single/Articulation/Joints/leaf_hinge\", \"leaf_handle_hinge\": \"/db0791_swing_single/Articulation/Joints/leaf_handle_hinge\", \"leaf_latch_bolt_slide\": \"/db0791_swing_single/Articulation/Joints/leaf_latch_bolt_slide\", \"closer_pinion\": \"/db0791_swing_single/Articulation/Joints/closer_pinion\", \"closer_elbow\": \"/db0791_swing_single/Articulation/Joints/closer_elbow\"}, \"self_collisions\": true, \"filtered_pairs\": [[\"leaf\", \"leaf_handle\"], [\"leaf\", \"leaf_latch_bolt\"]], \"n_filtered_pairs\": 2, \"env_release\": [], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

