                uniform token physics:axis = "X"
                rel physics:body0 = </db0812_swing_single/Articulation/base>
                rel physics:body1 = </db0812_swing_single/Articulation/carriage>
                point3f physics:localPos0 = (-0.4075, -0.029, 0)
