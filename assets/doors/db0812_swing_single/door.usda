    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_deadbolt_slide", "driver": "leaf_deadbolt_thumbturn_hinge", "coeff": [0.0, 0.012732365673542145, 0, 0, 0], "gearing": -0.012732365673542145, "offset": -0.0, "label": "deadbolt = throw/travel * thumbturn", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "leaf_multipoint_upper_slide", "driver": "leaf_deadbolt_slide", "coeff": [0.0, 1.0, 0, 0, 0], "gearing": -1.0, "offset": -0.0, "label": "lock point follows the main bolt", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "leaf_multipoint_lower_slide", "driver": "leaf_deadbolt_slide", "coeff": [0.0, 1.0, 0, 0, 0], "gearing": -1.0, "offset": -0.0, "label": "lock point follows the main bolt", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.02081967213114754]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
