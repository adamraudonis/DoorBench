    custom string doorbench:meta = '{"door_id": "db0801_automatic_sliding", "family": "automatic_sliding", "task": "open_and_traverse", "wall_y": 0.0, "sliding_track_supports": [{"joint": "leaf_slide", "body": "leaf", "rail": "track_header", "nominal_range": [0.0, 1.18], "leaf_width_m": 1.2, "rollers": [], "end_stops": [], "floor_guides_required": false, "floor_guides": []}], "env_release_joint": "leaf_electric_bolt_slide", "actuators": [{"name": "leaf_drive", "joint": "leaf_slide", "kind": "position", "kp": 400.0, "kv": 60.0, "forcerange": [-150, 150], "ctrlrange": [0.0, 1.18], "in_drive": true}], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "mass_reconciled_kg": 89.44723248474463, "scene_extent": 2.33, "cam_target_z": 1.192, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0801_automatic_sliding/Articulation/Joints/leaf_slide", "leaf_electric_bolt_slide": "/db0801_automatic_sliding/Articulation/Joints/leaf_electric_bolt_slide"}, "servo_in_drive": {"leaf_slide": {"kp": 400.0, "kv": 60.0, "force_limit": 150.0, "ctrl": 0.0}}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

