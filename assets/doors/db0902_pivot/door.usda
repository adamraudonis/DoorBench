def Xform "db0902_pivot"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0902_pivot"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_mag_catch"]]'
    custom string doorbench:meta = '{"door_id": "db0902_pivot", "family": "pivot", "task": "hold_and_pass", "wall_y": -0.09, "u": -1.0, "v": 1.0, "hinge_x": 0.456, "leaf_edge_x_local": -0.906, "handle_height": 1.05, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 96.12949752473604, "scene_extent": 2.1094999999999997, "cam_target_z": 1.073, "cam_target_x": 0.0, "handle_cam_x": -0.34400000000000003, "handle_cam_target": [-0.34500000000000003, -0.063, 1.05], "handle_cam_pos": [-0.16500000000000004, -0.863, 1.33], "operator_joints": [], "operator_coupling": "coupled", "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0902_pivot/Articulation/Joints/leaf_hinge", "leaf_mag_catch_slide": "/db0902_pivot/Articulation/Joints/leaf_mag_catch_slide"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_mag_catch"]], "n_filtered_pairs": 1, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0902_pivot/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
