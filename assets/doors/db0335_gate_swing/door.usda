)

def Xform "World"
{
    def Xform "db0335_gate_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.02295081967213115]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)"}]'
        custom string doorbench:meta = '{"door_id": "db0335_gate_swing", "family": "gate_swing", "task": "peek", "wall_y": 0.0, "u": -1.0, "v": -1.0, "hinge_x": 0.506, "leaf_edge_x_local": -1.003, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "scene_extent": 2.09, "cam_target_z": 1.06, "cam_target_x": 0.0, "handle_cam_x": -0.394, "handle_cam_target": [-0.33799999999999986, -0.0675, 1.0], "handle_cam_pos": [-0.15799999999999986, -0.8675, 1.28]}'
