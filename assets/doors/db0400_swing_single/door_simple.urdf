  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.483 0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.745329" effort="2000" velocity="10"/>
    <dynamics damping="10.334212" friction="2.580296"/>
    <doorbench:spring stiffness="15.673579" springref="-1.79155" note="tau = -stiffness*(q - springref); not native URDF"/>
