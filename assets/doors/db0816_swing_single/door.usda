                custom string doorbench:label = "Thumbturn collision"
                custom string doorbench:semantic = "lock"
                rel material:binding = </db0816_swing_single/Looks/mat_deadbolt>
                rel material:binding:physics = </db0816_swing_single/Looks/PhysMat_mat_deadbolt_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.012, 0.024, 0.032)
                double3 xformOp:translate = (0, -0.02, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}

