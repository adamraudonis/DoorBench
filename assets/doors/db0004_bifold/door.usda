#usda 1.0
(
    defaultPrim = "db0004_bifold"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0004_bifold"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "panel_0_1_hinge", "driver": "panel_0_0_hinge", "coeff": [0, -2.0, 0, 0, 0], "gearing": 2.0, "offset": -0.0, "label": "q = -2 * q_pivot (track-guided fold)", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0004_bifold"
    custom string doorbench:meta = '{"door_id": "db0004_bifold", "family": "bifold", "task": "open_only", "wall_y": 0.0, "primary_joint": "panel_0_0_hinge", "secondary_joint": null, "operator_joint": null, "handle_height": 1.0, "mass_reconciled_kg": 14.311760000000003, "scene_extent": 2.34125, "cam_target_z": 1.2275, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.7114999999999999, -0.0475, 1.0], "handle_cam_pos": [0.8915, -0.8475, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"panel_0_0_hinge": "/db0004_bifold/Articulation/Joints/panel_0_0_hinge", "panel_0_1_hinge": "/db0004_bifold/Articulation/Joints/panel_0_1_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0004_bifold/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0004_bifold/Looks/mat_wall/Shader.outputs:surface>

