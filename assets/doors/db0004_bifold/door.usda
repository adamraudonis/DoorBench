    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "panel_0_1_hinge", "driver": "panel_0_0_hinge", "coeff": [0, -2.0, 0, 0, 0], "label": "q = -2 * q_pivot (track-guided fold)"}]'
