#usda 1.0
(
    defaultPrim = "db0602_sliding_single"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0602_sliding_single"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0602_sliding_single"
    custom string doorbench:meta = '{"door_id": "db0602_sliding_single", "family": "sliding_single", "task": "locked_recognize", "wall_y": 0.0, "clearance_allow": [["leaf_hasp_strap", "leaf_staple*", "staple passes through the strap slot"], ["leaf_padlock*", "leaf_staple*", "shackle through the staple eye"], ["leaf_padlock*", "leaf_hasp_strap", "padlock hangs over the strap"], ["leaf_hasp_strap", "leaf_hasp_plate", "strap over its hinge plate"], ["leaf_hasp_knuckle", "leaf_hasp_plate", "knuckle on its hinge plate"]], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 0.95, "opens_toward": "right", "operator_joint": null, "mass_reconciled_kg": 115.43192344684554, "scene_extent": 2.3435, "cam_target_z": 1.229, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [-0.5755, -0.1335, 1.15], "handle_cam_pos": [-0.3955, -0.9335, 1.43], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0602_sliding_single/Articulation/Joints/leaf_slide", "leaf_hasp_hinge": "/db0602_sliding_single/Articulation/Joints/leaf_hasp_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0602_sliding_single/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0602_sliding_single/Looks/mat_wall/Shader.outputs:surface>

