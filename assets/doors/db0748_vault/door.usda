                point3f physics:localPos1 = (-0.006, -0.115, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 100
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0.0012907945
                custom float physxJointAxis:rotX:armature = 0.5
                custom float physxJointAxis:rotX:dynamicFrictionEffort = 19.865917
                custom float physxJointAxis:rotX:staticFrictionEffort = 19.865917
                custom float physxJointAxis:rotX:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "wheel_hinge" (
