  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.4575 0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="2.094395" effort="2000" velocity="10"/>
    <dynamics damping="10.25611" friction="0.263557"/>
    <doorbench:spring stiffness="12.598705" springref="-1.600164" note="tau = -stiffness*(q - springref); not native URDF"/>
