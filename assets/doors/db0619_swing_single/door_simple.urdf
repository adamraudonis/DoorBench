  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.534 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="10.475663" friction="0.405877"/>
    <doorbench:spring stiffness="12.859719" springref="-2.527271" note="tau = -stiffness*(q - springref); not native URDF"/>
