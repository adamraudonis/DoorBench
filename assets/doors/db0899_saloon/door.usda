                uniform token physics:axis = "X"
                rel physics:body0 = </db0899_saloon/Articulation/base>
                rel physics:body1 = </db0899_saloon/Articulation/leaf_a>
                point3f physics:localPos0 = (-0.606, 0, 0)
                point3f physics:localPos1 = (0.028, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = -90
                float physics:upperLimit = 90
