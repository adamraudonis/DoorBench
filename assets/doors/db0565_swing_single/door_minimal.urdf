  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.4575 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.658063" effort="2000" velocity="10"/>
    <dynamics damping="6.25611" friction="0.95172"/>
    <doorbench:spring stiffness="9.135494" springref="-1.778776" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="40" damping_opening="6" backcheck_angle="0" backcheck_damping="0"/>
  </joint>
