    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.658063" effort="2000" velocity="10"/>
    <dynamics damping="12.307281" friction="2.747205"/>
    <doorbench:spring stiffness="15.508058" springref="-1.827437" note="tau = -stiffness*(q - springref); not native URDF"/>
