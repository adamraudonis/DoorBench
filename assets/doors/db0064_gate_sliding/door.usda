                float3 xformOp:scale = (0.04, 0.0175, 1.773)
                double3 xformOp:translate = (0.4994999999999997, 0, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "leaf_hasp" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Hasp"
                custom string doorbench:semantic = "lock"
                rel material:binding = </db0064_gate_sliding/Looks/mat_op_steel_galvanized>
                rel material:binding:physics = </db0064_gate_sliding/Looks/PhysMat_mat_op_steel_galvanized_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.12, 0.006, 0.04)
                double3 xformOp:translate = (0.5599999999999999, -0.0165, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "leaf_edge_mid"
            {
                custom string doorbench:site_role = "leaf_edge"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.6, 0, 0.98)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }
}

def PhysicsScene "PhysicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

