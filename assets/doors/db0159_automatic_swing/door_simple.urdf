  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.433 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.078615" effort="2000" velocity="10"/>
    <dynamics damping="15.214767" friction="1.944756"/>
    <doorbench:spring stiffness="12.827888" springref="-1.543512" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="60" damping_opening="15" backcheck_angle="0" backcheck_damping="0"/>
    <doorbench:note text="Swing bar door guard (hotel), ~ 6 cm opening: opening limited to 4.5 deg"/>
  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="-0.794 0.029 1.04" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_handle"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.87" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.06"/>
    <doorbench:spring stiffness="1.1" springref="-0.363636" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="-0.864 0.029 1.04" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.019" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="550" springref="-0.01" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_handle_hinge" multiplier="0.023457" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
