#usda 1.0
(
    defaultPrim = "db0628_strip_curtain"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0628_strip_curtain"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0628_strip_curtain"
    custom string doorbench:meta = '{"door_id": "db0628_strip_curtain", "family": "strip_curtain", "task": "push_through", "wall_y": 0.0, "primary_joint": "strip_9_hinge", "operator_joint": null, "handle_height": 1.0, "both_ways": true, "n_strips": 18, "clearance_allow": [["strip_*_geom", "strip_*_geom", "overlapping PVC strips push each other aside (compliant in reality)"]], "mass_reconciled_kg": 2.66, "scene_extent": 2.09, "cam_target_z": 1.06, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"strip_0_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_0_hinge", "strip_1_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_1_hinge", "strip_2_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_2_hinge", "strip_3_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_3_hinge", "strip_4_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_4_hinge", "strip_5_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_5_hinge", "strip_6_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_6_hinge", "strip_7_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_7_hinge", "strip_8_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_8_hinge", "strip_9_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_9_hinge", "strip_10_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_10_hinge", "strip_11_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_11_hinge", "strip_12_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_12_hinge", "strip_13_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_13_hinge", "strip_14_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_14_hinge", "strip_15_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_15_hinge", "strip_16_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_16_hinge", "strip_17_hinge": "/db0628_strip_curtain/Articulation/Joints/strip_17_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0628_strip_curtain/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0628_strip_curtain/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "mat_frame"
        {
            token outputs:surface.connect = </db0628_strip_curtain/Looks/mat_frame/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "mat_strip"
        {
            token outputs:surface.connect = </db0628_strip_curtain/Looks/mat_strip/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.9, 0.95)
                float inputs:metallic = 0
                float inputs:opacity = 0.45
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "PhysMat_mat_floor_0_800" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.68
            float physics:restitution = 0.05
            float physics:staticFriction = 0.8
        }

        def Material "PhysMat_mat_wall_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_frame_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_strip_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }
    }

    def Xform "Env"
    {
