{
    def Xform "db0124_vault" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "bolt_0_slide", "driver": "dog_0_hinge", "coeff": [0, 0.06302521008403358, 0, 0, 0], "label": "bolt = lever * throw/(pi/2)"}, {"type": "polynomial", "driven": "bolt_1_slide", "driver": "dog_1_hinge", "coeff": [0, 0.06302521008403358, 0, 0, 0], "label": "bolt = lever * throw/(pi/2)"}]'
        custom string doorbench:meta = '{"door_id": "db0124_vault", "family": "vault", "task": "unlock_open_traverse", "wall_y": 0.0, "operator_joint": "dog_0_hinge", "u": 1.0, "v": -1.0, "primary_joint": "leaf_hinge", "handle_height": 1.05, "scene_extent": 2.1275, "cam_target_z": 1.085, "cam_target_x": 0.0, "handle_cam_x": 0.8, "handle_cam_target": [0.05650000000000005, -0.185, 0.5750000000000001], "handle_cam_pos": [0.23650000000000004, -0.9850000000000001, 0.8550000000000001]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0124_vault/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
