#usda 1.0
(
    defaultPrim = "db0419_rollup"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0419_rollup"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0419_rollup"
    custom string doorbench:meta = '{"door_id": "db0419_rollup", "family": "rollup", "task": "open_and_traverse", "wall_y": 0.0, "primary_joint": "curtain_slide", "handle_height": 0.9, "counterbalance_fraction": 0.9, "operator_joint": null, "mass_reconciled_kg": 37.888608, "scene_extent": 2.3675, "cam_target_z": 1.245, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.0, 0.1346, 0.16], "handle_cam_pos": [0.25, -0.9654, 0.51], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"curtain_slide": "/db0419_rollup/Articulation/Joints/curtain_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0419_rollup/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0419_rollup/Looks/mat_wall/Shader.outputs:surface>

