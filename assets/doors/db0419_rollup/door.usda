        {
            token outputs:surface.connect = </db0419_rollup/Looks/mat_op_black_matte_metal/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
