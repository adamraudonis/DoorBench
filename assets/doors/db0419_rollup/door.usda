        }

        def Material "mat_curtain"
        {
            token outputs:surface.connect = </db0419_rollup/Looks/mat_curtain/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.66, 0.68)
                float inputs:metallic = 0.9
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "mat_slat_line"
        {
            token outputs:surface.connect = </db0419_rollup/Looks/mat_slat_line/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
