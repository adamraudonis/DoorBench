def Xform "db0960_blast"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "bolt_0_slide", "driver": "dog_0_hinge", "coeff": [0, 0.038197097020626444, 0, 0, 0], "gearing": -0.038197097020626444, "offset": -0.0, "label": "bolt = lever * throw/(pi/2)", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "bolt_1_slide", "driver": "dog_1_hinge", "coeff": [0, 0.038197097020626444, 0, 0, 0], "gearing": -0.038197097020626444, "offset": -0.0, "label": "bolt = lever * throw/(pi/2)", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
