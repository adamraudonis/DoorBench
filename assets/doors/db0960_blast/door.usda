    custom string doorbench:meta = '{"door_id": "db0960_blast", "family": "blast", "task": "unlock_open_traverse", "wall_y": -0.08, "operator_joint": "dog_0_hinge", "u": 1.0, "v": 1.0, "primary_joint": "leaf_hinge", "handle_height": 1.05, "mass_reconciled_kg": 770.1661233572079, "scene_extent": 2.1275, "cam_target_z": 1.085, "cam_target_x": 0.0, "handle_cam_x": 0.9, "handle_cam_target": [0.126, -0.1, 0.5750000000000001], "handle_cam_pos": [0.306, -0.9, 0.8550000000000001], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0960_blast/Articulation/Joints/leaf_hinge", "dog_0_hinge": "/db0960_blast/Articulation/Joints/dog_0_hinge", "bolt_0_slide": "/db0960_blast/Articulation/Joints/bolt_0_slide", "dog_1_hinge": "/db0960_blast/Articulation/Joints/dog_1_hinge", "bolt_1_slide": "/db0960_blast/Articulation/Joints/bolt_1_slide"}}'

    def Scope "Looks"
