#usda 1.0
(
    defaultPrim = "db0805_pet_door"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0805_pet_door"
{
    custom string doorbench:door_id = "db0805_pet_door"
    custom string doorbench:meta = '{"door_id": "db0805_pet_door", "family": "pet_door", "task": "traverse_open", "wall_y": 0.0, "primary_joint": "flap_hinge", "operator_joint": null, "handle_height": 0.245, "both_ways": true, "mass_reconciled_kg": 0.485, "scene_extent": 1.5, "cam_target_z": 0.195, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 0.245], "handle_cam_pos": [0.48, -0.8, 0.525]}'
    custom string doorbench:rl = '{"door_id": "db0805_pet_door", "family": "pet_door", "task": "traverse_open", "slots": {"door": "hinge", "operator": "none", "latch": "none", "secondary": "none"}, "links": ["base", "carriage", "leaf", "operator_pivot", "operator", "latch", "carriage2", "leaf2"], "joints": {"door_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "door_hinge": {"active": true, "type": "revolute", "source": "flap_hinge", "role": "primary", "range": [-1.3089969389957472, 1.3089969389957472], "stiffness": 0.0, "damping": 0.010268078125, "target": 0.0, "friction": 0.031292168937499996, "damping_closing": null, "damping_opening": null, "backcheck_angle": null, "backcheck_damping": null, "ratchet_one_way": false, "label": "Flap (swings both ways)"}, "operator_hinge": {"active": false, "type": "revolute", "range": [-0.0008726646259971648, 0.0008726646259971648]}, "operator_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "latch_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "leaf2_slide": {"active": false, "type": "prismatic", "range": [-0.0005, 0.0005]}, "leaf2_hinge": {"active": false, "type": "revolute", "range": [-0.0008726646259971648, 0.0008726646259971648]}}, "primary_joint": "flap_hinge", "operator_joint": null, "latch_joint": null, "secondary_joint": null, "door_joint": "door_hinge", "operator_slot_joint": null, "secondary_slot_joint": null, "latch_coupling": null, "secondary_coupling": null, "open_threshold": 0.17453292519943295, "clear_threshold": 1.0471975511965976, "closed_threshold": 0.05235987755982989, "sites": {"approach": [0.0, -1.0, 0.0], "goal": [0.0, 1.0, 0.0], "pass_plane": [0.0, 0.0, 0.245], "grip": [], "grip_link": "leaf", "push": [], "leaf_edge": []}, "opening": {"width": 0.26, "height": 0.39}, "robot": {"approach_side": "-y", "is_push": true, "robot_outside": false, "start_distance_m": 2.0}, "handle_height": 0.245, "u": null, "v": null, "hinge_x": null, "lock": {"model": "none", "engaged": false, "robot_side_release": true}, "closer": "none", "operator": "none", "latch": "pet_flap_magnet", "damage": {"leaf_dent_force_N": 1000000000.0, "glass_break_force_N": null, "operator_yield_torque_Nm": 1000000000.0, "slam_velocity_rad_s": 4.0, "frame_impact_force_N": 3000.0}, "actuators": [], "welded_static": [], "omitted": [], "notes": [], "mass_kg": 0.485}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0805_pet_door/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0805_pet_door/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "mat_frame"
        {
            token outputs:surface.connect = </db0805_pet_door/Looks/mat_frame/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.4
                token outputs:surface
