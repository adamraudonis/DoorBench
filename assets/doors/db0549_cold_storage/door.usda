    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0549_cold_storage/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "leaf_rise" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX", "PhysxMimicJointAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 1
                custom float doorbench:friction_effort = 0
                custom float doorbench:initial = 0
                custom string doorbench:label = "Rising-hinge lift (coupled to hinge angle)"
                custom bool doorbench:limited = 1
                custom string doorbench:mimic_label = "rise = 12 mm per 90 deg (helical hinge)"
                custom bool doorbench:robot_interactive = 0
                custom string doorbench:role = "mechanism"
                custom string doorbench:source_joint = "leaf_rise"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 1
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0549_cold_storage/Articulation/base>
                rel physics:body1 = </db0549_cold_storage/Articulation/leaf_riser>
                point3f physics:localPos0 = (0.465, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.0264
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:transX:armature = 0.5
                custom float physxJointAxis:transX:dynamicFrictionEffort = 0
                custom float physxJointAxis:transX:staticFrictionEffort = 0
                custom float physxJointAxis:transX:viscousFrictionCoefficient = 0
                custom float physxMimicJoint:transX:gearing = -0.0076394374
                custom float physxMimicJoint:transX:offset = -0
                custom rel physxMimicJoint:transX:referenceJoint = </db0549_cold_storage/Articulation/Joints/leaf_hinge>
                custom token physxMimicJoint:transX:referenceJointAxis = "rotX"
            }

            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:rotX"]
            )
            {
                custom float doorbench:backcheck_angle = 1.22
                custom float doorbench:backcheck_damping = 60
                custom float doorbench:damping_closing = 90
                custom float doorbench:damping_opening = 12
                custom float doorbench:damping_si = 12.263793
                custom float doorbench:friction_effort = 4.346105
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom bool doorbench:limited = 1
                custom string doorbench:notes = "rising hinge: gravity closing torque ~ m*g*0.0076 N*m/rad"
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom string doorbench:source_joint = "leaf_hinge"
                custom float doorbench:stiffness_si = 16.997747
                custom float doorbench:target_si = -1.5296144
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.21404356
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.29666665
                float drive:angular:physics:targetPosition = -87.64045
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0549_cold_storage/Articulation/leaf_riser>
                rel physics:body1 = </db0549_cold_storage/Articulation/leaf>
                point3f physics:localPos0 = (-0.003, -0.082, 0)
                point3f physics:localPos1 = (-0.003, -0.082, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 100
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.0050660637
                custom float physxJointAxis:rotX:armature = 0.02
                custom float physxJointAxis:rotX:dynamicFrictionEffort = 4.346105
                custom float physxJointAxis:rotX:staticFrictionEffort = 4.346105
