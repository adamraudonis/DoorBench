        }

        def Xform "leaf" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysxFilteredPairsAPI"]
        )
        {
            custom string doorbench:label = "Door leaf"
            custom string doorbench:semantic = "leaf"
            point3f physics:centerOfMass = (-0.43259144, 0.004006145, 0.55265933)
            float3 physics:diagonalInertia = (0.6762281, 0.8773444, 1.5514224)
            float physics:mass = 9.457237
            quatf physics:principalAxes = (0.7066868, -0.7069796, 0.013954593, 0.024059664)
            custom rel physxFilteredPairs:filteredPairs = </db0989_gate_swing/Articulation/leaf_fork>
            custom float physxRigidBody:maxAngularVelocity = 5729.578
            custom float physxRigidBody:maxDepenetrationVelocity = 5
