    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0989_gate_swing/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.02
                custom float doorbench:damping_closing = 0
                custom float doorbench:damping_opening = 0
                custom float doorbench:damping_si = 0.21254
                custom float doorbench:friction_effort = 6.7684836
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom float doorbench:legacy_friction_coeff = 0.04901893
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "leaf_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.0037095228
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0989_gate_swing/Articulation/base>
                rel physics:body1 = </db0989_gate_swing/Articulation/leaf>
                point3f physics:localPos0 = (0.503, 0.05, 0)
                point3f physics:localPos1 = (-0.003, 0.05, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 100
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:angular:armature = 0.02
                custom float physxJointAxis:angular:dynamicFrictionEffort = 6.7684836
                custom float physxJointAxis:angular:staticFrictionEffort = 6.7684836
                custom float physxJointAxis:angular:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "leaf_fork_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.0001
                custom float doorbench:damping_si = 0.049204595
                custom float doorbench:friction_effort = 0.008803795
                custom float doorbench:initial = 0
                custom string doorbench:label = "Fork latch (0 = dropped over the post, + = lifted; gravity return, no spring)"
                custom float doorbench:legacy_friction_coeff = 0.002974197
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "operator"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "leaf_fork_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.0008587822
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0989_gate_swing/Articulation/leaf>
                rel physics:body1 = </db0989_gate_swing/Articulation/leaf_fork>
                point3f physics:localPos0 = (-0.863, 0, 0.7)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 68.75494
                custom float physxJoint:armature = 0.0001
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:angular:armature = 0.0001
                custom float physxJointAxis:angular:dynamicFrictionEffort = 0.008803795
                custom float physxJointAxis:angular:staticFrictionEffort = 0.008803795
                custom float physxJointAxis:angular:viscousFrictionCoefficient = 0
            }
        }

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:label = "Fixed base link"
            custom string doorbench:semantic = "base"
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            float physics:mass = 1
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom float physxRigidBody:maxAngularVelocity = 5729.578
            custom float physxRigidBody:maxDepenetrationVelocity = 5
            custom float physxRigidBody:sleepThreshold = 0
