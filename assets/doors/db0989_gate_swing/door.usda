    def Xform "db0989_gate_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0989_gate_swing", "family": "gate_swing", "task": "peek", "wall_y": 0.0, "clearance_allow": [["leaf_fork_eye", "leaf_fork_pin", "pivot pin through the fork eye"], ["leaf_fork_arm", "leaf_fork_pin", "pivot pin through the arm"]], "u": -1.0, "v": 1.0, "hinge_x": 0.506, "leaf_edge_x_local": -1.003, "handle_height": 0.7, "primary_joint": "leaf_hinge", "operator_joint": "leaf_fork_hinge", "mass_reconciled_kg": 9.107237007703155, "scene_extent": 1.5, "cam_target_z": 0.46, "cam_target_x": 0.0, "handle_cam_x": -0.394, "handle_cam_target": [-0.486, -0.0245, 0.8049999999999999], "handle_cam_pos": [-0.306, -0.8245, 1.085]}'
