def Xform "db0989_gate_swing"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0989_gate_swing"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_fork"]]'
    custom string doorbench:meta = '{"door_id": "db0989_gate_swing", "family": "gate_swing", "task": "peek", "wall_y": 0.0, "clearance_allow": [["leaf_fork_eye", "leaf_fork_pin", "pivot pin through the fork eye"], ["leaf_fork_arm", "leaf_fork_pin", "pivot pin through the arm"]], "u": -1.0, "v": 1.0, "hinge_x": 0.506, "leaf_edge_x_local": -1.003, "handle_height": 0.7, "primary_joint": "leaf_hinge", "operator_joint": "leaf_fork_hinge", "mass_reconciled_kg": 9.457237007703155, "mass": {"leaf_material_kg": 7.875, "leaf_hardware_rider_kg": 1.5822370077031547, "hardware_modelled_kg": 0.2677629922968455, "leaf_bodies": 1, "total_moving_kg": 9.725}, "scene_extent": 1.5, "cam_target_z": 0.46, "cam_target_x": 0.0, "handle_cam_x": -0.394, "handle_cam_target": [-0.486, -0.0245, 0.8049999999999999], "handle_cam_pos": [-0.306, -0.8245, 1.085], "operator_joints": ["leaf_fork_hinge"], "operator_coupling": "coupled", "primary_assembly_kg": 9.725, "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0989_gate_swing/Articulation/Joints/leaf_hinge", "leaf_fork_hinge": "/db0989_gate_swing/Articulation/Joints/leaf_fork_hinge"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_fork"]], "n_filtered_pairs": 1, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0989_gate_swing/Looks/mat_floor/Shader.outputs:surface>

