def Xform "db0085_revolving"
{
    custom string doorbench:door_id = "db0085_revolving"
    custom string doorbench:env_release = "[]"
    custom string doorbench:meta = '{"door_id": "db0085_revolving", "family": "revolving", "task": "traverse_open", "wall_y": 0.0, "primary_joint": "rotor_hinge", "operator_joint": null, "handle_height": 1.0, "drum_diameter": 2.0, "running_clearance_min": 0.01, "mass_reconciled_kg": 68.025, "scene_extent": 2.75, "cam_target_z": 1.5, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.55, -1.1, 1.35], "operator_joints": [], "operator_coupling": "coupled"}'
