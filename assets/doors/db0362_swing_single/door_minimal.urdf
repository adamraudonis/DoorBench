    <child link="leaf_handle"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.85" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.052"/>
    <doorbench:spring stiffness="0.6" springref="-0.5" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="-0.711 0.029 0.914" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.0127" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="300" springref="-0.008333" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_handle_hinge" multiplier="0.016494" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
  <joint name="leaf_hasp_hinge" type="revolute">
    <origin xyz="-0.656 -0.017 1.114" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_hasp"/>
    <axis xyz="0 0 1"/>
    <doorbench:zero_offset value="2.8" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-2.8" upper="0.1" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>
