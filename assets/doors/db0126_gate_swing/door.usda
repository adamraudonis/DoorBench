#usda 1.0
(
    defaultPrim = "db0126_gate_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0126_gate_swing"
{
    custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.01728395061728395]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0126_gate_swing"
    custom string doorbench:meta = '{"door_id": "db0126_gate_swing", "family": "gate_swing", "task": "traverse_open", "wall_y": 0.0, "u": -1.0, "v": 1.0, "hinge_x": 0.506, "leaf_edge_x_local": -1.003, "handle_height": 0.9, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "mass_reconciled_kg": 54.23374880231391, "scene_extent": 1.865, "cam_target_z": 0.91, "cam_target_x": 0.0, "handle_cam_x": -0.394, "handle_cam_target": [-0.44199999999999984, -0.059, 0.9], "handle_cam_pos": [-0.26199999999999984, -0.859, 1.1800000000000002], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0126_gate_swing/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0126_gate_swing/Articulation/Joints/leaf_handle_hinge", "leaf_latch_bolt_slide": "/db0126_gate_swing/Articulation/Joints/leaf_latch_bolt_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0126_gate_swing/Looks/mat_floor/Shader.outputs:surface>

