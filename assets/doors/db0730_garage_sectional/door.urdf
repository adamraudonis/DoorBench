  <joint name="door_slide" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="door"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.39" effort="5000" velocity="10"/>
    <dynamics damping="8.484656" friction="50.874201"/>
    <doorbench:spring stiffness="160.223978" springref="7.966667" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="counterbalance spring ~85% of weight counterbalance ~85% of 153 kg"/>
  </joint>
