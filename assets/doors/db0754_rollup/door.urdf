    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3" effort="5000" velocity="10"/>
    <dynamics damping="4.945985" friction="60.091707"/>
    <doorbench:spring stiffness="52.020203" springref="10" note="tau = -stiffness*(q - springref); not native URDF"/>
