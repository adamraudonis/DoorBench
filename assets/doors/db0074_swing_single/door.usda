    {
        custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.05135135135135135]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)"}]'
