    def Xform "db0620_sliding_single" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_hook_hinge", "driver": "leaf_handle_hinge", "coeff": [0, 1.0, 0, 0, 0], "label": "hook = driver * coeff"}]'
        custom string doorbench:meta = '{"door_id": "db0620_sliding_single", "family": "sliding_single", "task": "close", "wall_y": 0.0, "operator_joint": "leaf_handle_hinge", "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 0.95, "opens_toward": "left", "scene_extent": 2.765, "cam_target_z": 1.0385, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [1.3489999999999998, -0.0775, 0.95], "handle_cam_pos": [1.5289999999999997, -0.8775000000000001, 1.23]}'
