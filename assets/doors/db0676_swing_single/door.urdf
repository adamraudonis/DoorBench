  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.61 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="12.810319" friction="3.934067"/>
    <doorbench:spring stiffness="18.767551" springref="-2.188352" note="tau = -stiffness*(q - springref); not native URDF"/>
