                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 1400
                float drive:linear:physics:targetPosition = -0.015714286
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0833_swing_double/Articulation/leaf_a>
                rel physics:body1 = </db0833_swing_double/Articulation/leaf_a_exit_device>
                point3f physics:localPos0 = (0.51995, -0.022, 1.016)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
