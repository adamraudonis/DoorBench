#usda 1.0
(
    defaultPrim = "db0591_pivot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0591_pivot"
{
    custom string doorbench:couplings = '[{"type": "weld", "body1": "leaf", "body2": "world", "label": "Maglock w/ REX button inside (fail-safe) (env releases on REX / badge / timer)", "active": true, "note": "breakable weld (maglock): environment logic, see doorbench.benchmark.DoorEnv"}]'
    custom string doorbench:door_id = "db0591_pivot"
    custom string doorbench:meta = '{"door_id": "db0591_pivot", "family": "pivot", "task": "locked_recognize", "wall_y": 0.029999999999999995, "breakable_welds": [{"name": "leaf_maglock", "holding_force_N": 2670.0}], "u": -1.0, "v": -1.0, "hinge_x": 0.506, "leaf_edge_x_local": -1.006, "handle_height": 1.05, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 78.21724, "scene_extent": 2.5340000000000003, "cam_target_z": 1.356, "cam_target_x": 0.0, "handle_cam_x": -0.394, "handle_cam_target": [-0.395, -0.0875, 1.05], "handle_cam_pos": [-0.21500000000000002, -0.8875000000000001, 1.33], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0591_pivot/Articulation/Joints/leaf_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0591_pivot/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0591_pivot/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
