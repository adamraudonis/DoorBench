  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.4325 -0.0245 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.356194" effort="2000" velocity="10"/>
    <dynamics damping="0.254501" friction="0.257299"/>
    <doorbench:closer damping_closing="0" damping_opening="0" backcheck_angle="0" backcheck_damping="0"/>
