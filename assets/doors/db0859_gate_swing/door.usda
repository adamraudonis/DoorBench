    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0859_gate_swing/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:rotX"]
            )
            {
                custom float doorbench:damping_closing = 0
                custom float doorbench:damping_opening = 0
                custom float doorbench:damping_si = 143.855
                custom float doorbench:friction_effort = 6.861201
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom string doorbench:source_joint = "leaf_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 2.5107431
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0859_gate_swing/Articulation/base>
                rel physics:body1 = </db0859_gate_swing/Articulation/leaf>
                point3f physics:localPos0 = (-2.403, -0.0295, 0)
                point3f physics:localPos1 = (0.003, -0.0295, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 100
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.002130939
                custom float physxJointAxis:rotX:armature = 0.02
                custom float physxJointAxis:rotX:dynamicFrictionEffort = 6.861201
                custom float physxJointAxis:rotX:staticFrictionEffort = 6.861201
                custom float physxJointAxis:rotX:viscousFrictionCoefficient = 0
            }

            def PhysicsPrismaticJoint "leaf_slide_bolt_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 1
                custom float doorbench:friction_effort = 3
                custom float doorbench:initial = 0
                custom string doorbench:label = "Slide bolt (0 = engaged, + = withdrawn)"
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "lock"
                custom string doorbench:source_joint = "leaf_slide_bolt_slide"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 1
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0859_gate_swing/Articulation/leaf>
                rel physics:body1 = </db0859_gate_swing/Articulation/leaf_slide_bolt>
                point3f physics:localPos0 = (4.623, -0.0425, 1)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.08
                custom float physxJoint:armature = 0.1
                custom float physxJoint:jointFriction = 0.3533025
                custom float physxJointAxis:transX:armature = 0.1
                custom float physxJointAxis:transX:dynamicFrictionEffort = 3
                custom float physxJointAxis:transX:staticFrictionEffort = 3
                custom float physxJointAxis:transX:viscousFrictionCoefficient = 0
            }
        }

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:label = "Fixed base link"
            custom string doorbench:semantic = "base"
            point3f physics:centerOfMass = (0, 0, 0)
