def Xform "db0026_swing_single"
{
    custom string doorbench:couplings = '[{"type": "weld", "body1": "leaf", "body2": "world", "label": "Maglock w/ REX button inside (fail-safe) (env releases on REX / badge / timer)", "active": true, "note": "breakable weld (maglock): environment logic, see doorbench.benchmark.DoorEnv"}]'
    custom string doorbench:door_id = "db0026_swing_single"
    custom string doorbench:meta = '{"door_id": "db0026_swing_single", "family": "swing_single", "task": "unlock_open_traverse", "wall_y": -0.039999999999999994, "breakable_welds": [{"name": "leaf_maglock", "holding_force_N": 2670.0}], "u": -1.0, "v": 1.0, "hinge_x": 0.4605, "leaf_edge_x_local": -0.917, "handle_height": 1.016, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 89.13437269999999, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": -0.35350000000000004, "handle_cam_target": [-0.35150000000000003, -0.0725, 1.016], "handle_cam_pos": [-0.17150000000000004, -0.8725, 1.296], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0026_swing_single/Articulation/Joints/leaf_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0026_swing_single/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
