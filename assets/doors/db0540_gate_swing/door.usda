#usda 1.0
(
    defaultPrim = "db0540_gate_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0540_gate_swing"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0540_gate_swing"
    custom string doorbench:meta = '{"door_id": "db0540_gate_swing", "family": "gate_swing", "task": "open_and_traverse", "wall_y": 0.0, "clearance_allow": [["leaf_pin_geom", "leaf_pin_housing", "pin slides inside its housing"], ["leaf_pin_knob", "leaf_pin_housing", "knob seats on the housing"], ["leaf_pin_geom", "leaf_pin_bracket*", "pin passes the bracket"]], "u": 1.0, "v": 1.0, "hinge_x": -0.456, "leaf_edge_x_local": 0.903, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": "leaf_pin_slide", "mass_reconciled_kg": 33.75978341421225, "scene_extent": 1.5, "cam_target_z": 0.61, "cam_target_x": 0.0, "handle_cam_x": 0.34400000000000003, "handle_cam_target": [0.40700000000000003, -0.0475, 1.065], "handle_cam_pos": [0.587, -0.8475, 1.345], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0540_gate_swing/Articulation/Joints/leaf_hinge", "leaf_pin_slide": "/db0540_gate_swing/Articulation/Joints/leaf_pin_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0540_gate_swing/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

