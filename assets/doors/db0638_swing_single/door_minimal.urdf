  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.443 -0.0325 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.443461" effort="2000" velocity="10"/>
    <dynamics damping="8.268966" friction="1.531259"/>
    <doorbench:spring stiffness="35.383327" springref="-1.648234" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="100" damping_opening="8" backcheck_angle="1.4" backcheck_damping="60"/>
  </joint>
  <joint name="leaf_exit_device_slide" type="prismatic">
    <origin xyz="-0.50095 0.055 1.067" rpy="0 0 0"/>
