                rel material:binding = </World/db0478_gate_swing/Looks/mat_hinge>
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.003, 0.0255, 1.1500000000000001)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Cube "leaf_hasp" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom string doorbench:label = "Hasp (visual)"
                custom string doorbench:semantic = "lock"
                rel material:binding = </World/db0478_gate_swing/Looks/mat_op_steel_galvanized>
                double size = 1
