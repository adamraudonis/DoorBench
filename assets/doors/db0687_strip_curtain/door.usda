    def Xform "db0687_strip_curtain" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0687_strip_curtain", "family": "strip_curtain", "task": "push_through", "wall_y": 0.0, "primary_joint": "strip_4_hinge", "operator_joint": null, "handle_height": 1.0, "both_ways": true, "n_strips": 9, "clearance_allow": [["strip_*_geom", "strip_*_geom", "overlapping PVC strips push each other aside (compliant in reality)"]], "mass_reconciled_kg": 3.18, "scene_extent": 2.09, "cam_target_z": 1.06, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28]}'
