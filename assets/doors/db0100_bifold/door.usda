        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_panel_0_0_0_350" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2975
            float physics:restitution = 0.05
            float physics:staticFriction = 0.35
        }

        def Material "PhysMat_mat_panel_0_1_0_350" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2975
            float physics:restitution = 0.05
            float physics:staticFriction = 0.35
        }

        def Material "PhysMat_mat_op_stainless_0_700" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.595
            float physics:restitution = 0.05
            float physics:staticFriction = 0.7
        }
    }

