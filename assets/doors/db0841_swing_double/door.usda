    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0841_swing_double/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsRevoluteJoint "leaf_a_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.02
                custom float doorbench:backcheck_angle = 1.31
                custom float doorbench:backcheck_damping = 45
                custom float doorbench:damping_closing = 70
                custom float doorbench:damping_opening = 10
                custom float doorbench:damping_si = 10.168374
                custom float doorbench:friction_effort = 1.5653292
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom float doorbench:legacy_friction_coeff = 0.003714573
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "leaf_a_hinge"
                custom float doorbench:stiffness_si = 12.859719
                custom float doorbench:target_si = -2.5272713
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.17747161
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.22444445
                float drive:angular:physics:targetPosition = -144.80199
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0841_swing_double/Articulation/base>
                rel physics:body1 = </db0841_swing_double/Articulation/leaf_a>
                point3f physics:localPos0 = (-0.8145, -0.029, 0)
                point3f physics:localPos1 = (0.003, -0.029, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:angular:armature = 0.02
                custom float physxJointAxis:angular:dynamicFrictionEffort = 1.5653292
                custom float physxJointAxis:angular:staticFrictionEffort = 1.5653292
                custom float physxJointAxis:angular:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "leaf_a_exit_device_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.01
                custom float doorbench:damping_si = 0.5
                custom float doorbench:friction_effort = 0.3
                custom float doorbench:initial = 0
                custom string doorbench:label = "Crossbar (+ = pushed in)"
                custom float doorbench:legacy_friction_coeff = 0.014946696
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "operator"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "leaf_a_exit_device_hinge"
                custom float doorbench:stiffness_si = 12
                custom float doorbench:target_si = -0.33333334
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.008726646
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.20943952
                float drive:angular:physics:targetPosition = -19.098593
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0841_swing_double/Articulation/leaf_a>
                rel physics:body1 = </db0841_swing_double/Articulation/leaf_a_exit_device>
                point3f physics:localPos0 = (0.3945625, 0.022, 1.016)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
