                custom string doorbench:notes = "counterbalance spring ~50% of weight counterbalance ~50% of 32 kg"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 3.404088
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 12.915954
                float drive:linear:physics:targetPosition = 12.033334
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0313_rollup/curtain>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 3.61
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 22.03104
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
