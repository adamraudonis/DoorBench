#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0035_swing_single" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_deadbolt_slide", "driver": "leaf_deadbolt_thumbturn_hinge", "coeff": [0.0, 0.01617010440539852, 0, 0, 0], "label": "deadbolt = throw/travel * thumbturn"}]'
        custom string doorbench:meta = '{"door_id": "db0035_swing_single", "family": "swing_single", "task": "unlock_open_traverse", "wall_y": 0.039999999999999994, "u": 1.0, "v": -1.0, "hinge_x": -0.5365, "leaf_edge_x_local": 1.0699999999999998, "handle_height": 1.016, "primary_joint": "leaf_hinge", "operator_joint": null, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": 0.4305, "handle_cam_target": [0.4434999999999999, -0.0725, 1.016], "handle_cam_pos": [0.6234999999999999, -0.8725, 1.296]}'
