#usda 1.0
(
    defaultPrim = "db0672_blast"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0672_blast"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "bolt_0_slide", "driver": "dog_0_hinge", "coeff": [0, 0.040106951871657845, 0, 0, 0], "gearing": -0.040106951871657845, "offset": -0.0, "label": "bolt = lever * throw/(pi/2)", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}, {"type": "mimic", "driven": "bolt_1_slide", "driver": "dog_1_hinge", "coeff": [0, 0.040106951871657845, 0, 0, 0], "gearing": -0.040106951871657845, "offset": -0.0, "label": "bolt = lever * throw/(pi/2)", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0672_blast"
    custom string doorbench:meta = '{"door_id": "db0672_blast", "family": "blast", "task": "unlock_open_traverse", "wall_y": 0.08, "operator_joint": "dog_0_hinge", "u": -1.0, "v": -1.0, "primary_joint": "leaf_hinge", "handle_height": 1.0, "mass_reconciled_kg": 1152.4432432896276, "scene_extent": 2.0524999999999998, "cam_target_z": 1.035, "cam_target_x": 0.0, "handle_cam_x": -1.0999999999999999, "handle_cam_target": [-0.2244999999999998, -0.12, 0.55], "handle_cam_pos": [-0.04449999999999982, -0.92, 0.8300000000000001], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0672_blast/Articulation/Joints/leaf_hinge", "dog_0_hinge": "/db0672_blast/Articulation/Joints/dog_0_hinge", "bolt_0_slide": "/db0672_blast/Articulation/Joints/bolt_0_slide", "dog_1_hinge": "/db0672_blast/Articulation/Joints/dog_1_hinge", "bolt_1_slide": "/db0672_blast/Articulation/Joints/bolt_1_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0672_blast/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
