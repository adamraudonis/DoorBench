    <doorbench:spring stiffness="0.6" springref="-0.5" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_latch_bar_hinge" type="revolute">
    <origin xyz="0.867 0.005 1.004" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bar"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.6" effort="2000" velocity="10"/>
    <dynamics damping="0.01" friction="0.01"/>
    <mimic joint="leaf_thumb_hinge" multiplier="2" offset="0"/>
  </joint>
  <joint name="leaf_aux_bolt_slide" type="prismatic">
    <origin xyz="1.067 0.005 1.164" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_aux_bolt"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.001" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="1"/>
    <doorbench:note text="no inside access: bolt fixed"/>
  </joint>
  <material name="mat_floor">
    <color rgba="0.55 0.53 0.5 1"/>
  </material>
  <material name="mat_frame">
    <color rgba="0.7 0.58 0.42 1"/>
  </material>
  <material name="mat_hinge">
    <color rgba="0.45 0.3 0.22 1"/>
  </material>
  <material name="mat_leaf">
    <color rgba="0.56 0.475 0.4 1"/>
  </material>
  <material name="mat_leaf_panel">
    <color rgba="0.515 0.437 0.368 1"/>
  </material>
  <material name="mat_op_brass">
    <color rgba="0.85 0.66 0.3 1"/>
  </material>
  <material name="mat_op_wrought_iron">
    <color rgba="0.08 0.08 0.09 1"/>
  </material>
  <material name="mat_threshold">
    <color rgba="0.8 0.81 0.83 1"/>
  </material>
  <material name="mat_wall">
    <color rgba="0.78 0.76 0.7 1"/>
  </material>
</robot>
