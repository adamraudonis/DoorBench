                rel physics:body1 = </db0384_ship_watertight/Articulation/leaf>
                point3f physics:localPos0 = (-0.36, -0.026, 0.15)
                point3f physics:localPos1 = (-0.03, -0.026, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
