  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="0.914 0.029 0.914" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.0127" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="300" springref="-0.008333" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_handle_hinge" multiplier="0.015679" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
  <joint name="leaf_deadbolt_slide" type="prismatic">
    <origin xyz="0.914 0.029 1.054" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_deadbolt"/>
    <axis xyz="-1 0 0"/>
    <doorbench:zero_offset value="0.0254" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.0254" upper="0" effort="5000" velocity="10"/>
    <dynamics damping="5" friction="1.5"/>
    <mimic joint="leaf_deadbolt_thumbturn_hinge" multiplier="0.01617" offset="0"/>
  </joint>
  <joint name="leaf_deadbolt_thumbturn_hinge" type="revolute">
    <origin xyz="0.849 0.007 1.054" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_deadbolt_thumbturn"/>
    <axis xyz="0 1 0"/>
    <doorbench:zero_offset value="1.5708" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-1.5708" upper="0" effort="2000" velocity="10"/>
    <dynamics damping="0.05" friction="0.35"/>
  </joint>
