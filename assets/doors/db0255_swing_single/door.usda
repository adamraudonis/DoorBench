{
    custom string doorbench:couplings = "[{\"driven\": \"leaf_deadbolt_slide\", \"driver\": \"leaf_deadbolt_thumbturn_hinge\", \"driven_type\": \"slide\", \"driver_type\": \"hinge\", \"mode\": \"emulated\", \"coeff\": [0.0, 0.01617010440539852], \"gearing\": -0.01617010440539852, \"offset\": 3.469446951953614e-18, \"label\": \"deadbolt = throw/travel * thumbturn\", \"coeff_usd\": [-3.469446951953614e-18, 0.01617010440539852], \"driven_zero_offset\": 0.0254, \"driver_zero_offset\": 1.5708, \"driven_inertia\": 0.18836, \"reflected_inertia\": 4.92509179980532e-05, \"driven_gravity_bias\": 0.0, \"driven_stiffness\": 0.0, \"driven_damping\": 5.0, \"driven_target\": 0.0, \"driven_friction\": 1.5, \"driven_range\": [-0.0254, 0.0], \"friction_vel_eps\": 0.001, \"reason\": \"PhysX articulation mimic joints support rotational axes only: a mimic on a prismatic axis is dropped\", \"note\": \"PhysX drops mimics on prismatic axes: emulate bilaterally (track q_driven = c0 + c1*q_driver, apply c1 * tau_driven_ext on the driver and add reflected_inertia to the driver's armature)\", \"chain_order\": 0, \"type\": \"coupling_emulated\", \"driven_path\": \"/db0255_swing_single/Articulation/Joints/leaf_deadbolt_slide\", \"driver_path\": \"/db0255_swing_single/Articulation/Joints/leaf_deadbolt_thumbturn_hinge\"}, {\"type\": \"loop_closure_point\", \"body1\": \"closer_arm_fore\", \"body2\": \"world\", \"anchor\": [0.26, 0, 0], \"label\": \"Closer forearm pinned to frame shoe\", \"note\": \"not exported to USD (PhysX articulations are trees); closer arms are visual\"}, {\"type\": \"one_sided_tendon\", \"terms\": [[\"leaf_latch_bolt_slide\", 1.0], [\"leaf_handle_hinge\", -0.015679012345679012]], \"range\": [0.0, 10.0], \"label\": \"bolt_q >= scale*handle_q (one-sided)\", \"note\": \"bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)\"}]"
    custom string doorbench:door_id = "db0255_swing_single"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_deadbolt"], ["leaf", "leaf_deadbolt_thumbturn"], ["leaf", "leaf_handle"], ["leaf", "leaf_latch_bolt"], ["leaf_deadbolt", "leaf_deadbolt_thumbturn"]]'
    custom string doorbench:meta = "{\"door_id\": \"db0255_swing_single\", \"family\": \"swing_single\", \"task\": \"hold_and_pass\", \"wall_y\": 0.028500000000000004, \"clearance_allow\": [[\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"u\": 1.0, \"v\": -1.0, \"hinge_x\": -0.4605, \"leaf_edge_x_local\": 0.917, \"handle_height\": 0.914, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": \"leaf_handle_hinge\", \"mass_reconciled_kg\": 43.4984765262442, \"scene_extent\": 2.03375, \"cam_target_z\": 1.0225, \"cam_target_x\": 0.0, \"handle_cam_x\": 0.35350000000000004, \"handle_cam_target\": [0.38649999999999995, -0.06849999999999999, 0.914], \"handle_cam_pos\": [0.5665, -0.8685, 1.194], \"operator_joints\": [\"leaf_handle_hinge\"], \"operator_coupling\": \"coupled\", \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0255_swing_single/Articulation/Joints/leaf_hinge\", \"leaf_handle_hinge\": \"/db0255_swing_single/Articulation/Joints/leaf_handle_hinge\", \"leaf_latch_bolt_slide\": \"/db0255_swing_single/Articulation/Joints/leaf_latch_bolt_slide\", \"leaf_deadbolt_slide\": \"/db0255_swing_single/Articulation/Joints/leaf_deadbolt_slide\", \"leaf_deadbolt_thumbturn_hinge\": \"/db0255_swing_single/Articulation/Joints/leaf_deadbolt_thumbturn_hinge\", \"closer_pinion\": \"/db0255_swing_single/Articulation/Joints/closer_pinion\", \"closer_elbow\": \"/db0255_swing_single/Articulation/Joints/closer_elbow\"}, \"self_collisions\": true, \"filtered_pairs\": [[\"leaf\", \"leaf_deadbolt\"], [\"leaf\", \"leaf_deadbolt_thumbturn\"], [\"leaf\", \"leaf_handle\"], [\"leaf\", \"leaf_latch_bolt\"], [\"leaf_deadbolt\", \"leaf_deadbolt_thumbturn\"]], \"n_filtered_