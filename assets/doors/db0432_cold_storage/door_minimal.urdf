  <joint name="leaf_rise" type="prismatic">
    <origin xyz="-0.62 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf_riser"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.0264" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="0"/>
    <mimic joint="leaf_hinge" multiplier="0.007639" offset="0"/>
  </joint>
  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.003 0.057 0" rpy="0 0 0"/>
    <parent link="leaf_riser"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.919862" effort="2000" velocity="10"/>
    <dynamics damping="12.792177" friction="6.752638"/>
    <doorbench:spring stiffness="21.358593" springref="-1.732324" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="63" damping_opening="12" backcheck_angle="1.22" backcheck_damping="60"/>
    <doorbench:note text="rising hinge: gravity closing torque ~ m*g*0.0076 N*m/rad"/>
  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="1.155 -0.057 1" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_handle"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.5" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.07"/>
    <doorbench:spring stiffness="2.5" springref="-0.48" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="1.22 -0.057 1" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.006" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="3000" springref="-0.004" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_handle_hinge" multiplier="0.012766" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
