)

def Xform "db0309_gate_sliding"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0309_gate_sliding"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = "[]"
    custom string doorbench:meta = '{"door_id": "db0309_gate_sliding", "family": "gate_sliding", "task": "open_and_traverse", "wall_y": 0.0, "sliding_track_supports": [{"joint": "leaf_slide", "body": "leaf", "rail": "gate_rail", "nominal_range": [0.0, 4.8], "leaf_width_m": 4.8, "rollers": [], "end_stops": [], "floor_guides_required": false, "floor_guides": []}], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "mass_reconciled_kg": 312.43999999999994, "scene_extent": 4.137499999999999, "cam_target_z": 0.775, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [2.31, -0.1325, 1.0], "handle_cam_pos": [2.56, -1.2325000000000002, 1.35], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0309_gate_sliding/Articulation/Joints/leaf_slide"}, "self_collisions": true, "filtered_pairs": [], "n_filtered_pairs": 0, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
