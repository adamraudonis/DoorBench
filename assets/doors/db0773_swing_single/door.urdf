    <limit lower="0" upper="1.832596" effort="2000" velocity="10"/>
    <dynamics damping="12.25611" friction="5.142686"/>
    <doorbench:spring stiffness="11.911156" springref="-1.783202" note="tau = -stiffness*(q - springref); not native URDF"/>
