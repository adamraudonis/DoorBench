#usda 1.0
(
    defaultPrim = "db0779_revolving"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0779_revolving"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0779_revolving"
    custom string doorbench:meta = '{"door_id": "db0779_revolving", "family": "revolving", "task": "push_through", "wall_y": 0.0, "primary_joint": "rotor_hinge", "operator_joint": null, "handle_height": 1.0, "drum_diameter": 2.0, "mass_reconciled_kg": 54.799499999999995, "scene_extent": 2.3255, "cam_target_z": 1.217, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.55, -1.1, 1.35], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"rotor_hinge": "/db0779_revolving/Articulation/Joints/rotor_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0779_revolving/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0779_revolving/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "mat_frame"
        {
            token outputs:surface.connect = </db0779_revolving/Looks/mat_frame/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "mat_drum_glass"
        {
            token outputs:surface.connect = </db0779_revolving/Looks/mat_drum_glass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.92, 0.95)
                float inputs:metallic = 0
                float inputs:opacity = 0.25
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "mat_floor_ring"
        {
            token outputs:surface.connect = </db0779_revolving/Looks/mat_floor_ring/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
