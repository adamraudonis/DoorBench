            float3 physics:diagonalInertia = (0.0000020199545, 0.00015639307, 0.00015639307)
            float physics:mass = 0.113640204
            quatf physics:principalAxes = (7.850462e-17, -7.850462e-17, 0.70710677, 0.70710677)
            custom bool physxRigidBody:enableCCD = 1
            custom int physxRigidBody:solverPositionIterationCount = 16
            custom int physxRigidBody:solverVelocityIterationCount = 4
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.35, 0, 2.451)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "hatch_bolt_geom" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Bolt"
                custom string doorbench:semantic = "lock"
                double height = 0.12
                rel material:binding = </World/db0598_hatch_ceiling/Looks/mat_bolt>
                rel material:binding:physics = </World/db0598_hatch_ceiling/Looks/PhysMat_mat_bolt> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double radius = 0.006
                quatf xformOp:orient = (0.70710677, 0, 0.70710677, 0)
                double3 xformOp:translate = (0.04, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "hatch_bolt_grip"
            {
                custom string doorbench:site_role = "grip"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, 0.02)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "hatch_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:initial = 0
                custom string doorbench:label = "Hatch (0 = closed, + = lifted)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.011208329
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0598_hatch_ceiling/hatch>
                point3f physics:localPos0 = (0, 0.605, 2.44)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 4.1379156
            }

            def PhysicsPrismaticJoint "hatch_bolt_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            )
            {
                custom float doorbench:initial = 0.04
                custom string doorbench:label = "Slide bolt (0 = engaged)"
                custom string doorbench:role = "lock"
                custom float doorbench:zero_offset = 0.04
                float drive:linear:physics:damping = 1
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </World/db0598_hatch_ceiling/hatch>
                rel physics:body1 = </World/db0598_hatch_ceiling/hatch_bolt>
                point3f physics:localPos0 = (0.35, -0.605, 0.011)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = -0.04
                float physics:upperLimit = 0
                custom float physxJoint:armature = 0.1
                custom float physxJoint:jointFriction = 1
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

