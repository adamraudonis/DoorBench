    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0434_gate_swing/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:rotX"]
            )
            {
                custom float doorbench:damping_closing = 0
                custom float doorbench:damping_opening = 0
                custom float doorbench:damping_si = 1.4214313
                custom float doorbench:friction_effort = 8.455014
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom string doorbench:source_joint = "leaf_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.024808655
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0434_gate_swing/Articulation/base>
                rel physics:body1 = </db0434_gate_swing/Articulation/leaf>
                point3f physics:localPos0 = (-0.753, 0.0195, 0)
                point3f physics:localPos1 = (0.003, 0.0195, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.007619262
                custom float physxJointAxis:rotX:armature = 0.02
                custom float physxJointAxis:rotX:dynamicFrictionEffort = 8.455014
                custom float physxJointAxis:rotX:staticFrictionEffort = 8.455014
                custom float physxJointAxis:rotX:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "leaf_fork_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:rotX"]
            )
            {
                custom float doorbench:damping_si = 0.02
                custom float doorbench:friction_effort = 0.02
                custom float doorbench:initial = 0
                custom string doorbench:label = "Fork latch (0 = dropped over the post, + = lifted; lift to open AND to close)"
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "operator"
                custom string doorbench:source_joint = "leaf_fork_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.00034906584
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0434_gate_swing/Articulation/leaf>
                rel physics:body1 = </db0434_gate_swing/Articulation/leaf_fork>
                point3f physics:localPos0 = (1.363, 0, 1)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 68.75494
                custom float physxJoint:armature = 0.01
                custom float physxJoint:jointFriction = 0.008080031
                custom float physxJointAxis:rotX:armature = 0.01
                custom float physxJointAxis:rotX:dynamicFrictionEffort = 0.02
                custom float physxJointAxis:rotX:staticFrictionEffort = 0.02
                custom float physxJointAxis:rotX:viscousFrictionCoefficient = 0
            }
        }

