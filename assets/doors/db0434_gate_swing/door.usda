#usda 1.0
(
    defaultPrim = "db0434_gate_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0434_gate_swing"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0434_gate_swing"
    custom string doorbench:meta = '{"door_id": "db0434_gate_swing", "family": "gate_swing", "task": "open_only", "wall_y": 0.0, "clearance_allow": [["leaf_fork_eye", "leaf_fork_pin", "pivot pin through the fork eye"], ["leaf_fork_arm", "leaf_fork_pin", "pivot pin through the arm"]], "u": 1.0, "v": 1.0, "hinge_x": -0.756, "leaf_edge_x_local": 1.503, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": "leaf_fork_hinge", "mass_reconciled_kg": 64.84923700770314, "scene_extent": 1.6400000000000001, "cam_target_z": 0.76, "cam_target_x": 0.0, "handle_cam_x": 0.6439999999999999, "handle_cam_target": [0.7360000000000001, -0.0245, 1.105], "handle_cam_pos": [0.9160000000000001, -0.8245, 1.385], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0434_gate_swing/Articulation/Joints/leaf_hinge", "leaf_fork_hinge": "/db0434_gate_swing/Articulation/Joints/leaf_fork_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0434_gate_swing/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0434_gate_swing/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
