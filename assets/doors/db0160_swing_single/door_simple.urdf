  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.483 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="12.318237" friction="0.273419"/>
    <doorbench:spring stiffness="15.508058" springref="-1.827437" note="tau = -stiffness*(q - springref); not native URDF"/>
