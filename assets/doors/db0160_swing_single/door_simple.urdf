    <limit lower="0" upper="0.004" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="0"/>
    <doorbench:spring stiffness="1500" springref="-0.004" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
