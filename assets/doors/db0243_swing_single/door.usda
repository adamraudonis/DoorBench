#usda 1.0
(
    defaultPrim = "db0243_swing_single"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0243_swing_single"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_latch_bar_hinge", "driver": "leaf_thumb_hinge", "coeff": [0, 2.0, 0, 0, 0], "gearing": -2.0, "offset": -0.0, "label": "bar lift = thumb press", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0243_swing_single"
    custom string doorbench:meta = '{"door_id": "db0243_swing_single", "family": "swing_single", "task": "open_only", "wall_y": -0.108, "u": -1.0, "v": 1.0, "hinge_x": 0.4105, "leaf_edge_x_local": -0.816, "handle_height": 1.05, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 52.71909279999999, "scene_extent": 2.03375, "cam_target_z": 1.0225, "cam_target_x": 0.0, "handle_cam_x": -0.3025, "handle_cam_target": [-0.3255, -0.057, 1.0], "handle_cam_pos": [-0.14550000000000002, -0.8570000000000001, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0243_swing_single/Articulation/Joints/leaf_hinge", "leaf_thumb_hinge": "/db0243_swing_single/Articulation/Joints/leaf_thumb_hinge", "leaf_latch_bar_hinge": "/db0243_swing_single/Articulation/Joints/leaf_latch_bar_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0243_swing_single/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
