    <limit lower="0" upper="2.08" effort="5000" velocity="10"/>
    <dynamics damping="6.004164" friction="31.41395"/>
    <doorbench:spring stiffness="96.313627" springref="6.933333" note="tau = -stiffness*(q - springref); not native URDF"/>
