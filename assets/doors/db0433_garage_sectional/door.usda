                uniform token physics:axis = "X"
                rel physics:body0 = </World/db0433_garage_sectional/door>
                rel physics:body1 = </World/db0433_garage_sectional/garage_slide_lock>
                point3f physics:localPos0 = (-1.22, 0.0325, 0.80875)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -0.05
                float physics:upperLimit = 0
                custom float physxJoint:armature = 0.1
                custom float physxJoint:jointFriction = 1
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
