            def Capsule "garage_slide_lock_knob" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Bolt handle"
                custom string doorbench:semantic = "operator"
                double height = 0.019999999999999997
                rel material:binding = </World/db0433_garage_sectional/Looks/mat_slidelock>
                rel material:binding:physics = </World/db0433_garage_sectional/Looks/PhysMat_mat_slidelock> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double radius = 0.005
                quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
                double3 xformOp:translate = (0.08499999999999999, 0.015, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Sphere "garage_slide_lock_knob_end" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom string doorbench:label = "Handle knob"
                custom string doorbench:semantic = "operator"
