                rel physics:body0 = </db0601_swing_single/Articulation/leaf>
                rel physics:body1 = </db0601_swing_single/Articulation/leaf_keypad_key_1>
                point3f physics:localPos0 = (-0.828, 0.042, 1.1135)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.0015
