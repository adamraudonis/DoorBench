ch_bolt_slide": "/db0601_swing_single/Articulation/Joints/leaf_latch_bolt_slide", "leaf_deadbolt_slide": "/db0601_swing_single/Articulation/Joints/leaf_deadbolt_slide", "leaf_deadbolt_thumbturn_hinge": "/db0601_swing_single/Articulation/Joints/leaf_deadbolt_thumbturn_hinge"}}'

