            def PhysicsPrismaticJoint "leaf_keypad_key_1_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 0.5
                custom float doorbench:friction_effort = 0.05
