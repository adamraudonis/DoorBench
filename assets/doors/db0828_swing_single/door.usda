def Xform "db0828_swing_single"
{
    custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.015679012345679012]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0828_swing_single"
    custom string doorbench:meta = '{"door_id": "db0828_swing_single", "family": "swing_single", "task": "open_and_traverse", "wall_y": 0.0625, "u": -1.0, "v": -1.0, "hinge_x": 0.41, "leaf_edge_x_local": -0.816, "handle_height": 0.965, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "mass_reconciled_kg": 24.724331960133743, "scene_extent": 2.03375, "cam_target_z": 1.0225, "cam_target_x": 0.0, "handle_cam_x": -0.303, "handle_cam_target": [-0.25, -0.07250000000000001, 0.965], "handle_cam_pos": [-0.07, -0.8725, 1.245], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0828_swing_single/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0828_swing_single/Articulation/Joints/leaf_handle_hinge", "leaf_latch_bolt_slide": "/db0828_swing_single/Articulation/Joints/leaf_latch_bolt_slide"}}'

    def Scope "Looks"
