#usda 1.0
(
    defaultPrim = "db0170_saloon"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0170_saloon"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0170_saloon"
    custom string doorbench:meta = '{"door_id": "db0170_saloon", "family": "saloon", "task": "push_through", "wall_y": 0.0, "primary_joint": "leaf_a_hinge", "secondary_joint": "leaf_b_hinge", "both_ways": true, "mass_reconciled_kg": 9.39268, "scene_extent": 2.0435, "cam_target_z": 1.029, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 1.0], "handle_cam_pos": [0.48, -0.8, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_a_hinge": "/db0170_saloon/Articulation/Joints/leaf_a_hinge", "leaf_b_hinge": "/db0170_saloon/Articulation/Joints/leaf_b_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0170_saloon/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0170_saloon/Looks/mat_wall/Shader.outputs:surface>

