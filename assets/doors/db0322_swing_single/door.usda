{
    custom string doorbench:couplings = '[{"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame shoe", "note": "not exported to USD (PhysX articulations are trees); closer arms are visual"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.023456790123456788], ["leaf_handle_out_hinge", -0.023456790123456788]], "range": [0.0, 10.0], "label": "bolt_q >= scale*(handle_q + outside_trim_q) (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0322_swing_single"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_handle"], ["leaf", "leaf_handle_out"], ["leaf", "leaf_keypad_key_1"], ["leaf", "leaf_keypad_key_2"], ["leaf", "leaf_keypad_key_3"], ["leaf", "leaf_keypad_key_4"], ["leaf", "leaf_keypad_key_5"], ["leaf", "leaf_latch_bolt"]]'
    custom string doorbench:meta = "{\"door_id\": \"db0322_swing_single\", \"family\": \"swing_single\", \"task\": \"unlock_open_traverse\", \"wall_y\": 0.028500000000000004, \"clearance_allow\": [[\"leaf_keypad_body\", \"leaf_keypad_key_*\", \"buttons travel into the keypad body\"], [\"leaf_handle_out_lever_*\", \"leaf_handle_spindle\", \"the clutched outside lever rides on the spindle running through its hub\"], [\"leaf_handle_out_knob_*\", \"leaf_handle_spindle\", \"the clutched outside knob rides on the spindle running through its hub\"], [\"leaf_handle_out_hub_col_*\", \"leaf_handle_spindle\", \"the clutched outside hub is bored for the spindle\"], [\"leaf_handle_out_rose_*\", \"leaf_handle_spindle\", \"the spindle passes through the rose\"], [\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"stops\": [{\"geom\": \"door_stop_bumper\", \"joint\": \"leaf_hinge\", \"mount\": \"floor\", \"max_open_deg\": 90, \"q\": 1.5708, \"strike\": [-0.4505, -0.8059, 0.075]}], \"u\": 1.0, \"v\": -1.0, \"hinge_x\": -0.4605, \"leaf_edge_x_local\": 0.917, \"handle_height\": 1.04, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": \"leaf_handle_hinge\", \"keypad\": {\"lock_model\": \"keypad_mechanical\", \"keypad_model\": \"keypad_mechanical\", \"code\": \"1234\", \"code_kind\": \"set\", \"engaged\": true, \"face\": 1.0, \"center\": [0.847, 0.022, 1.18], \"pad_size_m\": [0.058, 0.19, 0.032], \"layout\": \"column_5\", \"buttons\": [{\"label\": \"1\", \"body\": \"leaf_keypad_key_1\", \"joint\": \"leaf_keypad_key_1_slide\", \"site\": \"leaf_keypad_key_1_press\", \"pos\": [0.853, 0.054, 1.232]}, {\"label\": \"2\", \"body\": \"leaf_keypad_key_2\", \"joint\": \"leaf_keypad_key_2_slide\", \"site\": \"leaf_keypad_key_2_press\", \"pos\": [0.841, 0.054, 1.206]}, {\"label\": \"3\", \"body\": \"leaf_keypad_key_3\", \"joint\": \"leaf_keypad_key_3_slide\", \"site\": \"leaf_keypad_key_3_press\", \"pos\": [0.853, 0.054, 1.18]}, {\"label\": \"4\", \"body\": \"leaf_keypad_key_4\", \"joint\": \"leaf_keypad_key_4_slide\", \"site\": \"leaf_keypad_key_4_press\", \"pos\": [0.841, 0.054, 1.154]}, {\"label\": \"5\", \"body\": \"leaf_keypad_key_5\", \"joint\": \"leaf_keypad_key_5_slide\", \"site\": \"leaf_keypad_key_5_press\", \"pos\": [0.853, 0.054, 1.128]}], \"travel_m\": 0.004, \"press_force_N\": 12.0, \"preload_force_N\": 6.0, \"press_depth_frac\": 0.6, \"release_depth_frac\": 0.3, \"debounce_s\": 0.02, \"code_timeout_s\": null, \"lockout_s\": null, \"max_attempts\": null, \"release\": \"clutch\", \"clutch_joint\": \"leaf_handle_out_hinge\", \"bolt_joint\": null, \"clutch_locked_rad\": 0.06, \"clutch_open_rad\": 0.87, \"bolt_throw_m\": null, \"motor_force_N\": null, \"source\": \"Kaba Simplex 1000: buttons pressed in any order (each once), then the lever; turning the lever clears the chamber\", \"note\": \"mechanical combination chamber: press the buttons of the code in any order, then turn the outside lever; turning it on a wrong set clears the chamber and counts as a wrong attempt.\"}, \"mass_reconciled_kg\": 56.033641109574766, \"scene_extent\": 2.1102499999999997, \"cam_target_z\": 1.0735, \"cam_target_x\": 0.0, \"handle_cam_x\": 0.35350000000000004, \"handle_cam_target\": [0.29689999999999994, -0.077, 1.04], \"handle_cam_pos\": [0.47689999999999994, -0.877, 1.32], \"operator_joints\": [\"leaf_handle_hinge\"], \"operator_coupling\": \"coupled\", \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0322_swing_single/Articulation/Joints/leaf_hinge\", \"leaf_handle_hinge\": \"/db0322_swing_single/Articulation/Joints/leaf_handle_hinge\", \"leaf_keypad_key_1_slide\": \"/db0322_swing_single/Articulation/Joints/leaf_keypad_key_1_slide\", \"le