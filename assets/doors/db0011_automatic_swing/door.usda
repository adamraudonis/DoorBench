#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0011_automatic_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_deadbolt_slide", "driver": "leaf_deadbolt_thumbturn_hinge", "coeff": [0.0, 0.01617010440539852, 0, 0, 0], "label": "deadbolt = throw/travel * thumbturn"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_exit_device_slide", -1.357142857142857]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)"}]'
        custom string doorbench:meta = '{"door_id": "db0011_automatic_swing", "family": "automatic_swing", "task": "peek", "wall_y": -0.12399999999999999, "u": -1.0, "v": 1.0, "hinge_x": 0.411, "leaf_edge_x_local": -0.816, "handle_height": 1.067, "primary_joint": "leaf_hinge", "operator_joint": null, "actuators": [{"name": "swing_operator", "joint": "leaf_hinge", "kind": "position", "kp": 150.0, "kv": 40.0, "forcerange": [-60, 60], "ctrlrange": [0.0, 1.6]}], "mass_reconciled_kg": 63.44628220052559, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": -0.302, "handle_cam_target": [-0.315, 0.066, 1.067], "handle_cam_pos": [-0.135, -0.734, 1.347]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
