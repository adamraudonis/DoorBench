#usda 1.0
(
    defaultPrim = "db0011_automatic_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0011_automatic_swing"
{
    custom string doorbench:couplings = "[{\"driven\": \"leaf_deadbolt_slide\", \"driver\": \"leaf_deadbolt_thumbturn_hinge\", \"driven_type\": \"slide\", \"driver_type\": \"hinge\", \"mode\": \"emulated\", \"coeff\": [0.0, 0.01617010440539852], \"gearing\": -0.01617010440539852, \"offset\": 3.469446951953614e-18, \"label\": \"deadbolt = throw/travel * thumbturn\", \"coeff_usd\": [-3.469446951953614e-18, 0.01617010440539852], \"driven_zero_offset\": 0.0254, \"driver_zero_offset\": 1.5708, \"driven_inertia\": 0.18836, \"reflected_inertia\": 4.92509179980532e-05, \"driven_gravity_bias\": 0.0, \"driven_stiffness\": 0.0, \"driven_damping\": 5.0, \"driven_target\": 0.0, \"driven_friction\": 1.5, \"driven_range\": [-0.0254, 0.0], \"friction_vel_eps\": 0.001, \"reason\": \"PhysX articulation mimic joints support rotational axes only: a mimic on a prismatic axis is dropped\", \"note\": \"PhysX drops mimics on prismatic axes: emulate bilaterally (track q_driven = c0 + c1*q_driver, apply c1 * tau_driven_ext on the driver and add reflected_inertia to the driver's armature)\", \"chain_order\": 0, \"type\": \"coupling_emulated\", \"driven_path\": \"/db0011_automatic_swing/Articulation/Joints/leaf_deadbolt_slide\", \"driver_path\": \"/db0011_automatic_swing/Articulation/Joints/leaf_deadbolt_thumbturn_hinge\"}, {\"type\": \"one_sided_tendon\", \"terms\": [[\"leaf_latch_bolt_slide\", 1.0], [\"leaf_exit_device_slide\", -1.357142857142857]], \"range\": [0.0, 10.0], \"label\": \"bolt_q >= scale*handle_q (one-sided)\", \"note\": \"bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)\"}]"
    custom string doorbench:door_id = "db0011_automatic_swing"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_deadbolt"], ["leaf", "leaf_deadbolt_thumbturn"], ["leaf", "leaf_exit_device"], ["leaf", "leaf_latch_bolt"], ["leaf_deadbolt", "leaf_deadbolt_thumbturn"]]'
    custom string doorbench:meta = '{"door_id": "db0011_automatic_swing", "family": "automatic_swing", "task": "peek", "wall_y": -0.13699999999999998, "u": -1.0, "v": 1.0, "hinge_x": 0.411, "leaf_edge_x_local": -0.816, "handle_height": 1.067, "primary_joint": "leaf_hinge", "operator_joint": null, "actuators": [{"name": "swing_operator", "joint": "leaf_hinge", "kind": "position", "kp": 150.0, "kv": 40.0, "forcerange": [-60, 60], "ctrlrange": [0.0, 1.6], "in_drive": false}], "mass_reconciled_kg": 63.79628220052558, "mass": {"leaf_material_kg": 52.04825999999999, "leaf_hardware_rider_kg": 11.748022200525591, "hardware_modelled_kg": 4.701977799474408, "leaf_bodies": 1, "total_moving_kg": 68.49825999999999}, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": -0.302, "handle_cam_target": [-0.315, 0.066, 1.067], "handle_cam_pos": [-0.135, -0.734, 1.347], "operator_joints": [], "operator_coupling": "coupled", "primary_assembly_kg": 68.49825999999999, "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0011_automatic_swing/Articulation/Joints/leaf_hinge", "leaf_exit_device_slide": "/db0011_automatic_swing/Articulation/Joints/leaf_exit_device_slide", "leaf_latch_bolt_slide": "/db0011_automatic_swing/Articulation/Joints/leaf_latch_bolt_slide", "leaf_deadbolt_slide": "/db0011_automatic_swing/Articulation/Joints/leaf_deadbolt_slide", "leaf_deadbolt_thumbturn_hinge": "/db0011_automatic_swing/Articulation/Joints/leaf_deadbolt_thumbturn_hinge"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_deadbolt"], ["leaf", "leaf_deadbolt_thumbturn"], ["leaf", "leaf_exit_device"], ["leaf", "leaf_latch_bolt"], ["leaf_deadbolt", "leaf_deadbolt_thumbturn"]], "n_filtered_pairs": 5, "env_release": [], "couplings_emulated": [{"driven": "leaf_deadbolt_slide", "driver": "leaf_deadbolt_thumbturn_hinge", "driven_type": "slide", "driver_type": "hinge", "mode": "emulated", "coeff": [0.0, 0.01617010440539852], "gearing": -0.01617010440539852, "offset": 3.469446951953614e-18, "label": "deadbolt = throw/travel * thumbturn", "coeff_usd": [-3.469446951953614e-18, 0.01617010440539852], "driven_zero_offset": 0.0254, "driver_zero_offset": 1.5708, "driven_inertia": 0.18836, "reflected_inertia": 4.92509179980532e-05, "driven_gravity_bias": 0.0, "driven_stiffness": 0.0, "driven_damping": 5.0, "driven_target": 0.0, "driven_friction": 1.5, "driven_range": [-0.0254, 0.0], "friction_vel_eps": 0.001, "reason": "PhysX articulation mimic joints support rotational axes only: a mimic on a prismatic axis is dropped", "note": "q_driven = c0 + c1*q_driver; the driver carries the reaction c1 * tau_driven_ext and the reflected inertia c1^2 * I_driven", "chain_order": 0}], "couplings_servo": [], "coupling_reflected_armature": {"leaf_deadbolt_thumbturn_hinge": 4.92509179980532e-05}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

