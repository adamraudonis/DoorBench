  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.392 0.016 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.832596" effort="2000" velocity="10"/>
    <dynamics damping="15.168374" friction="0.630287"/>
    <doorbench:spring stiffness="15.342537" springref="-1.864099" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="60" damping_opening="15" backcheck_angle="0" backcheck_damping="0"/>
  </joint>
  <joint name="leaf_exit_device_slide" type="prismatic">
    <origin xyz="-0.432775 -0.022 1.067" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_exit_device"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.016" effort="5000" velocity="10"/>
    <dynamics damping="8" friction="0.5"/>
    <doorbench:spring stiffness="1200" springref="-0.015" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="-0.797 -0.016 1.067" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.019" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="800" springref="-0.01" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_exit_device_slide" multiplier="1.357143" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
  <joint name="leaf_deadbolt_slide" type="prismatic">
    <origin xyz="-0.797 -0.016 1.207" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_deadbolt"/>
    <axis xyz="1 0 0"/>
    <doorbench:zero_offset value="0.0254" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.0254" upper="0" effort="5000" velocity="10"/>
    <dynamics damping="5" friction="1.5"/>
    <mimic joint="leaf_deadbolt_thumbturn_hinge" multiplier="0.01617" offset="0"/>
  </joint>
  <joint name="leaf_deadbolt_thumbturn_hinge" type="revolute">
    <origin xyz="-0.727 -0.01 1.207" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_deadbolt_thumbturn"/>
    <axis xyz="0 -1 0"/>
    <doorbench:zero_offset value="1.5708" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-1.5708" upper="0" effort="2000" velocity="10"/>
    <dynamics damping="0.05" friction="0.3"/>
  </joint>
