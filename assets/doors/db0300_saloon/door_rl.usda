    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0300_saloon/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
