        def Material "mat_frame"
        {
            token outputs:surface.connect = </db0511_pivot/Looks/mat_frame/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.48, 0.52)
