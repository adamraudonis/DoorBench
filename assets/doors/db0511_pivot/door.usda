        def Material "mat_hinge"
        {
            token outputs:surface.connect = </db0511_pivot/Looks/mat_hinge/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.66, 0.68)
                float inputs:metallic = 0.9
