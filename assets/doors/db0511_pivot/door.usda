#usda 1.0
(
    defaultPrim = "db0511_pivot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0511_pivot"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0511_pivot"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = "[]"
    custom string doorbench:meta = '{"door_id": "db0511_pivot", "family": "pivot", "task": "traverse_open", "wall_y": -0.1205, "u": -1.0, "v": 1.0, "hinge_x": 0.906, "leaf_edge_x_local": -1.806, "handle_height": 1.05, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 108.48704199999999, "scene_extent": 2.1094999999999997, "cam_target_z": 1.073, "cam_target_x": 0.0, "handle_cam_x": -0.7939999999999999, "handle_cam_target": [-0.7939999999999999, -0.1205, 1.05], "handle_cam_pos": [-0.6139999999999999, -0.9205000000000001, 1.33], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0511_pivot/Articulation/Joints/leaf_hinge"}, "self_collisions": true, "filtered_pairs": [], "n_filtered_pairs": 0, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0511_pivot/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0511_pivot/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
