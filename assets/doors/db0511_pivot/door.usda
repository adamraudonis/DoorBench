#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0511_pivot" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0511_pivot", "family": "pivot", "task": "traverse_open", "wall_y": -0.1075, "u": -1.0, "v": 1.0, "hinge_x": 0.906, "leaf_edge_x_local": -1.806, "handle_height": 1.05, "primary_joint": "leaf_hinge", "operator_joint": null, "scene_extent": 2.1094999999999997, "cam_target_z": 1.073, "cam_target_x": 0.0, "handle_cam_x": -0.7939999999999999, "handle_cam_target": [-0.7939999999999999, -0.1075, 1.05], "handle_cam_pos": [-0.6139999999999999, -0.9075000000000001, 1.33]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0511_pivot/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0511_pivot/Looks/mat_wall/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }

            def Material "mat_leaf"
            {
                token outputs:surface.connect = </World/db0511_pivot/Looks/mat_leaf/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.36, 0.25, 0.18)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.45
                    token outputs:surface
