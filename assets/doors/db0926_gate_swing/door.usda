#usda 1.0
(
    defaultPrim = "db0926_gate_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0926_gate_swing"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_latch_bar_hinge", "driver": "leaf_thumb_hinge", "coeff": [0, 2.0, 0, 0, 0], "gearing": -2.0, "offset": -0.0, "label": "bar lift = thumb press", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0926_gate_swing"
    custom string doorbench:meta = '{"door_id": "db0926_gate_swing", "family": "gate_swing", "task": "open_only", "wall_y": 0.0, "clearance_allow": [["leaf_latch_bar_geom", "leaf_latch_bar_pin", "bar on its pivot pin"]], "u": -1.0, "v": -1.0, "hinge_x": 0.456, "leaf_edge_x_local": -0.903, "handle_height": 0.8, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 8.64268, "scene_extent": 1.5, "cam_target_z": 0.51, "cam_target_x": 0.0, "handle_cam_x": -0.34400000000000003, "handle_cam_target": [-0.36700000000000005, -0.0475, 0.75], "handle_cam_pos": [-0.18700000000000006, -0.8475, 1.03], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0926_gate_swing/Articulation/Joints/leaf_hinge", "leaf_thumb_hinge": "/db0926_gate_swing/Articulation/Joints/leaf_thumb_hinge", "leaf_latch_bar_hinge": "/db0926_gate_swing/Articulation/Joints/leaf_latch_bar_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0926_gate_swing/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0926_gate_swing/Looks/mat_wall/Shader.outputs:surface>

