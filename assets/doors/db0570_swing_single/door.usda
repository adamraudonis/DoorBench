def Xform "db0570_swing_single"
{
    custom string doorbench:couplings = '[{"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame shoe", "note": "not exported to USD (PhysX articulations are trees); closer arms are visual"}, {"type": "weld", "body1": "leaf", "body2": "world", "label": "Delayed egress (15 s after 3 s push) (env releases on REX / badge / timer)", "active": true, "joint": "/db0570_swing_single/Articulation/Joints/leaf_maglock", "holding_force_N": 2670.0, "note": "breakable FixedJoint (excludeFromArticulation); the environment clears physics:jointEnabled on release"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_exit_device_slide", -1.357142857142857]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0570_swing_single"
    custom string doorbench:env_release = '[{"name": "leaf_maglock", "body": "leaf", "other": "world", "label": "Delayed egress (15 s after 3 s push) (env releases on REX / badge / timer)", "active": true, "holding_force_N": 2670.0, "release": "env", "release_joint": null, "release_fraction": null, "lock_model": null, "joint": "/db0570_swing_single/Articulation/Joints/leaf_maglock", "joint_name": "leaf_maglock", "body_prim": "/db0570_swing_single/Articulation/leaf", "base_prim": "/db0570_swing_single/Articulation/base"}]'
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_exit_device"], ["leaf", "leaf_latch_bolt"]]'
    custom string doorbench:meta = "{\"door_id\": \"db0570_swing_single\", \"family\": \"swing_single\", \"task\": \"unlock_open_traverse\", \"wall_y\": -0.0435, \"breakable_welds\": [{\"name\": \"leaf_maglock\", \"holding_force_N\": 2670.0}], \"clearance_allow\": [[\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"u\": -1.0, \"v\": 1.0, \"hinge_x\": 0.537, \"leaf_edge_x_local\": -1.0699999999999998, \"handle_height\": 1.04, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": \"leaf_exit_device_slide\", \"mass_reconciled_kg\": 58.31753167795408, \"mass\": {\"leaf_material_kg\": 51.86200447999999, \"leaf_hardware_rider_kg\": 6.455527197954087, \"hardware_modelled_kg\": 5.869472802045912, \"leaf_bodies\": 1, \"total_moving_kg\": 64.18700447999998}, \"scene_extent\": 2.03375, \"cam_target_z\": 1.0225, \"cam_target_x\": 0.0, \"handle_cam_x\": -0.42999999999999994, \"handle_cam_target\": [-0.44299999999999984, 0.097, 1.04], \"handle_cam_pos\": [-0.26299999999999985, -0.7030000000000001, 1.32], \"operator_joints\": [\"leaf_exit_device_slide\"], \"operator_coupling\": \"coupled\", \"primary_assembly_kg\": 64.18700447999998, \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0570_swing_single/Articulation/Joints/leaf_hinge\", \"leaf_exit_device_slide\": \"/db0570_swing_single/Articulation/Joints/leaf_exit_device_slide\", \"leaf_latch_bolt_slide\": \"/db0570_swing_single/Articulation/Joints/leaf_latch_bolt_slide\", \"closer_pinion\": \"/db0570_swing_single/Articulation/Joints/closer_pinion\", \"closer_elbow\": \"/db0570_swing_single/Articulation/Joints/closer_elbow\"}, \"self_collisions\": true, \"filtered_pairs\": [[\"leaf\", \"leaf_exit_device\"], [\"leaf\", \"leaf_latch_bolt\"]], \"n_filtered_pairs\": 2, \"env_release\": [{\"name\": \"leaf_maglock\", \"body\": \"leaf\", \"other\": \"world\", \"label\": \"Delayed egress (15 s after 3 s push) (env releases on REX / badge / timer)\", \"active\": true, \"holding_force_N\": 2670.0, \"release\": \"env\", \"release_joint\": null, \"release_fraction\": null, \"lock_model\": null, \"joint\": \"/db0570_swing_single/Articulation/Joints/leaf_maglock\", \"joint_name\": \"leaf_maglock\", \"body_prim\": \"/db0570_swing_single/Articulation/leaf\", \"base_prim\": \"/db0570_swing_single/Articulation/base\"}], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

