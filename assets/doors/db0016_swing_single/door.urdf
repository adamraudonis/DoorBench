    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.745329" effort="2000" velocity="10"/>
    <dynamics damping="12.570702" friction="1.667396"/>
    <doorbench:spring stiffness="17.118706" springref="-2.550426" note="tau = -stiffness*(q - springref); not native URDF"/>
