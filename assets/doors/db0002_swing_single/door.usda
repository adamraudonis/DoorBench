{
    custom string doorbench:couplings = "[{\"driven\": \"leaf_rise\", \"driver\": \"leaf_hinge\", \"driven_type\": \"slide\", \"driver_type\": \"hinge\", \"mode\": \"emulated\", \"coeff\": [0.0, 0.005092958178940651], \"gearing\": -0.005092958178940651, \"offset\": -0.0, \"label\": \"rise = 8 mm per 90 deg (helical hinge)\", \"coeff_usd\": [0.0, 0.005092958178940651], \"driven_zero_offset\": 0.0, \"driver_zero_offset\": 0.0, \"driven_inertia\": 12.501306729600001, \"reflected_inertia\": 0.0003242616818992627, \"driven_gravity_bias\": -122.63781901737602, \"driven_stiffness\": 0.0, \"driven_damping\": 1.0, \"driven_target\": 0.0, \"driven_friction\": 0.0, \"driven_range\": [0.0, 0.0176], \"friction_vel_eps\": 0.001, \"reason\": \"PhysX articulation mimic joints support rotational axes only: a mimic on a prismatic axis is dropped\", \"note\": \"PhysX drops mimics on prismatic axes: emulate bilaterally (track q_driven = c0 + c1*q_driver, apply c1 * tau_driven_ext on the driver and add reflected_inertia to the driver's armature)\", \"chain_order\": 0, \"type\": \"coupling_emulated\", \"driven_path\": \"/db0002_swing_single/Articulation/Joints/leaf_rise\", \"driver_path\": \"/db0002_swing_single/Articulation/Joints/leaf_hinge\"}, {\"type\": \"one_sided_tendon\", \"terms\": [[\"leaf_latch_bolt_slide\", 1.0], [\"leaf_handle_hinge\", -0.015679012345679012]], \"range\": [0.0, 10.0], \"label\": \"bolt_q >= scale*handle_q (one-sided)\", \"note\": \"bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)\"}]"
    custom string doorbench:door_id = "db0002_swing_single"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_handle"], ["leaf", "leaf_latch_bolt"]]'
    custom string doorbench:meta = '{"door_id": "db0002_swing_single", "family": "swing_single", "task": "open_and_traverse", "wall_y": 0.033, "u": 1.0, "v": -1.0, "hinge_x": -0.3845, "leaf_edge_x_local": 0.765, "handle_height": 0.965, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "mass_reconciled_kg": 11.141914659780191, "scene_extent": 2.03375, "cam_target_z": 1.0225, "cam_target_x": 0.0, "handle_cam_x": 0.2775, "handle_cam_target": [0.32050000000000006, -0.064, 0.965], "handle_cam_pos": [0.5005000000000001, -0.8640000000000001, 1.245], "operator_joints": ["leaf_handle_hinge"], "operator_coupling": "coupled", "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_rise": "/db0002_swing_single/Articulation/Joints/leaf_rise", "leaf_hinge": "/db0002_swing_single/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0002_swing_single/Articulation/Joints/leaf_handle_hinge", "leaf_latch_bolt_slide": "/db0002_swing_single/Articulation/Joints/leaf_latch_bolt_slide"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_handle"], ["leaf", "leaf_latch_bolt"]], "n_filtered_pairs": 2, "env_release": [], "couplings_emulated": [{"driven": "leaf_rise", "driver": "leaf_hinge", "driven_type": "slide", "driver_type": "hinge", "mode": "emulated", "coeff": [0.0, 0.005092958178940651], "gearing": -0.005092958178940651, "offset": -0.0, "label": "rise = 8 mm per 90 deg (helical hinge)", "coeff_usd": [0.0, 0.005092958178940651], "driven_zero_offset": 0.0, "driver_zero_offset": 0.0, "driven_inertia": 12.501306729600001, "reflected_inertia": 0.0003242616818992627, "driven_gravity_bias": -122.63781901737602, "driven_stiffness": 0.0, "driven_damping": 1.0, "driven_target": 0.0, "driven_friction": 0.0, "driven_range": [0.0, 0.0176], "friction_vel_eps": 0.001, "reason": "PhysX articulation mimic joints support rotational axes only: a mimic on a prismatic axis is dropped", "note": "q_driven = c0 + c1*q_driver; the driver carries the reaction c1 * tau_driven_ext and the reflected inertia c1^2 * I_driven", "chain_order": 0}], "couplings_servo": [], "coupling_reflected_armature": {"leaf_hinge": 0.0003242616818992627}, "servo_in_drive": {}, "rise_coupling": {"rise_joint": "leaf_rise", "hinge_joint": "leaf_hinge", "coeff_m_per_rad": 0.005092958178940651, "lift_m_per_rad": 0.005092958178940651, "carried_mass_kg": 12.501306729600001, "gravity_torque_Nm": -0.6245892834119885, "label": "rise = 8 mm per 90 deg (helical hinge)", "note": "constant closing torque -m*g*dz/dq of the helical hinge; apply on the hinge when the rise joint is not simulated"}, "max_angular_velocity_deg_s": 5729.5779513082325}'

