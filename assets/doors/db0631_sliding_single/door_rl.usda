        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0631_sliding_single/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "door_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:transX"]
            )
            {
                custom float doorbench:damping_si = 4.0535
                custom float doorbench:friction_effort = 157.07605
                custom float doorbench:initial = 0
                custom string doorbench:label = "Slide (0 = closed, + = open)"
                custom bool doorbench:limited = 1
                custom bool doorbench:locked = 0
                custom string doorbench:role = "primary"
                custom bool doorbench:slot_active = 1
                custom string doorbench:source_joint = "leaf_slide"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 4.0535
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0631_sliding_single/Articulation/base>
                rel physics:body1 = </db0631_sliding_single/Articulation/carriage>
                point3f physics:localPos0 = (0.48, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.95
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0.38983977
                custom float physxJointAxis:transX:armature = 0.5
                custom float physxJointAxis:transX:dynamicFrictionEffort = 157.07605
                custom float physxJointAxis:transX:staticFrictionEffort = 157.07605
                custom float physxJointAxis:transX:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "door_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:rotX"]
            )
            {
                custom float doorbench:damping_si = 20
                custom float doorbench:friction_effort = 0
                custom string doorbench:label = "door_hinge (unused slot, locked)"
                custom bool doorbench:locked = 1
                custom string doorbench:role = "locked"
                custom bool doorbench:slot_active = 0
                custom float doorbench:stiffness_si = 2000
                custom float doorbench:target_si = 0
                float drive:angular:physics:damping = 0.34906584
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 34.906586
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0631_sliding_single/Articulation/carriage>
                rel physics:body1 = </db0631_sliding_single/Articulation/leaf>
