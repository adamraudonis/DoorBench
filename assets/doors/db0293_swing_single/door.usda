    upAxis = "Z"
)

def Xform "db0293_swing_single"
{
    custom string doorbench:couplings = '[{"type": "weld", "body1": "leaf", "body2": "world", "label": "Delayed egress (15 s after 3 s push) (env releases on REX / badge / timer)", "active": true, "note": "breakable weld (maglock): environment logic, see doorbench.benchmark.DoorEnv"}, {"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_exit_device_slide", -1.357142857142857]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0293_swing_single"
    custom string doorbench:meta = '{"door_id": "db0293_swing_single", "family": "swing_single", "task": "unlock_open_traverse", "wall_y": 0.108, "breakable_welds": [{"name": "leaf_maglock", "holding_force_N": 2670.0}], "u": 1.0, "v": -1.0, "hinge_x": -0.613, "leaf_edge_x_local": 1.222, "handle_height": 1.016, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 79.9746074343729, "scene_extent": 2.03375, "cam_target_z": 1.0225, "cam_target_x": 0.0, "handle_cam_x": 0.506, "handle_cam_target": [0.5189999999999999, -0.08199999999999999, 1.016], "handle_cam_pos": [0.6989999999999998, -0.882, 1.296], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0293_swing_single/Articulation/Joints/leaf_hinge", "leaf_exit_device_slide": "/db0293_swing_single/Articulation/Joints/leaf_exit_device_slide", "leaf_latch_bolt_slide": "/db0293_swing_single/Articulation/Joints/leaf_latch_bolt_slide"}}'

