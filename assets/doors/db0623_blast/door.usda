#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0623_blast" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "bolt_0_slide", "driver": "dog_0_hinge", "coeff": [0, 0.04201680672268909, 0, 0, 0], "label": "bolt = lever * throw/(pi/2)"}, {"type": "polynomial", "driven": "bolt_1_slide", "driver": "dog_1_hinge", "coeff": [0, 0.04201680672268909, 0, 0, 0], "label": "bolt = lever * throw/(pi/2)"}]'
        custom string doorbench:meta = '{"door_id": "db0623_blast", "family": "blast", "task": "unlock_open_traverse", "wall_y": -0.08, "operator_joint": "dog_0_hinge", "u": 1.0, "v": 1.0, "primary_joint": "leaf_hinge", "handle_height": 1.05, "scene_extent": 2.1275, "cam_target_z": 1.085, "cam_target_x": 0.0, "handle_cam_x": 0.9, "handle_cam_target": [0.123, -0.12, 0.5750000000000001], "handle_cam_pos": [0.303, -0.92, 0.8550000000000001]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0623_blast/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0623_blast/Looks/mat_wall/Shader.outputs:surface>

                def Shader "Shader"
                {
