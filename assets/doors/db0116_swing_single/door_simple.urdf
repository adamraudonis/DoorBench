  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.534 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="12.49954" friction="3.792512"/>
    <doorbench:spring stiffness="13.190762" springref="-2.424424" note="tau = -stiffness*(q - springref); not native URDF"/>
