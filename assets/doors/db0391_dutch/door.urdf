  <joint name="lower_handle_hinge" type="revolute">
    <origin xyz="0.692 -0.029 0.965" rpy="0 0 0"/>
    <parent link="leaf_lower"/>
    <child link="lower_handle"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.96" effort="2000" velocity="10"/>
    <dynamics damping="0.245624" friction="0.048"/>
    <doorbench:spring stiffness="1.2" springref="-0.458333" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="lower_latch_bolt_slide" type="prismatic">
    <origin xyz="0.762 -0.029 0.965" rpy="0 0 0"/>
    <parent link="leaf_lower"/>
    <child link="lower_latch_bolt"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.0127" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="300" springref="-0.008333" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="lower_handle_hinge" multiplier="0.013956" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
  <joint name="upper_catch_slide" type="prismatic">
    <origin xyz="0.762 -0.029 1.654" rpy="0 0 0"/>
    <parent link="leaf_upper"/>
    <child link="upper_catch"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.004" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="4000" springref="-0.00375" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="join_bolt_slide" type="prismatic">
    <origin xyz="0.642 0.005 1.178" rpy="0 0 0"/>
    <parent link="leaf_upper"/>
    <child link="join_bolt"/>
    <axis xyz="0 0 1"/>
    <doorbench:zero_offset value="0.05" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.05" upper="0" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="1"/>
  </joint>
