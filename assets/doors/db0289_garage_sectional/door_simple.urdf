  <joint name="door_slide" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="door"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.003" effort="5000" velocity="10"/>
    <dynamics damping="7.676462" friction="22.26683"/>
    <doorbench:spring stiffness="152.60131" springref="6.933333" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="padlock: locked (T-handle lock bars engaged; env unlock frees the joint) counterbalance ~95% of 114 kg"/>
  </joint>
  <joint name="t_handle_hinge" type="revolute">
    <origin xyz="0 0 0.9" rpy="0 0 0"/>
    <parent link="door"/>
    <child link="t_handle"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="1.5708" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.028"/>
    <doorbench:spring stiffness="0.4" springref="-0.75" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="lock_bar_l_slide" type="prismatic">
