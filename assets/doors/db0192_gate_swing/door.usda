#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0192_gate_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_latch_bar_hinge", "driver": "leaf_thumb_hinge", "coeff": [0, 2.0, 0, 0, 0], "label": "bar lift = thumb press"}]'
        custom string doorbench:meta = '{"door_id": "db0192_gate_swing", "family": "gate_swing", "task": "close", "wall_y": 0.0, "u": -1.0, "v": -1.0, "hinge_x": 0.456, "leaf_edge_x_local": -0.903, "handle_height": 0.8, "primary_joint": "leaf_hinge", "operator_joint": null, "scene_extent": 1.5, "cam_target_z": 0.51, "cam_target_x": 0.0, "handle_cam_x": -0.34400000000000003, "handle_cam_target": [-0.36700000000000005, -0.0475, 0.75], "handle_cam_pos": [-0.18700000000000006, -0.8475, 1.03]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0192_gate_swing/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0192_gate_swing/Looks/mat_wall/Shader.outputs:surface>

