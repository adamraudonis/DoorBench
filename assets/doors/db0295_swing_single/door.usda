#usda 1.0
(
    defaultPrim = "db0295_swing_single"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0295_swing_single"
{
    custom string doorbench:couplings = '[{"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame shoe", "note": "not exported to USD (PhysX articulations are trees); closer arms are visual"}]'
    custom string doorbench:door_id = "db0295_swing_single"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_deadbolt"]]'
    custom string doorbench:meta = "{\"door_id\": \"db0295_swing_single\", \"family\": \"swing_single\", \"task\": \"locked_recognize\", \"wall_y\": -0.0475, \"clearance_allow\": [[\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"u\": -1.0, \"v\": 1.0, \"hinge_x\": 0.46, \"leaf_edge_x_local\": -0.917, \"handle_height\": 1.016, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": null, \"mass_reconciled_kg\": 92.84396321990118, \"scene_extent\": 2.1102499999999997, \"cam_target_z\": 1.0735, \"cam_target_x\": 0.0, \"handle_cam_x\": -0.35400000000000004, \"handle_cam_target\": [-0.35400000000000004, -0.0475, 1.016], \"handle_cam_pos\": [-0.17400000000000004, -0.8475, 1.296], \"operator_joints\": [], \"operator_coupling\": \"coupled\", \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0295_swing_single/Articulation/Joints/leaf_hinge\", \"closer_pinion\": \"/db0295_swing_single/Articulation/Joints/closer_pinion\", \"closer_elbow\": \"/db0295_swing_single/Articulation/Joints/closer_elbow\"}, \"self_collisions\": true, \"filtered_pairs\": [[\"leaf\", \"leaf_deadbolt\"]], \"n_filtered_pairs\": 1, \"env_release\": [], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0295_swing_single/Looks/mat_floor/Shader.outputs:surface>

