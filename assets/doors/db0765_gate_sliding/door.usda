#usda 1.0
(
    defaultPrim = "db0765_gate_sliding"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0765_gate_sliding"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0765_gate_sliding"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_hasp"]]'
    custom string doorbench:meta = '{"door_id": "db0765_gate_sliding", "family": "gate_sliding", "task": "close", "wall_y": 0.0, "sliding_track_supports": [{"joint": "leaf_slide", "body": "leaf", "rail": "gate_rail", "nominal_range": [0.0, 1.2], "leaf_width_m": 1.2, "rollers": ["leaf_roller_0", "leaf_roller_1"], "end_stops": [], "floor_guides_required": false, "floor_guides": []}], "clearance_allow": [["leaf_hasp_strap", "leaf_staple*", "staple passes through the strap slot"], ["leaf_padlock*", "leaf_staple*", "shackle through the staple eye"], ["leaf_padlock*", "leaf_hasp_strap", "padlock hangs over the strap"], ["leaf_hasp_strap", "leaf_hasp_plate", "strap over its hinge plate"], ["leaf_hasp_knuckle", "leaf_hasp_plate", "knuckle on its hinge plate"]], "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.0, "opens_toward": "left", "operator_joint": null, "mass_reconciled_kg": 5.803122996845561, "mass": {"leaf_material_kg": 5.0868, "leaf_hardware_rider_kg": 0.7163229968455604, "hardware_modelled_kg": 0.1336770031544395, "leaf_bodies": 1, "total_moving_kg": 5.936800000000001}, "scene_extent": 1.8875000000000002, "cam_target_z": 0.925, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.657, -0.0775, 1.0], "handle_cam_pos": [0.907, -1.1775, 1.35], "operator_joints": [], "operator_coupling": "coupled", "primary_assembly_kg": 5.9368, "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0765_gate_sliding/Articulation/Joints/leaf_slide", "leaf_hasp_hinge": "/db0765_gate_sliding/Articulation/Joints/leaf_hasp_hinge"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_hasp"]], "n_filtered_pairs": 1, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0765_gate_sliding/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0765_gate_sliding/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
