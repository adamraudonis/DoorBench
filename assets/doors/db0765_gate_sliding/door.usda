    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0765_gate_sliding/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "leaf_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:linear"]
            )
            {
                custom float doorbench:armature_si = 0.5
                custom float doorbench:damping_si = 2.29684
                custom float doorbench:friction_effort = 41.918488
                custom float doorbench:initial = 0
                custom string doorbench:label = "Slide (0 = closed, + = open)"
                custom float doorbench:legacy_friction_coeff = 0.71199274
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "leaf_slide"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 2.29684
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0765_gate_sliding/Articulation/base>
                rel physics:body1 = </db0765_gate_sliding/Articulation/leaf>
                point3f physics:localPos0 = (0, -0.06, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 1.2
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:linear:armature = 0.5
                custom float physxJointAxis:linear:dynamicFrictionEffort = 41.918488
                custom float physxJointAxis:linear:staticFrictionEffort = 41.918488
                custom float physxJointAxis:linear:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "leaf_hasp_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.005
                custom float doorbench:damping_si = 0.02
                custom float doorbench:friction_effort = 0.05
                custom float doorbench:initial = 2.8
                custom string doorbench:label = "Hasp (0 = closed over the staple, + = flipped open)"
                custom float doorbench:legacy_friction_coeff = 0.03605393
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "lock"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "leaf_hasp_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 2.8
                float drive:angular:physics:damping = 0.00034906584
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0765_gate_sliding/Articulation/leaf>
                rel physics:body1 = </db0765_gate_sliding/Articulation/leaf_hasp>
                point3f physics:localPos0 = (0.54, -0.0075, 1)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = -160.42818
                float physics:upperLimit = 5.729578
                custom float physxJoint:armature = 0.005
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:angular:armature = 0.005
                custom float physxJointAxis:angular:dynamicFrictionEffort = 0.05
                custom float physxJointAxis:angular:staticFrictionEffort = 0.05
                custom float physxJointAxis:angular:viscousFrictionCoefficient = 0
            }
        }

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
