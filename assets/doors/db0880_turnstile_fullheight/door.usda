    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0880_turnstile_fullheight/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsRevoluteJoint "rotor_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.3
                custom float doorbench:damping_si = 6
                custom float doorbench:friction_effort = 4.305164
                custom float doorbench:initial = 0
                custom string doorbench:label = "Rotor (ratchets 360/wings deg; one-way enforced by env)"
                custom float doorbench:legacy_friction_coeff = 0.011338218
                custom bool doorbench:limited = 0
                custom string doorbench:notes = "locked until a credential is presented: held by the rotor_solenoid_hold constraint, not by the joint range"
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "rotor_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.10471976
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0880_turnstile_fullheight/Articulation/base>
                rel physics:body1 = </db0880_turnstile_fullheight/Articulation/rotor>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = -720
                float physics:upperLimit = 720
                custom float physxJoint:armature = 0.3
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:angular:armature = 0.3
                custom float physxJointAxis:angular:dynamicFrictionEffort = 4.305164
                custom float physxJointAxis:angular:staticFrictionEffort = 4.305164
                custom float physxJointAxis:angular:viscousFrictionCoefficient = 0
            }

            def PhysicsPrismaticJoint "rotor_solenoid_plunger_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:linear"]
            )
            {
                custom float doorbench:armature_si = 0.1
                custom float doorbench:damping_si = 2
                custom float doorbench:friction_effort = 1
                custom float doorbench:initial = 0
                custom string doorbench:label = "Solenoid plunger (0 = dropped between the cam dogs, + = withdrawn)"
                custom float doorbench:legacy_friction_coeff = 0.5315636
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 0
                custom string doorbench:role = "lock"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "rotor_solenoid_plunger_slide"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 2
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0880_turnstile_fullheight/Articulation/base>
                rel physics:body1 = </db0880_turnstile_fullheight/Articulation/rotor_solenoid_plunger>
                point3f physics:localPos0 = (0.041, 0.071014084, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.04
                custom float physxJoint:armature = 0.1
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:linear:armature = 0.1
                custom float physxJointAxis:linear:dynamicFrictionEffort = 1
                custom float physxJointAxis:linear:staticFrictionEffort = 1
                custom float physxJointAxis:linear:viscousFrictionCoefficient = 0
            }

            def PhysicsFixedJoint "rotor_solenoid_hold"
            {
                custom float doorbench:holding_force_N = 5340
                custom string doorbench:label = "Turnstile solenoid lock (released on a valid credential)"
                custom string doorbench:role = "env_release"
                custom string doorbench:weld_body = "rotor"
                custom string doorbench:weld_name = "rotor_solenoid_hold"
                rel physics:body0 = </db0880_turnstile_fullheight/Articulation/base>
                rel physics:body1 = </db0880_turnstile_fullheight/Articulation/rotor>
                float physics:breakForce = 5340
                float physics:breakTorque = 5340
                bool physics:collisionEnabled = 0
                uniform bool physics:excludeFromArticulation = 1
                bool physics:jointEnabled = 1
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

