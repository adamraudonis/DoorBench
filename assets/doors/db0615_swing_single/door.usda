    custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.05135135135135135]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)", "note": "bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)"}]'
    custom string doorbench:door_id = "db0615_swing_single"
    custom string doorbench:meta = '{"door_id": "db0615_swing_single", "family": "swing_single", "task": "hold_and_pass", "wall_y": -0.046499999999999986, "u": 1.0, "v": 1.0, "hinge_x": -0.4615, "leaf_edge_x_local": 0.917, "handle_height": 1.067, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "mass_reconciled_kg": 79.24768227600016, "scene_extent": 2.5669999999999997, "cam_target_z": 1.378, "cam_target_x": 0.0, "handle_cam_x": 0.35250000000000004, "handle_cam_target": [0.35250000000000004, -0.046499999999999986, 1.067], "handle_cam_pos": [0.5325, -0.8465, 1.347], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0615_swing_single/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0615_swing_single/Articulation/Joints/leaf_handle_hinge", "leaf_latch_bolt_slide": "/db0615_swing_single/Articulation/Joints/leaf_latch_bolt_slide"}}'

