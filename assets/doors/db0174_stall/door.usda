                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0174_stall/leaf_riser>
                point3f physics:localPos0 = (-0.311, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.03
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0
                custom float physxMimicJoint:rotX:gearing = -0.006366198
                custom float physxMimicJoint:rotX:offset = 0
                custom string physxMimicJoint:rotX:referenceJoint = "/World/db0174_stall/Joints/leaf_hinge"
            }

            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:damping_closing = 0
                custom float doorbench:damping_opening = 0
