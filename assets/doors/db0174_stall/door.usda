    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_rise", "driver": "leaf_hinge", "coeff": [0.0, 0.006366197723675814, 0, 0, 0], "label": "gravity hinge: 10 mm rise per 90 deg"}]'
        custom string doorbench:meta = '{"door_id": "db0174_stall", "family": "stall", "task": "open_and_traverse", "wall_y": 0.0, "operator_joint": "slide_latch_slide", "u": 1.0, "v": -1.0, "primary_joint": "leaf_hinge", "handle_height": 1.0, "mass_reconciled_kg": 30.74281284821314, "scene_extent": 2.075, "cam_target_z": 1.05, "cam_target_x": 0.0, "handle_cam_x": 0.51, "handle_cam_target": [0.22499999999999995, -0.06, 1.0], "handle_cam_pos": [0.4049999999999999, -0.8600000000000001, 1.28]}'
