            {
                custom string doorbench:label = "Latch bar"
                custom string doorbench:semantic = "latch"
                rel material:binding = </World/db0174_stall/Looks/mat_op_stainless>
                rel material:binding:physics = </World/db0174_stall/Looks/PhysMat_mat_op_stainless> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.08, 0.008, 0.024)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Capsule "slide_latch_knob" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Latch knob"
                custom string doorbench:semantic = "operator"
                double height = 0.024
                rel material:binding = </World/db0174_stall/Looks/mat_op_stainless>
                rel material:binding:physics = </World/db0174_stall/Looks/PhysMat_mat_op_stainless> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double radius = 0.005
                quatf xformOp:orient = (0.70710677, 0.70710677, 0, -0)
                double3 xformOp:translate = (-0.03, -0.012, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "grip_latch"
            {
                custom string doorbench:site_role = "grip"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (-0.03, -0.03, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsPrismaticJoint "leaf_rise" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            )
            {
                custom float doorbench:initial = 0
                custom string doorbench:label = "Gravity-hinge lift (coupled)"
