                point3f physics:localPos1 = (0.05, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 110
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.28271437
            }

            def PhysicsPrismaticJoint "slide_latch_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            )
            {
                custom float doorbench:initial = 0.03
