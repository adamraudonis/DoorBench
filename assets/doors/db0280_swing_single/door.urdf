  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.534 -0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.919862" effort="2000" velocity="10"/>
    <dynamics damping="12.475663" friction="5.291805"/>
    <doorbench:spring stiffness="15.508058" springref="-1.827437" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="135" damping_opening="12" backcheck_angle="1.22" backcheck_damping="60"/>
  </joint>
  <joint name="leaf_exit_device_hinge" type="revolute">
    <origin xyz="-0.566875 0.051 1.016" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_exit_device"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.35" effort="2000" velocity="10"/>
    <dynamics damping="0.5" friction="0.3"/>
    <doorbench:spring stiffness="12" springref="-0.333333" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_latch_bolt_slide" type="prismatic">
    <origin xyz="-1.067 0.029 1.016" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_latch_bolt"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.019" effort="5000" velocity="10"/>
    <dynamics damping="2" friction="0.3"/>
    <doorbench:spring stiffness="800" springref="-0.01" note="tau = -stiffness*(q - springref); not native URDF"/>
    <mimic joint="leaf_exit_device_hinge" multiplier="0.059375" offset="0"/>
    <doorbench:coupling one_sided="true" note="MJCF uses a one-sided tendon (bolt may retract further, e.g. riding over the strike lip); mimic is bilateral"/>
  </joint>
  <joint name="closer_pinion" type="continuous">
    <origin xyz="-0.297 -0.103 2.002" rpy="0 0 -1.486416"/>
    <parent link="leaf"/>
    <child link="closer_arm_main"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>
  <joint name="closer_elbow" type="continuous">
    <origin xyz="0.28 0 0" rpy="0 0 2.311538"/>
    <parent link="closer_arm_main"/>
    <child link="closer_arm_fore"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>
