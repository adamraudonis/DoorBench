#usda 1.0
(
    defaultPrim = "db0044_pivot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0044_pivot"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0044_pivot"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_handle"]]'
    custom string doorbench:meta = '{"door_id": "db0044_pivot", "family": "pivot", "task": "open_and_traverse", "wall_y": 0.13349999999999998, "u": -1.0, "v": -1.0, "hinge_x": 0.606, "leaf_edge_x_local": -1.2029999999999998, "handle_height": 1.05, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "mass_reconciled_kg": 138.3317320993301, "scene_extent": 2.309, "cam_target_z": 1.206, "cam_target_x": 0.0, "handle_cam_x": -0.4939999999999999, "handle_cam_target": [-0.43599999999999994, -0.0645, 1.05], "handle_cam_pos": [-0.25599999999999995, -0.8645, 1.33], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0044_pivot/Articulation/Joints/leaf_hinge", "leaf_handle_hinge": "/db0044_pivot/Articulation/Joints/leaf_handle_hinge"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_handle"]], "n_filtered_pairs": 1, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0044_pivot/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

