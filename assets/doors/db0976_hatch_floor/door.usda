                custom string doorbench:site_role = "grip"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0.063, -1.1325)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "hatch_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:initial = 0
                custom string doorbench:label = "Hatch (0 = closed, + = lifted)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.5354275
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.3403392
                float drive:angular:physics:targetPosition = -190.98593
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0976_hatch_floor/hatch>
                point3f physics:localPos0 = (0, 0.755, 0.04)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 75
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 1.2086022
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

