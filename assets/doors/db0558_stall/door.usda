#usda 1.0
(
    defaultPrim = "db0558_stall"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0558_stall"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_rise", "driver": "leaf_hinge", "coeff": [0.0, 0.006366197723675814, 0, 0, 0], "gearing": -0.006366197723675814, "offset": -0.0, "label": "gravity hinge: 10 mm rise per 90 deg", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0558_stall"
    custom string doorbench:meta = '{"door_id": "db0558_stall", "family": "stall", "task": "open_and_traverse", "wall_y": 0.0, "operator_joint": "slide_latch_slide", "u": -1.0, "v": 1.0, "primary_joint": "leaf_hinge", "handle_height": 1.0, "mass_reconciled_kg": 18.117388848213146, "scene_extent": 2.075, "cam_target_z": 1.05, "cam_target_x": 0.0, "handle_cam_x": -0.56, "handle_cam_target": [-0.24999999999999997, 0.0445, 1.0], "handle_cam_pos": [-0.06999999999999998, -0.7555000000000001, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_rise": "/db0558_stall/Articulation/Joints/leaf_rise", "leaf_hinge": "/db0558_stall/Articulation/Joints/leaf_hinge", "slide_latch_slide": "/db0558_stall/Articulation/Joints/slide_latch_slide"}, "servo_in_drive": {}, "rise_coupling": {"rise_joint": "leaf_rise", "hinge_joint": "leaf_hinge", "coeff_m_per_rad": 0.006366197723675814, "lift_m_per_rad": 0.006366197723675814, "carried_mass_kg": 18.257640000000002, "gravity_torque_Nm": -1.1402334302974635, "label": "gravity hinge: 10 mm rise per 90 deg", "note": "constant closing torque -m*g*dz/dq of the helical hinge; apply on the hinge when the rise joint is not simulated"}, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0558_stall/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
