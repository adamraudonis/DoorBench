#usda 1.0
(
    defaultPrim = "db0617_pivot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0617_pivot"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0617_pivot"
    custom string doorbench:meta = '{"door_id": "db0617_pivot", "family": "pivot", "task": "close", "wall_y": 0.05, "u": -1.0, "v": -1.0, "hinge_x": 0.456, "leaf_edge_x_local": -0.906, "handle_height": 1.05, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 104.73923752473605, "scene_extent": 2.5340000000000003, "cam_target_z": 1.356, "cam_target_x": 0.0, "handle_cam_x": -0.34400000000000003, "handle_cam_target": [-0.34500000000000003, -0.095, 1.05], "handle_cam_pos": [-0.16500000000000004, -0.895, 1.33], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0617_pivot/Articulation/Joints/leaf_hinge", "leaf_mag_catch_slide": "/db0617_pivot/Articulation/Joints/leaf_mag_catch_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0617_pivot/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0617_pivot/Looks/mat_wall/Shader.outputs:surface>

