  <joint name="door_slide" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="door"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.95" effort="5000" velocity="10"/>
    <dynamics damping="4.6824" friction="21.044286"/>
    <doorbench:spring stiffness="48.580327" springref="6.5" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="counterbalance spring ~60% of weight counterbalance ~60% of 54 kg"/>
  </joint>
  <joint name="t_handle_hinge" type="revolute">
    <origin xyz="0 0 0.9" rpy="0 0 0"/>
    <parent link="door"/>
    <child link="t_handle"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="1.5708" effort="2000" velocity="10"/>
    <dynamics damping="0.127804" friction="0.028"/>
    <doorbench:spring stiffness="0.4" springref="-0.75" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
