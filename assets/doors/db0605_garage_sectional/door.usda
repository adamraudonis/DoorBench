                custom float doorbench:coupling_reflected_inertia = 0.0000349741
                custom float doorbench:damping_si = 2
                custom float doorbench:friction_effort = 1
                custom float doorbench:initial = 0
                custom string doorbench:label = "Lock bar"
                custom float doorbench:legacy_friction_coeff = 1
                custom bool doorbench:limited = 1
