    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0605_garage_sectional/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "door_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:linear"]
            )
            {
                custom float doorbench:armature_si = 0.5
                custom float doorbench:damping_si = 4.6824
                custom float doorbench:friction_effort = 21.044287
                custom float doorbench:initial = 0
                custom string doorbench:label = "Vertical lift (0 = closed, + = raised)"
                custom float doorbench:legacy_friction_coeff = 0.039480925
                custom bool doorbench:limited = 1
                custom string doorbench:notes = "counterbalance spring ~60% of weight counterbalance ~60% of 54 kg"
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "door_slide"
                custom float doorbench:stiffness_si = 48.580326
                custom float doorbench:target_si = 6.5
                custom float doorbench:zero_offset = 0
                float drive:linear:physics:damping = 4.6824
                float drive:linear:physics:maxForce = 1000000
                float drive:linear:physics:stiffness = 48.580326
                float drive:linear:physics:targetPosition = 6.5
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0605_garage_sectional/Articulation/base>
                rel physics:body1 = </db0605_garage_sectional/Articulation/door>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 1.95
                custom float physxJoint:armature = 0.5
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:linear:armature = 0.5
                custom float physxJointAxis:linear:dynamicFrictionEffort = 21.044287
                custom float physxJointAxis:linear:staticFrictionEffort = 21.044287
                custom float physxJointAxis:linear:viscousFrictionCoefficient = 0
            }

            def PhysicsRevoluteJoint "t_handle_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.01
                custom float doorbench:coupling_reflected_armature = 0.0000699482
                custom float doorbench:damping_si = 0.12780418
                custom float doorbench:friction_effort = 0.028
                custom float doorbench:initial = 0
                custom string doorbench:label = "T-handle w/ lock (garage / tilt-up) (0 = rest, + = actuated; spring return)"
                custom float doorbench:legacy_friction_coeff = 0.008505175
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "operator"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "t_handle_hinge"
                custom float doorbench:stiffness_si = 0.4
                custom float doorbench:target_si = -0.75
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.0022306037
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.006981317
                float drive:angular:physics:targetPosition = -42.971836
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0605_garage_sectional/Articulation/door>
                rel physics:body1 = </db0605_garage_sectional/Articulation/t_handle>
                point3f physics:localPos0 = (0, 0, 0.9)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 90.00021
                custom float physxJoint:armature = 0.01
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:angular:armature = 0.01
                custom float physxJointAxis:angular:dynamicFrictionEffort = 0.028
                custom float physxJointAxis:angular:staticFrictionEffort = 0.028
                custom float physxJointAxis:angular:viscousFrictionCoefficient = 0
            }

            def PhysicsPrismaticJoint "lock_bar_l_slide" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI", "PhysxJointAxisAPI:linear"]
            )
            {
                custom float doorbench:armature_si = 0.1
                custom float doorbench:coupling_c0 = 0
                custom float doorbench:coupling_c1 = 0.019098548
                custom int doorbench:coupling_chain_order = 0
                custom float doorbench:coupling_driven_inertia = 0.09588392
