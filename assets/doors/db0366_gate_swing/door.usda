#usda 1.0
(
    defaultPrim = "db0366_gate_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0366_gate_swing"
{
    custom string doorbench:couplings = '[{"type": "mimic", "driven": "leaf_latch_bar_hinge", "driver": "leaf_thumb_hinge", "coeff": [0, 2.0, 0, 0, 0], "gearing": -2.0, "offset": -0.0, "label": "bar lift = thumb press", "note": "PhysxMimicJointAPI on the driven joint; q_driven + gearing*q_driver + offset = 0 in rad / m"}]'
    custom string doorbench:door_id = "db0366_gate_swing"
    custom string doorbench:meta = '{"door_id": "db0366_gate_swing", "family": "gate_swing", "task": "hold_and_pass", "wall_y": 0.0, "u": 1.0, "v": 1.0, "hinge_x": -0.506, "leaf_edge_x_local": 1.003, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 12.157379143749946, "scene_extent": 1.5, "cam_target_z": 0.61, "cam_target_x": 0.0, "handle_cam_x": 0.394, "handle_cam_target": [0.4169999999999999, -0.0475, 0.95], "handle_cam_pos": [0.597, -0.8475, 1.23], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0366_gate_swing/Articulation/Joints/leaf_hinge", "leaf_thumb_hinge": "/db0366_gate_swing/Articulation/Joints/leaf_thumb_hinge", "leaf_latch_bar_hinge": "/db0366_gate_swing/Articulation/Joints/leaf_latch_bar_hinge", "leaf_aux_bolt_slide": "/db0366_gate_swing/Articulation/Joints/leaf_aux_bolt_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0366_gate_swing/Looks/mat_floor/Shader.outputs:surface>

