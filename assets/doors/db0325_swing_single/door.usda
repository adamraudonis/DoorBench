    custom string doorbench:couplings = "[{\"driven\": \"leaf_rise\", \"driver\": \"leaf_hinge\", \"driven_type\": \"slide\", \"driver_type\": \"hinge\", \"mode\": \"emulated\", \"coeff\": [0.0, 0.005092958178940651], \"gearing\": -0.005092958178940651, \"offset\": -0.0, \"label\": \"rise = 8 mm per 90 deg (helical hinge)\", \"coeff_usd\": [0.0, 0.005092958178940651], \"driven_zero_offset\": 0.0, \"driver_zero_offset\": 0.0, \"driven_inertia\": 58.333175, \"reflected_inertia\": 0.0015130589021736007, \"driven_gravity_bias\": -572.2484467500001, \"driven_stiffness\": 0.0, \"driven_damping\": 1.0, \"driven_target\": 0.0, \"driven_friction\": 0.0, \"driven_range\": [0.0, 0.0176], \"friction_vel_eps\": 0.001, \"reason\": \"PhysX articulation mimic joints support rotational axes only: a mimic on a prismatic axis is dropped\", \"note\": \"PhysX drops mimics on prismatic axes: emulate bilaterally (track q_driven = c0 + c1*q_driver, apply c1 * tau_driven_ext on the driver and add reflected_inertia to the driver's armature)\", \"chain_order\": 0, \"type\": \"coupling_emulated\", \"driven_path\": \"/db0325_swing_single/Articulation/Joints/leaf_rise\", \"driver_path\": \"/db0325_swing_single/Articulation/Joints/leaf_hinge\"}, {\"type\": \"one_sided_tendon\", \"terms\": [[\"leaf_latch_bolt_slide\", 1.0], [\"leaf_handle_hinge\", -0.018666666666666668]], \"range\": [0.0, 10.0], \"label\": \"bolt_q >= scale*handle_q (one-sided)\", \"note\": \"bolt_q >= scale*operator_q: drive the latch target from the operator in the environment (doorbench_isaaclab does this)\"}]"
    custom string doorbench:door_id = "db0325_swing_single"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_handle"], ["leaf", "leaf_latch_bolt"]]'
