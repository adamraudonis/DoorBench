#usda 1.0
(
    defaultPrim = "db0045_pet_door"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0045_pet_door"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0045_pet_door"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = "[]"
    custom string doorbench:meta = '{"door_id": "db0045_pet_door", "family": "pet_door", "task": "traverse_open", "wall_y": 0.0, "primary_joint": "flap_hinge", "operator_joint": null, "handle_height": 0.305, "both_ways": true, "mass_reconciled_kg": 0.895, "scene_extent": 1.5, "cam_target_z": 0.255, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 0.305], "handle_cam_pos": [0.48, -0.8, 0.585], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"flap_hinge": "/db0045_pet_door/Articulation/Joints/flap_hinge"}, "self_collisions": true, "filtered_pairs": [], "n_filtered_pairs": 0, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0045_pet_door/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0045_pet_door/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "mat_frame"
        {
            token outputs:surface.connect = </db0045_pet_door/Looks/mat_frame/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "mat_flap"
        {
            token outputs:surface.connect = </db0045_pet_door/Looks/mat_flap/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.92, 0.95)
                float inputs:metallic = 0
                float inputs:opacity = 0.3
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "mat_magnet"
        {
            token outputs:surface.connect = </db0045_pet_door/Looks/mat_magnet/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "PhysMat_mat_floor_0_800" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.68
            float physics:restitution = 0.05
            float physics:staticFriction = 0.8
        }

        def Material "PhysMat_mat_wall_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_frame_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_flap_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }
    }

    def Xform "Env"
    {
        def Xform "world_env"
        {
            custom string doorbench:semantic = "wall"
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "floor" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Floor"
                custom string doorbench:semantic = "floor"
                rel material:binding = </db0045_pet_door/Looks/mat_floor>
                rel material:binding:physics = </db0045_pet_door/Looks/PhysMat_mat_floor_0_800> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (12, 12, 0.1)
                double3 xformOp:translate = (0, 0, -0.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "wall_left" (
