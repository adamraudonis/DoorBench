            }

            def Cube "wall_right" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Wall"
                custom string doorbench:semantic = "wall"
                rel material:binding = </db0045_pet_door/Looks/mat_wall>
                rel material:binding:physics = </db0045_pet_door/Looks/PhysMat_mat_wall_0_600> (
