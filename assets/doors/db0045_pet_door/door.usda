                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }

    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:articulationEnabled = 1
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom float physxArticulation:sleepThreshold = 0
        custom int physxArticulation:solverPositionIterationCount = 16
        custom int physxArticulation:solverVelocityIterationCount = 4
        custom float physxArticulation:stabilizationThreshold = 0

        def Scope "Joints"
        {
            def PhysicsFixedJoint "base_fixed"
            {
                custom string doorbench:role = "base"
                rel physics:body1 = </db0045_pet_door/Articulation/base>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsRevoluteJoint "flap_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "PhysxJointAxisAPI:angular"]
            )
            {
                custom float doorbench:armature_si = 0.02
                custom float doorbench:damping_si = 0.01073143
                custom float doorbench:friction_effort = 0.046682715
                custom float doorbench:initial = 0
                custom string doorbench:label = "Flap (swings both ways)"
                custom float doorbench:legacy_friction_coeff = 0.005316968
                custom bool doorbench:limited = 1
                custom bool doorbench:robot_interactive = 1
                custom string doorbench:role = "primary"
                custom bool doorbench:servo_in_drive = 0
                custom string doorbench:source_joint = "flap_hinge"
                custom float doorbench:stiffness_si = 0
                custom float doorbench:target_si = 0
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.00018729879
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0045_pet_door/Articulation/base>
                rel physics:body1 = </db0045_pet_door/Articulation/flap>
                point3f physics:localPos0 = (0, 0, 0.5535)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -75
                float physics:upperLimit = 75
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0
                custom float physxJointAxis:angular:armature = 0.02
                custom float physxJointAxis:angular:dynamicFrictionEffort = 0.046682715
                custom float physxJointAxis:angular:staticFrictionEffort = 0.046682715
                custom float physxJointAxis:angular:viscousFrictionCoefficient = 0
            }
        }

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:label = "Fixed base link"
            custom string doorbench:semantic = "base"
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            float physics:mass = 1
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom float physxRigidBody:maxAngularVelocity = 5729.578
            custom float physxRigidBody:maxDepenetrationVelocity = 5
            custom float physxRigidBody:sleepThreshold = 0
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "flap" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:label = "Pet flap"
            custom string doorbench:semantic = "leaf"
            point3f physics:centerOfMass = (0, 0, -0.2988274)
            float3 physics:diagonalInertia = (0.0061631002, 0.022976154, 0.029134797)
            float physics:mass = 0.895
            quatf physics:principalAxes = (-0.5, 0.5, 0.5, 0.5)
            custom float physxRigidBody:maxAngularVelocity = 5729.578
            custom float physxRigidBody:maxDepenetrationVelocity = 5
            custom float physxRigidBody:sleepThreshold = 0
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0.5535000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "flap_geom" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Flap"
                custom string doorbench:semantic = "leaf"
                rel material:binding = </db0045_pet_door/Looks/mat_flap>
                rel material:binding:physics = </db0045_pet_door/Looks/PhysMat_mat_flap_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.294, 0.005, 0.496)
                double3 xformOp:translate = (0, 0, -0.25)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "flap_magnet" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom bool doorbench:collision = 0
                custom string doorbench:label = "Magnet strip"
                custom string doorbench:semantic = "latch"
                rel material:binding = </db0045_pet_door/Looks/mat_magnet>
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.26, 0.007, 0.016)
                double3 xformOp:translate = (0, 0, -0.49)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}

