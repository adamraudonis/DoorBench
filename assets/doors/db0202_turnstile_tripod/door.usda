#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0202_turnstile_tripod" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0202_turnstile_tripod", "family": "turnstile_tripod", "task": "traverse_open", "wall_y": 0.0, "primary_joint": "rotor_hinge", "operator_joint": null, "handle_height": 0.95, "ratchet_deg": 120, "one_way": true, "locked": false, "scene_extent": 1.5, "cam_target_z": 0.525, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 0.95], "handle_cam_pos": [0.55, -1.1, 1.2999999999999998]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0202_turnstile_tripod/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0202_turnstile_tripod/Looks/mat_wall/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }

            def Material "mat_frame"
            {
                token outputs:surface.connect = </World/db0202_turnstile_tripod/Looks/mat_frame/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                    float inputs:metallic = 1
                    float inputs:opacity = 1
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }

            def Material "mat_op_stainless"
            {
                token outputs:surface.connect = </World/db0202_turnstile_tripod/Looks/mat_op_stainless/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                    float inputs:metallic = 1
                    float inputs:opacity = 1
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }

            def Material "PhysMat_mat_floor" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.68
                float physics:restitution = 0.05
                float physics:staticFriction = 0.8
            }

            def Material "PhysMat_mat_frame" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.51
                float physics:restitution = 0.05
                float physics:staticFriction = 0.6
            }

            def Material "PhysMat_mat_op_stainless" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.51
                float physics:restitution = 0.05
                float physics:staticFriction = 0.6
            }
        }

        def Xform "world_env"
        {
            custom string doorbench:semantic = "wall"
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "floor" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Floor"
                custom string doorbench:semantic = "floor"
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_floor>
                rel material:binding:physics = </World/db0202_turnstile_tripod/Looks/PhysMat_mat_floor> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (12, 12, 0.1)
                double3 xformOp:translate = (0, 0, -0.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "cabinet" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Turnstile cabinet"
                custom string doorbench:semantic = "frame"
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_frame>
                rel material:binding:physics = </World/db0202_turnstile_tripod/Looks/PhysMat_mat_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.28, 0.9, 0.98)
                double3 xformOp:translate = (-0.31500000000000006, 0, 0.49)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "cabinet_top" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Cabinet top"
                custom string doorbench:semantic = "frame"
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_frame>
                rel material:binding:physics = </World/db0202_turnstile_tripod/Looks/PhysMat_mat_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.3, 0.92, 0.02)
                double3 xformOp:translate = (-0.31500000000000006, 0, 0.99)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "guide_rail_post" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Guide rail"
                custom string doorbench:semantic = "frame"
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_frame>
                rel material:binding:physics = </World/db0202_turnstile_tripod/Looks/PhysMat_mat_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.04, 0.9, 1)
                double3 xformOp:translate = (0.715, 0, 0.5)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cylinder "hub_boss" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Hub boss"
                custom string doorbench:semantic = "frame"
                double height = 0.27
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_frame>
                double radius = 0.04
                quatf xformOp:orient = (0.70710677, 0, 0.70710677, 0)
                double3 xformOp:translate = (-0.040000000000000036, 0, 0.9299999999999999)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "approach_point"
            {
                custom string doorbench:site_role = "approach"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.375, -1.2, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "goal_point"
            {
                custom string doorbench:site_role = "goal"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.375, 1.2, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "door_plane_center"
            {
                custom string doorbench:site_role = "pass_plane"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.375, 0, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Xform "rotor" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:semantic = "leaf"
            point3f physics:centerOfMass = (2.7087533e-17, 4.8370594e-17, -4.8370594e-17)
            float3 physics:diagonalInertia = (1.4929347, 1.8691503, 3.306555)
            float physics:mass = 28.690546
            quatf physics:principalAxes = (0.6532815, -0.27059805, -0.27059805, -0.6532815)
            custom bool physxRigidBody:enableCCD = 1
            custom int physxRigidBody:solverPositionIterationCount = 16
            custom int physxRigidBody:solverVelocityIterationCount = 4
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.11499999999999998, 0, 0.9299999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Xform "tripod_mesh" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @../../hardware/tripod_ae832648e5.usdc@</tripod_ae832648e5>
            )
            {
                custom string doorbench:label = "Tripod arms"
                custom string doorbench:semantic = "operator"
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_op_stainless>
                quatf xformOp:orient = (0.9238795, -0.38268343, 0, 0)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Capsule "arm_0_col" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Arm 1"
                custom string doorbench:semantic = "operator"
                double height = 0.5
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_op_stainless>
                rel material:binding:physics = </World/db0202_turnstile_tripod/Looks/PhysMat_mat_op_stainless> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double radius = 0.019
                quatf xformOp:orient = (0.70710677, 0, 0.70710677, 0)
                double3 xformOp:translate = (0.25, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Capsule "arm_1_col" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Arm 2"
                custom string doorbench:semantic = "operator"
                double height = 0.5
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_op_stainless>
                rel material:binding:physics = </World/db0202_turnstile_tripod/Looks/PhysMat_mat_op_stainless> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double radius = 0.019
                quatf xformOp:orient = (0.44024286, -0.6954939, -0.56786835, 0)
                double3 xformOp:translate = (-0.12499999999999996, 0.15309310892394865, -0.15309310892394862)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Capsule "arm_2_col" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                custom string doorbench:label = "Arm 3"
                custom string doorbench:semantic = "operator"
                double height = 0.5
                rel material:binding = </World/db0202_turnstile_tripod/Looks/mat_op_stainless>
                rel material:binding:physics = </World/db0202_turnstile_tripod/Looks/PhysMat_mat_op_stainless> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double radius = 0.019
                quatf xformOp:orient = (0.8978787, 0.34101066, -0.27843404, 0)
                double3 xformOp:translate = (-0.1250000000000001, -0.1530931089239486, 0.15309310892394856)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "arm_push"
            {
                custom string doorbench:site_role = "push"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0.45, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "rotor_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:initial = 0
                custom string doorbench:label = "Tripod rotor (ratchets 120 deg; one-way enforced by env)"
                custom bool doorbench:ratchet_one_way = 1
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.034906585
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0202_turnstile_tripod/rotor>
                point3f physics:localPos0 = (0.115, 0, 0.93)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.5, 0.5)
                quatf physics:localRot1 = (0.70710677, 0, -0.5, 0.5)
                custom float physxJoint:armature = 0.05
                custom float physxJoint:jointFriction = 3.0591397
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

