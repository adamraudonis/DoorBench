#usda 1.0
(
    defaultPrim = "db0202_turnstile_tripod"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0202_turnstile_tripod"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0202_turnstile_tripod"
    custom string doorbench:meta = '{"door_id": "db0202_turnstile_tripod", "family": "turnstile_tripod", "task": "traverse_open", "wall_y": 0.0, "clearance_allow": [["hub_boss", "tripod_mesh", "rotor hub seats on the boss"]], "primary_joint": "rotor_hinge", "operator_joint": null, "handle_height": 0.95, "ratchet_deg": 120, "one_way": true, "locked": false, "mass_reconciled_kg": 7.538226043740886, "scene_extent": 1.5, "cam_target_z": 0.525, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 0.95], "handle_cam_pos": [0.55, -1.1, 1.2999999999999998], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"rotor_hinge": "/db0202_turnstile_tripod/Articulation/Joints/rotor_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0202_turnstile_tripod/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0202_turnstile_tripod/Looks/mat_wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "mat_frame"
        {
            token outputs:surface.connect = </db0202_turnstile_tripod/Looks/mat_frame/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "mat_op_stainless"
        {
            token outputs:surface.connect = </db0202_turnstile_tripod/Looks/mat_op_stainless/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "PhysMat_mat_floor_0_800" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.68
            float physics:restitution = 0.05
            float physics:staticFriction = 0.8
        }

        def Material "PhysMat_mat_frame_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }

        def Material "PhysMat_mat_op_stainless_0_600" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.51
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }
    }

