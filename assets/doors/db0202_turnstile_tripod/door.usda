                float drive:angular:physics:damping = 0.034906585
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </db0202_turnstile_tripod/Articulation/base>
                rel physics:body1 = </db0202_turnstile_tripod/Articulation/rotor>
                point3f physics:localPos0 = (0.115, 0, 0.93)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.5, 0.5)
                quatf physics:localRot1 = (0.70710677, 0, -0.5, 0.5)
                float physics:lowerLimit = -720
                float physics:upperLimit = 720
                custom float physxJoint:armature = 0.05
                custom float physxJoint:jointFriction = 0.041134715
                custom float physxJointAxis:rotX:armature = 0.05
                custom float physxJointAxis:rotX:dynamicFrictionEffort = 3.0591397
                custom float physxJointAxis:rotX:staticFrictionEffort = 3.0591397
                custom float physxJointAxis:rotX:viscousFrictionCoefficient = 0
            }
        }

