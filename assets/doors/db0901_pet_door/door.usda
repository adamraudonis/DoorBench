#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0901_pet_door" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0901_pet_door", "family": "pet_door", "task": "push_through", "wall_y": 0.0, "primary_joint": "flap_hinge", "operator_joint": null, "handle_height": 0.14, "both_ways": true, "scene_extent": 1.5, "cam_target_z": 0.09, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.3, 0.0, 0.14], "handle_cam_pos": [0.48, -0.8, 0.42000000000000004]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0901_pet_door/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0901_pet_door/Looks/mat_wall/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.78, 0.76, 0.7)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }

            def Material "mat_frame"
            {
                token outputs:surface.connect = </World/db0901_pet_door/Looks/mat_frame/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                    float inputs:metallic = 1
                    float inputs:opacity = 1
                    float inputs:roughness = 0.4
                    token outputs:surface
                }
            }

            def Material "mat_flap"
            {
                token outputs:surface.connect = </World/db0901_pet_door/Looks/mat_flap/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.85, 0.9, 0.95)
                    float inputs:metallic = 0
                    float inputs:opacity = 0.45
                    float inputs:roughness = 0.3
                    token outputs:surface
                }
            }

            def Material "mat_magnet"
            {
                token outputs:surface.connect = </World/db0901_pet_door/Looks/mat_magnet/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                    float inputs:metallic = 1
                    float inputs:opacity = 1
                    float inputs:roughness = 0.45
                    token outputs:surface
                }
            }

            def Material "PhysMat_mat_floor" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.68
                float physics:restitution = 0.05
                float physics:staticFriction = 0.8
            }

            def Material "PhysMat_mat_wall" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.51
                float physics:restitution = 0.05
                float physics:staticFriction = 0.6
            }

            def Material "PhysMat_mat_frame" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.51
                float physics:restitution = 0.05
                float physics:staticFriction = 0.6
            }

            def Material "PhysMat_mat_flap" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.51
                float physics:restitution = 0.05
                float physics:staticFriction = 0.6
            }
        }

        def Xform "world_env"
        {
            custom string doorbench:semantic = "wall"
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "floor" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Floor"
                custom string doorbench:semantic = "floor"
                rel material:binding = </World/db0901_pet_door/Looks/mat_floor>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_floor> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (12, 12, 0.1)
                double3 xformOp:translate = (0, 0, -0.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "wall_left" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Wall"
                custom string doorbench:semantic = "wall"
                rel material:binding = </World/db0901_pet_door/Looks/mat_wall>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_wall> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.92, 0.044, 2.1)
                double3 xformOp:translate = (-0.54, 0, 1.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "wall_right" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Wall"
                custom string doorbench:semantic = "wall"
                rel material:binding = </World/db0901_pet_door/Looks/mat_wall>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_wall> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.92, 0.044, 2.1)
                double3 xformOp:translate = (0.54, 0, 1.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "wall_header" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Wall header"
                custom string doorbench:semantic = "wall"
                rel material:binding = </World/db0901_pet_door/Looks/mat_wall>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_wall> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.16, 0.044, 1.87)
                double3 xformOp:translate = (0, 0, 1.165)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_frame_l" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Pet door frame"
                custom string doorbench:semantic = "frame"
                rel material:binding = </World/db0901_pet_door/Looks/mat_frame>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.04, 0.056, 0.26)
                double3 xformOp:translate = (-0.1, 0, 0.14)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_frame_r" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Pet door frame"
                custom string doorbench:semantic = "frame"
                rel material:binding = </World/db0901_pet_door/Looks/mat_frame>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.04, 0.056, 0.26)
                double3 xformOp:translate = (0.1, 0, 0.14)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_frame_t" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Pet door frame"
                custom string doorbench:semantic = "frame"
                rel material:binding = </World/db0901_pet_door/Looks/mat_frame>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.16, 0.056, 0.04)
                double3 xformOp:translate = (0, 0, 0.24999999999999997)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_sill" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Sill"
                custom string doorbench:semantic = "frame"
                rel material:binding = </World/db0901_pet_door/Looks/mat_frame>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.16, 0.056, 0.012)
                double3 xformOp:translate = (0, 0, 0.044000000000000004)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "sill_magnet" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom string doorbench:label = "Sill magnet"
                custom string doorbench:semantic = "latch"
                rel material:binding = </World/db0901_pet_door/Looks/mat_magnet>
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.11, 0.004, 0.016)
                double3 xformOp:translate = (0, -0.005, 0.060000000000000005)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "approach_point"
            {
                custom string doorbench:site_role = "approach"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, -1, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "goal_point"
            {
                custom string doorbench:site_role = "goal"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 1, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Xform "door_plane_center"
            {
                custom string doorbench:site_role = "pass_plane"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, 0.14)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Xform "flap" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            custom string doorbench:semantic = "leaf"
            point3f physics:centerOfMass = (0, 0, -0.113209225)
            float3 physics:diagonalInertia = (0.00032161883, 0.00060885394, 0.0009296087)
            float physics:mass = 0.220396
            quatf physics:principalAxes = (-0.5, 0.5, 0.5, 0.5)
            custom bool physxRigidBody:enableCCD = 1
            custom int physxRigidBody:solverPositionIterationCount = 16
            custom int physxRigidBody:solverVelocityIterationCount = 4
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0.22999999999999998)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "flap_geom" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                custom string doorbench:label = "Flap"
                custom string doorbench:semantic = "leaf"
                rel material:binding = </World/db0901_pet_door/Looks/mat_flap>
                rel material:binding:physics = </World/db0901_pet_door/Looks/PhysMat_mat_flap> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.144, 0.004, 0.166)
                double3 xformOp:translate = (0, 0, -0.085)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "flap_magnet" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom string doorbench:label = "Magnet strip"
                custom string doorbench:semantic = "latch"
                rel material:binding = </World/db0901_pet_door/Looks/mat_magnet>
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.11, 0.006, 0.016)
                double3 xformOp:translate = (0, 0, -0.16)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "flap_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:initial = 0
                custom string doorbench:label = "Flap (swings both ways)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.0001748042
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0901_pet_door/flap>
                point3f physics:localPos0 = (0, 0, 0.23)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -75
                float physics:upperLimit = 75
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 0.012626311
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

