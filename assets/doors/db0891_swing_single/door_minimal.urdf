  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.534 0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.570796" effort="2000" velocity="10"/>
    <dynamics damping="10.49954" friction="3.864023"/>
    <doorbench:spring stiffness="15.234311" springref="-3.060197" note="tau = -stiffness*(q - springref); not native URDF"/>
