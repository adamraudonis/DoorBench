    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="1.5708" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.07"/>
    <doorbench:spring stiffness="0.6" springref="-0.666667" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
