    <limit lower="-0.261799" upper="1.658063" effort="2000" velocity="10"/>
    <dynamics damping="0.09576" friction="1.300549"/>
    <doorbench:closer damping_closing="0" damping_opening="0" backcheck_angle="0" backcheck_damping="0"/>
  </joint>
