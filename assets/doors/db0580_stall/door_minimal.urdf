    <child link="leaf_riser"/>
    <axis xyz="0 0 1"/>
    <doorbench:zero_offset value="0.001667" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.001667" upper="0.028333" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="0"/>
    <mimic joint="leaf_hinge" multiplier="0.006366" offset="0"/>
  </joint>
