def Xform "db0010_swing_double"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0010_swing_double"
    custom string doorbench:meta = '{"door_id": "db0010_swing_double", "family": "swing_double", "task": "peek", "wall_y": -0.029999999999999995, "u": -1.0, "v": 1.0, "hinge_x": 0.9185, "leaf_edge_x_local": -0.917, "handle_height": 1.04, "primary_joint": "leaf_a_hinge", "operator_joint": null, "pair": true, "secondary_joint": "leaf_b_hinge", "mullion": false, "mass_reconciled_kg": 101.678242168, "scene_extent": 2.1102499999999997, "cam_target_z": 1.0735, "cam_target_x": 0.0, "handle_cam_x": 0.10449999999999993, "handle_cam_target": [-0.10649999999999993, -0.0975, 1.04], "handle_cam_pos": [0.07350000000000007, -0.8975000000000001, 1.32], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_a_hinge": "/db0010_swing_double/Articulation/Joints/leaf_a_hinge", "leaf_b_hinge": "/db0010_swing_double/Articulation/Joints/leaf_b_hinge"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
