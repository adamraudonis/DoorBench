#usda 1.0
(
    defaultPrim = "db0106_gate_swing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0106_gate_swing"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0106_gate_swing"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["leaf", "leaf_fork"]]'
    custom string doorbench:meta = '{"door_id": "db0106_gate_swing", "family": "gate_swing", "task": "open_only", "wall_y": 0.0, "clearance_allow": [["leaf_fork_eye", "leaf_fork_pin", "pivot pin through the fork eye"], ["leaf_fork_arm", "leaf_fork_pin", "pivot pin through the arm"]], "u": 1.0, "v": 1.0, "hinge_x": -0.606, "leaf_edge_x_local": 1.2029999999999998, "handle_height": 0.9, "primary_joint": "leaf_hinge", "operator_joint": "leaf_fork_hinge", "mass_reconciled_kg": 5.963237007703154, "mass": {"leaf_material_kg": 4.239, "leaf_hardware_rider_kg": 1.7242370077031544, "hardware_modelled_kg": 0.22576299229684554, "leaf_bodies": 1, "total_moving_kg": 6.188999999999999}, "scene_extent": 1.6400000000000001, "cam_target_z": 0.76, "cam_target_x": 0.0, "handle_cam_x": 0.4939999999999999, "handle_cam_target": [0.5860000000000001, -0.0135, 1.0050000000000001], "handle_cam_pos": [0.766, -0.8135, 1.2850000000000001], "operator_joints": ["leaf_fork_hinge"], "operator_coupling": "coupled", "primary_assembly_kg": 6.188999999999999, "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0106_gate_swing/Articulation/Joints/leaf_hinge", "leaf_fork_hinge": "/db0106_gate_swing/Articulation/Joints/leaf_fork_hinge"}, "self_collisions": true, "filtered_pairs": [["leaf", "leaf_fork"]], "n_filtered_pairs": 1, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0106_gate_swing/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
