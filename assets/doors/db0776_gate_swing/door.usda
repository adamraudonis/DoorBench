#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0776_gate_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0776_gate_swing", "family": "gate_swing", "task": "close", "wall_y": 0.0, "clearance_allow": [["leaf_fork_bridge", "leaf_fork_bracket", "fork pivots on its bracket"]], "u": 1.0, "v": 1.0, "hinge_x": -1.206, "leaf_edge_x_local": 2.403, "handle_height": 0.9, "primary_joint": "leaf_hinge", "operator_joint": null, "scene_extent": 2.309, "cam_target_z": 0.61, "cam_target_x": 0.0, "handle_cam_x": 1.0939999999999999, "handle_cam_target": [1.077, 0.0, 1.34], "handle_cam_pos": [1.257, -0.8, 1.62]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0776_gate_swing/Looks/mat_floor/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.35, 0.42, 0.25)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "mat_wall"
            {
                token outputs:surface.connect = </World/db0776_gate_swing/Looks/mat_wall/Shader.outputs:surface>

