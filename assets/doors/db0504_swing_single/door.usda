def Xform "World"
{
    def Xform "db0504_swing_single" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "one_sided_tendon", "terms": [["leaf_latch_bolt_slide", 1.0], ["leaf_handle_hinge", -0.015679012345679012]], "range": [0.0, 10.0], "label": "bolt_q >= scale*handle_q (one-sided)"}]'
        custom string doorbench:meta = '{"door_id": "db0504_swing_single", "family": "swing_single", "task": "open_and_traverse", "wall_y": 0.108, "u": -1.0, "v": -1.0, "hinge_x": 0.3595, "leaf_edge_x_local": -0.714, "handle_height": 0.965, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "scene_extent": 2.03375, "cam_target_z": 1.0225, "cam_target_x": 0.0, "handle_cam_x": -0.2515, "handle_cam_target": [-0.29449999999999993, -0.06849999999999999, 0.965], "handle_cam_pos": [-0.11449999999999994, -0.8685, 1.245]}'
