def Xform "db0482_gate_swing"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0482_gate_swing"
    custom string doorbench:meta = '{"door_id": "db0482_gate_swing", "family": "gate_swing", "task": "unlock_open_traverse", "wall_y": 0.0, "u": -1.0, "v": -1.0, "hinge_x": 0.506, "leaf_edge_x_local": -1.003, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 13.886501002910903, "scene_extent": 1.6400000000000001, "cam_target_z": 0.76, "cam_target_x": 0.0, "handle_cam_x": -0.394, "handle_cam_target": [-0.43699999999999983, -0.0645, 1.0], "handle_cam_pos": [-0.25699999999999984, -0.8645, 1.28], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0482_gate_swing/Articulation/Joints/leaf_hinge", "leaf_slide_bolt_slide": "/db0482_gate_swing/Articulation/Joints/leaf_slide_bolt_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
