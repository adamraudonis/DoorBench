#usda 1.0
(
    defaultPrim = "db0916_sliding_single"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0916_sliding_single"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0916_sliding_single"
    custom string doorbench:meta = '{"door_id": "db0916_sliding_single", "family": "sliding_single", "task": "open_only", "wall_y": 0.0, "primary_joint": "leaf_slide", "secondary_joint": null, "handle_height": 1.05, "opens_toward": "right", "operator_joint": null, "mass_reconciled_kg": 72.048752, "scene_extent": 2.039, "cam_target_z": 1.026, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [-0.4435, -0.1965, 1.05], "handle_cam_pos": [-0.2635, -0.9965, 1.33], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_slide": "/db0916_sliding_single/Articulation/Joints/leaf_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0916_sliding_single/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
