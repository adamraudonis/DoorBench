            }

            def Material "mat_floor_ring"
            {
                token outputs:surface.connect = </World/db0840_revolving/Looks/mat_floor_ring/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.75, 0.76, 0.77)
                    float inputs:metallic = 1
                    float inputs:opacity = 1
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }

            def Material "PhysMat_mat_floor" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.68
                float physics:restitution = 0.05
                float physics:staticFriction = 0.8
            }

            def Material "PhysMat_mat_wall" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
