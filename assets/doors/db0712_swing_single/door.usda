    custom string doorbench:filtered_pairs = "[]"
    custom string doorbench:meta = "{\"door_id\": \"db0712_swing_single\", \"family\": \"swing_single\", \"task\": \"peek\", \"wall_y\": -0.044500000000000005, \"clearance_allow\": [[\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"u\": 1.0, \"v\": 1.0, \"hinge_x\": -0.4615, \"leaf_edge_x_local\": 0.92, \"handle_height\": 1.067, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": null, \"mass_reconciled_kg\": 64.46678861990118, \"mass\": {\"leaf_material_kg\": 58.51427999999999, \"leaf_hardware_rider_kg\": 5.9525086199011845, \"hardware_modelled_kg\": 0.19749138009881548, \"leaf_bodies\": 1, \"total_moving_kg\": 64.66427999999999}, \"scene_extent\": 2.1102499999999997, \"cam_target_z\": 1.0735, \"cam_target_x\": 0.0, \"handle_cam_x\": 0.35250000000000004, \"handle_cam_target\": [0.35350000000000004, -0.066, 1.067], \"handle_cam_pos\": [0.5335000000000001, -0.8660000000000001, 1.347], \"operator_joints\": [], \"operator_coupling\": \"coupled\", \"primary_assembly_kg\": 64.66427999999999, \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0712_swing_single/Articulation/Joints/leaf_hinge\", \"closer_pinion\": \"/db0712_swing_single/Articulation/Joints/closer_pinion\", \"closer_elbow\": \"/db0712_swing_single/Articulation/Joints/closer_elbow\"}, \"self_collisions\": true, \"filtered_pairs\": [], \"n_filtered_pairs\": 0, \"env_release\": [], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

    def Scope "Looks"
