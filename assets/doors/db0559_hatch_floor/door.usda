                rel physics:body1 = </World/db0559_hatch_floor/hatch_bolt>
                point3f physics:localPos0 = (0.35, -0.605, 0.014)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
