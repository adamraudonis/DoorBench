    <limit lower="0" upper="2.08" effort="5000" velocity="10"/>
    <dynamics damping="4.039901" friction="41.609558"/>
    <doorbench:spring stiffness="43.293957" springref="6.933333" note="tau = -stiffness*(q - springref); not native URDF"/>
