                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Cube "leaf_hasp" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom string doorbench:label = "Hasp (visual)"
                custom string doorbench:semantic = "lock"
                rel material:binding = </World/db0305_swing_single/Looks/mat_op_steel_galvanized>
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.12, 0.006, 0.04)
                double3 xformOp:translate = (1.0399999999999998, -0.026, 1.04)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "leaf_edge_mid"
            {
                custom string doorbench:site_role = "leaf_edge"
                quatf xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (1.0699999999999998, 0, 1.219)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:damping_closing = 0
                custom float doorbench:damping_opening = 0
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.010833288
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body1 = </World/db0305_swing_single/leaf>
                point3f physics:localPos0 = (-0.534, 0.029, 0)
                point3f physics:localPos1 = (0.003, 0.029, 0)
                quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
                quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 110
                custom float physxJoint:armature = 0.02
                custom float physxJoint:jointFriction = 1.8620931
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}

