            def PhysicsRevoluteJoint "leaf_hinge" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                custom float doorbench:damping_closing = 1
                custom float doorbench:damping_opening = 1
                custom float doorbench:initial = 0
                custom string doorbench:label = "Door hinge (0 = closed, + = opening)"
                custom string doorbench:notes = "Padlocked hasp: leaf effectively fixed (2 mm rattle)"
                custom string doorbench:role = "primary"
                custom float doorbench:zero_offset = 0
                float drive:angular:physics:damping = 0.02218139
                float drive:angular:physics:maxForce = 1000000
                float drive:angular:physics:stiffness = 0.08726646
                float drive:angular:physics:targetPosition = -45.836624
