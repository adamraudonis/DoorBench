    custom string doorbench:meta = '{"door_id": "db0368_gate_swing", "family": "gate_swing", "task": "locked_recognize", "wall_y": 0.0, "clearance_allow": [["leaf_hasp_strap", "leaf_staple*", "staple passes through the strap slot"], ["leaf_padlock*", "leaf_staple*", "shackle through the staple eye"], ["leaf_padlock*", "leaf_hasp_strap", "padlock hangs over the strap"], ["leaf_hasp_strap", "leaf_hasp_plate", "strap over its hinge plate"], ["leaf_hasp_knuckle", "leaf_hasp_plate", "knuckle on its hinge plate"]], "u": -1.0, "v": -1.0, "hinge_x": 0.506, "leaf_edge_x_local": -1.003, "handle_height": 0.9, "primary_joint": "leaf_hinge", "operator_joint": null, "mass_reconciled_kg": 5.267659996845561, "scene_extent": 1.6400000000000001, "cam_target_z": 0.76, "cam_target_x": 0.0, "handle_cam_x": -0.394, "handle_cam_target": [-0.536, -0.064, 0.9], "handle_cam_pos": [-0.35600000000000004, -0.8640000000000001, 1.1800000000000002], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0368_gate_swing/Articulation/Joints/leaf_hinge", "leaf_hasp_hinge": "/db0368_gate_swing/Articulation/Joints/leaf_hasp_hinge"}}'

    def Scope "Looks"
