    upAxis = "Z"
)

def Xform "World"
{
    def Xform "db0006_gate_swing" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0006_gate_swing", "family": "gate_swing", "task": "open_and_traverse", "wall_y": 0.0, "u": 1.0, "v": -1.0, "hinge_x": -2.406, "leaf_edge_x_local": 4.803, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": null, "scene_extent": 4.109, "cam_target_z": 0.61, "cam_target_x": 0.0, "handle_cam_x": 2.294, "handle_cam_target": [2.217, -0.08249999999999999, 1.0], "handle_cam_pos": [2.3970000000000002, -0.8825000000000001, 1.28]}'
