    custom string doorbench:meta = "{\"door_id\": \"db0347_swing_single\", \"family\": \"swing_single\", \"task\": \"hold_and_pass\", \"wall_y\": -0.0435, \"clearance_allow\": [[\"*_paddle_neck_*\", \"*_paddle_pin_*\", \"the rocker neck is part of the hub that is clamped on its pivot pin\"], [\"*_paddle_hub_*\", \"*_paddle_pin_*\", \"the pivot pin runs in the hub's bore\"], [\"*closer_fore_pivot\", \"closer_bracket\", \"pivot pin occupies the soffit shoe's bore\"], [\"*closer_fore_neck\", \"closer_bracket\", \"forearm clevis enters the shoe around its pivot\"], [\"*closer_arm_fore_geom\", \"closer_bracket\", \"forearm reaches into the shoe it is pinned to\"]], \"paddle_mechanisms\": [{\"primary_joint\": \"leaf_handle_hinge\", \"faces\": [{\"face\": -1.0, \"body\": \"leaf_handle\", \"joint\": \"leaf_handle_hinge\", \"site\": \"leaf_handle_grip_n\", \"geom\": \"leaf_handle_paddle_col_n\", \"action\": \"push\", \"contact_face\": \"outer\"}, {\"face\": 1.0, \"body\": \"leaf_handle_paddle_follower_p\", \"joint\": \"leaf_handle_paddle_follower_p_hinge\", \"site\": \"leaf_handle_grip_p\", \"geom\": \"leaf_handle_paddle_col_p\", \"action\": \"pull\", \"contact_face\": \"inner\"}], \"coupling\": \"ideal 1:1 paddle cam; internal cam contact and lost motion not modeled\", \"source\": \"https://commercial.schlage.com/content/dam/allegion-us-2/web-documents-2/InstallInstructions/Glynn-Johnson_HL6-9000_Push_Pull_Mortise_Latch_Installation_Instructions_107563.pdf\", \"source_page\": 2, \"rest_lean_rad\": 0.4, \"grip_moment_arm_m\": 0.12}], \"u\": -1.0, \"v\": 1.0, \"hinge_x\": 0.4605, \"leaf_edge_x_local\": -0.917, \"handle_height\": 1.016, \"primary_joint\": \"leaf_hinge\", \"operator_joint\": \"leaf_handle_hinge\", \"mass_reconciled_kg\": 71.22358484308538, \"scene_extent\": 2.1102499999999997, \"cam_target_z\": 1.0735, \"cam_target_x\": 0.0, \"handle_cam_x\": -0.35350000000000004, \"handle_cam_target\": [-0.3444999999999999, 0.08120383511302073, 1.013663489946148], \"handle_cam_pos\": [-0.16449999999999992, -0.7187961648869793, 1.293663489946148], \"operator_joints\": [\"leaf_handle_hinge\"], \"operator_coupling\": \"coupled\", \"usd_layout\": \"v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)\", \"joints\": {\"leaf_hinge\": \"/db0347_swing_single/Articulation/Joints/leaf_hinge\", \"leaf_handle_hinge\": \"/db0347_swing_single/Articulation/Joints/leaf_handle_hinge\", \"leaf_handle_paddle_follower_p_hinge\": \"/db0347_swing_single/Articulation/Joints/leaf_handle_paddle_follower_p_hinge\", \"leaf_latch_bolt_slide\": \"/db0347_swing_single/Articulation/Joints/leaf_latch_bolt_slide\", \"closer_pinion\": \"/db0347_swing_single/Articulation/Joints/closer_pinion\", \"closer_elbow\": \"/db0347_swing_single/Articulation/Joints/closer_elbow\"}, \"self_collisions\": true, \"filtered_pairs\": [[\"leaf\", \"leaf_handle\"], [\"leaf\", \"leaf_handle_paddle_follower_p\"], [\"leaf\", \"leaf_latch_bolt\"]], \"n_filtered_pairs\": 3, \"env_release\": [], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

