  <joint name="leaf_hinge" type="revolute">
    <origin xyz="0.4575 0.029 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.658063" effort="2000" velocity="10"/>
    <dynamics damping="10.268966" friction="2.448409"/>
    <doorbench:spring stiffness="12.528677" springref="-2.635554" note="tau = -stiffness*(q - springref); not native URDF"/>
