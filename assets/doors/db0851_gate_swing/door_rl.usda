        {
            custom string doorbench:label = "leaf2 (empty)"
            custom string doorbench:semantic = "leaf2"
            custom string doorbench:source_bodies = "[]"
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.000018, 0.000018, 0.000018)
            float physics:mass = 0.05
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom float physxRigidBody:maxAngularVelocity = 5729.578
            custom float physxRigidBody:maxDepenetrationVelocity = 5
            custom float physxRigidBody:sleepThreshold = 0
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
}

def PhysicsScene "PhysicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

