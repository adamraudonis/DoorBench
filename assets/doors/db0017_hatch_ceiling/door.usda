def Xform "World"
{
    def Xform "db0017_hatch_ceiling" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = "[]"
        custom string doorbench:meta = '{"door_id": "db0017_hatch_ceiling", "family": "hatch_ceiling", "task": "traverse_open", "wall_y": 0.0, "operator_joint": "ring_hinge", "primary_joint": "hatch_hinge", "handle_height": 2.4, "horizontal": true, "scene_extent": 1.5, "cam_target_z": 3.005, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.0, -0.2625, 2.449], "handle_cam_pos": [0.35, -0.8125, 1.5989999999999998]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0017_hatch_ceiling/Looks/mat_floor/Shader.outputs:surface>

