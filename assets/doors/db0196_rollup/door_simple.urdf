  <joint name="curtain_slide" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="curtain"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.39" effort="5000" velocity="10"/>
    <dynamics damping="4.391788" friction="75.057369"/>
    <doorbench:spring stiffness="53.013631" springref="7.966667" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:note text="counterbalance spring ~90% of weight counterbalance ~90% of 48 kg"/>
  </joint>
  <joint name="garage_slide_lock_slide" type="prismatic">
    <origin xyz="-1.465 0.1954 1" rpy="0 0 0"/>
    <parent link="curtain"/>
    <child link="garage_slide_lock"/>
    <axis xyz="1 0 0"/>
    <doorbench:zero_offset value="0.05" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-0.05" upper="0" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="1"/>
  </joint>
