#usda 1.0
(
    defaultPrim = "db0196_rollup"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "db0196_rollup"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0196_rollup"
    custom string doorbench:env_release = "[]"
    custom string doorbench:filtered_pairs = '[["curtain", "garage_slide_lock"]]'
    custom string doorbench:meta = '{"door_id": "db0196_rollup", "family": "rollup", "task": "close", "wall_y": 0.0, "clearance_allow": [["coil_drum", "garage_slide_lock*", "curtain coils into the drum (translation approximation)"]], "primary_joint": "curtain_slide", "handle_height": 0.9, "counterbalance_fraction": 0.9, "operator_joint": null, "mass_reconciled_kg": 47.68846352573573, "scene_extent": 2.825, "cam_target_z": 1.245, "cam_target_x": 0.0, "handle_cam_x": 0.3, "handle_cam_target": [0.0, 0.1335, 0.16], "handle_cam_pos": [0.25, -0.9665000000000001, 0.51], "operator_joints": [], "operator_coupling": "coupled", "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"curtain_slide": "/db0196_rollup/Articulation/Joints/curtain_slide", "garage_slide_lock_slide": "/db0196_rollup/Articulation/Joints/garage_slide_lock_slide"}, "self_collisions": true, "filtered_pairs": [["curtain", "garage_slide_lock"]], "n_filtered_pairs": 1, "env_release": [], "couplings_emulated": [], "couplings_servo": [], "coupling_reflected_armature": {}, "servo_in_drive": {}, "rise_coupling": null, "max_angular_velocity_deg_s": 5729.5779513082325}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0196_rollup/Looks/mat_floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.53, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "mat_wall"
        {
            token outputs:surface.connect = </db0196_rollup/Looks/mat_wall/Shader.outputs:surface>

