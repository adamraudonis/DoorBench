rs\": [[\"leaf\", \"leaf_handle\"], [\"leaf\", \"leaf_latch_bolt\"]], \"n_filtered_pairs\": 2, \"env_release\": [], \"couplings_emulated\": [], \"couplings_servo\": [], \"coupling_reflected_armature\": {}, \"servo_in_drive\": {}, \"rise_coupling\": null, \"max_angular_velocity_deg_s\": 5729.5779513082325}"

