    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.05" effort="5000" velocity="10"/>
    <dynamics damping="9.526824" friction="0.25"/>
    <doorbench:spring stiffness="60" springref="-0.016667" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
