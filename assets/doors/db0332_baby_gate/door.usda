def Xform "db0332_baby_gate"
{
    custom string doorbench:couplings = "[]"
    custom string doorbench:door_id = "db0332_baby_gate"
    custom string doorbench:meta = '{"door_id": "db0332_baby_gate", "family": "baby_gate", "task": "traverse_open", "wall_y": -0.0275, "clearance_allow": [["leaf_pin_geom", "leaf_pin_housing", "pin slides inside its housing"]], "u": 1.0, "v": 1.0, "hinge_x": -0.572, "leaf_edge_x_local": 1.116, "handle_height": 0.55, "primary_joint": "leaf_hinge", "operator_joint": "leaf_pin_slide", "mass_reconciled_kg": 10.966283414212253, "scene_extent": 1.5, "cam_target_z": 0.385, "cam_target_x": 0.0, "handle_cam_x": 0.42800000000000005, "handle_cam_target": [0.5040000000000001, -0.045000000000000005, 0.615], "handle_cam_pos": [0.6840000000000002, -0.8450000000000001, 0.895], "usd_layout": "v2: default prim = door root; Env (static) + Articulation (fixed base link `base`)", "joints": {"leaf_hinge": "/db0332_baby_gate/Articulation/Joints/leaf_hinge", "leaf_pin_slide": "/db0332_baby_gate/Articulation/Joints/leaf_pin_slide"}}'

    def Scope "Looks"
    {
        def Material "mat_floor"
        {
            token outputs:surface.connect = </db0332_baby_gate/Looks/mat_floor/Shader.outputs:surface>

