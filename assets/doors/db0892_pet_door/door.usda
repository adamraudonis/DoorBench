                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "sill_magnet" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom bool doorbench:collision = 0
                custom string doorbench:label = "Sill magnet"
                custom string doorbench:semantic = "latch"
                rel material:binding = </db0892_pet_door/Looks/mat_magnet>
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.14, 0.004, 0.016)
                double3 xformOp:translate = (0, -0.005, 0.060000000000000005)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "approach_point"
            {
                custom string doorbench:site_role = "approach"
