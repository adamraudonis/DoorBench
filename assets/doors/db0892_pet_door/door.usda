                float3 xformOp:scale = (0.19, 0.25, 1.76)
                double3 xformOp:translate = (0, 0, 1.22)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_frame_l" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Pet door frame"
                custom string doorbench:semantic = "frame"
                rel material:binding = </db0892_pet_door/Looks/mat_frame>
                rel material:binding:physics = </db0892_pet_door/Looks/PhysMat_mat_frame_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.04, 0.262, 0.37)
                double3 xformOp:translate = (-0.115, 0, 0.195)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_frame_r" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Pet door frame"
                custom string doorbench:semantic = "frame"
                rel material:binding = </db0892_pet_door/Looks/mat_frame>
                rel material:binding:physics = </db0892_pet_door/Looks/PhysMat_mat_frame_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.04, 0.262, 0.37)
                double3 xformOp:translate = (0.115, 0, 0.195)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_frame_t" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
                custom string doorbench:label = "Pet door frame"
                custom string doorbench:semantic = "frame"
                rel material:binding = </db0892_pet_door/Looks/mat_frame>
                rel material:binding:physics = </db0892_pet_door/Looks/PhysMat_mat_frame_0_600> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.005
                custom float physxCollision:restOffset = 0
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.19, 0.262, 0.04)
                double3 xformOp:translate = (0, 0, 0.36)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "pet_sill" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom bool doorbench:collision = 1
