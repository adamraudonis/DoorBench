    <limit lower="0" upper="1.919862" effort="2000" velocity="10"/>
    <dynamics damping="12.504234" friction="4.240312"/>
    <doorbench:spring stiffness="16.997748" springref="-1.529614" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="90" damping_opening="12" backcheck_angle="1.22" backcheck_damping="60"/>
