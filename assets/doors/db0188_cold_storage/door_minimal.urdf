  <joint name="leaf_rise" type="prismatic">
    <origin xyz="0.545 0 0" rpy="0 0 0"/>
    <parent link="world_env"/>
    <child link="leaf_riser"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.0264" effort="5000" velocity="10"/>
    <dynamics damping="1" friction="0"/>
    <mimic joint="leaf_hinge" multiplier="0.007639" offset="0"/>
  </joint>
  <joint name="leaf_hinge" type="revolute">
    <origin xyz="-0.003 -0.057 0" rpy="0 0 0"/>
    <parent link="leaf_riser"/>
    <child link="leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.745329" effort="2000" velocity="10"/>
    <dynamics damping="12.504234" friction="4.240312"/>
    <doorbench:spring stiffness="16.997748" springref="-1.529614" note="tau = -stiffness*(q - springref); not native URDF"/>
    <doorbench:closer damping_closing="90" damping_opening="12" backcheck_angle="1.22" backcheck_damping="60"/>
    <doorbench:note text="rising hinge: gravity closing torque ~ m*g*0.0076 N*m/rad"/>
  </joint>
  <joint name="leaf_handle_hinge" type="revolute">
    <origin xyz="-1.005 0.057 1" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_handle"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.5" effort="2000" velocity="10"/>
    <dynamics damping="0.589936" friction="0.07"/>
    <doorbench:spring stiffness="2.5" springref="-0.96" note="tau = -stiffness*(q - springref); not native URDF"/>
  </joint>
  <joint name="leaf_hasp_hinge" type="revolute">
    <origin xyz="-1.015 0.001 1.2" rpy="0 0 0"/>
    <parent link="leaf"/>
    <child link="leaf_hasp"/>
    <axis xyz="0 0 1"/>
    <doorbench:zero_offset value="2.8" note="URDF q=0 is the spec initial state; DoorBench q = urdf_q + value"/>
    <limit lower="-2.8" upper="0.1" effort="2000" velocity="10"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>
