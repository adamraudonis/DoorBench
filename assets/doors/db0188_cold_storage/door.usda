def Xform "World"
{
    def Xform "db0188_cold_storage" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        custom string doorbench:couplings = '[{"type": "polynomial", "driven": "leaf_rise", "driver": "leaf_hinge", "coeff": [0.0, 0.007639437268410976, 0, 0, 0], "label": "rise = 12 mm per 90 deg (helical hinge)"}, {"type": "loop_closure_point", "body1": "closer_arm_fore", "body2": "world", "anchor": [0.26, 0, 0], "label": "Closer forearm pinned to frame bracket"}]'
        custom string doorbench:meta = '{"door_id": "db0188_cold_storage", "family": "cold_storage", "task": "open_and_traverse", "wall_y": 0.0, "u": -1.0, "v": -1.0, "hinge_x": 0.545, "leaf_edge_x_local": -1.073, "handle_height": 1.0, "primary_joint": "leaf_hinge", "operator_joint": "leaf_handle_hinge", "scene_extent": 2.1125, "cam_target_z": 1.075, "cam_target_x": 0.0, "handle_cam_x": -0.42500000000000004, "handle_cam_target": [-0.26299999999999996, -0.10500000000000001, 1.0], "handle_cam_pos": [-0.08299999999999996, -0.905, 1.28]}'
        custom bool physxArticulation:enabledSelfCollisions = 1
        custom int physxArticulation:solverPositionIterationCount = 32

        def Scope "Looks"
        {
            def Material "mat_floor"
            {
                token outputs:surface.connect = </World/db0188_cold_storage/Looks/mat_floor/Shader.outputs:surface>

